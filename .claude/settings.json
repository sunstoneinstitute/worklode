{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "gofmt -w \"$(jq -r .tool_input.file_path)\" 2>/dev/null || true",
            "if": "Edit(**/*.go)"
          },
          {
            "type": "command",
            "command": "gofmt -w \"$(jq -r .tool_input.file_path)\" 2>/dev/null || true",
            "if": "Write(**/*.go)"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "golang-migrate@sunstone-plugins": true,
    "sunstone-dev@sunstone-plugins": true,
    "sunstone-devops@sunstone-plugins": true
  },
  "extraKnownMarketplaces": {
    "sunstone-plugins": {
      "source": {
        "source": "github",
        "repo": "sunstoneinstitute/claude-plugins"
      }
    }
  }
}

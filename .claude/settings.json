{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "gofmt -w \"$(jq -r .tool_input.file_path)\" 2>/dev/null || true",
            "if": "Edit(**/*.go)"
          },
          {
            "type": "command",
            "command": "gofmt -w \"$(jq -r .tool_input.file_path)\" 2>/dev/null || true",
            "if": "Write(**/*.go)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "if": "Write(**/deploy/base/migrations/*.sql)",
            "command": "f=$(jq -r .tool_input.file_path); case \"$(basename \"$f\")\" in [0-9]*) [ -e \"$f\" ] || { echo 'New migrations are named NEW-<slug>.up.sql/.down.sql (NEW1-, NEW2- for several in one PR). The number-migrations workflow assigns the number. See .claude/rules/migrations.md.' >&2; exit 2; } ;; esac"
          }
        ]
      }
    ]
  }
}

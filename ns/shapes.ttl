# Worklode SHACL shapes — closed-world constraints over the `wl:` vocabulary.
#
# Extracted from the node-shape sketches in spec 006 §7, spec 025 §6 and spec
# 006 §7, plus the domain/range constraints spec 026 §6.2 asks for; those specs
# remain authoritative. Published by rdf-registry as rdf/shapes/wl-shapes.ttl
# behind the SHACL gate (ADR-0003).
#
# The load-bearing split (006 §7): OWL is open-world with no unique names, so it
# never flags a missing required field. owl:FunctionalProperty catches *more than
# one*; these shapes catch *zero*. Do not restate functionality here.
#
# What SHACL cannot express, and where it lives instead: three of 025 §6's six
# constraints on accepted documents — anchors are append-only, anchors are never
# renumbered, and wl:lastRevisedIn is set only on sections that changed — are
# diffs between the current and candidate version graphs, evaluated at
# publication (025 §4). The anchor-depth limit is likewise a publication check
# against a server setting. Only §7.2, the superseded-section explanation, is a
# single-graph constraint, and it is below.

@prefix wl:   <https://worklode.io/ns/ontology#> .
@prefix wlc:  <https://worklode.io/ns/concept/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Shape names sit in the `wl:` namespace (wl:TaskShape …) because the specs name
# shapes only informally — 006 §7 calls them "Artifact", "Deployment". If
# rdf-registry would rather not have shape IRIs in a published term namespace,
# a `wlsh:` namespace is the drop-in alternative; nothing here depends on it.
#
# Concept membership is checked as `skos:inScheme <scheme>` rather than an
# sh:in list of concepts, so growing a scheme never means editing this file.
# wl:taskState, wl:priority, wl:concern and wl:Environment are the exceptions:
# none has a scheme, and each mirrors a closed set elsewhere.


# ---------------------------------------------------------------------------
# Intent
# ---------------------------------------------------------------------------

wl:ComponentShape a sh:NodeShape ;
    sh:targetClass wl:Component ;
    sh:property [
        sh:path wl:reviewer ;
        sh:class foaf:Agent ;
        sh:minCount 1 ;
        sh:message "A Component needs at least one wl:reviewer to notify about PRs (006 §7)." ;
    ] .

wl:DesignDocShape a sh:NodeShape ;
    sh:targetClass wl:DesignDoc ;
    sh:property [
        sh:path wl:status ;
        sh:minCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue wlc:DesignDocStatus ] ] ;
        sh:message "A DesignDoc carries exactly one wl:status from wlc:DesignDocStatus." ;
    ] .

wl:PlanShape a sh:NodeShape ;
    sh:targetClass wl:Plan ;
    sh:property [
        sh:path wl:status ;
        sh:minCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue wlc:DesignDocStatus ] ] ;
        sh:message "A Plan carries exactly one wl:status, drawn from wlc:DesignDocStatus (025 §17; plans reuse the editorial lifecycle enum)." ;
    ] .

wl:SectionShape a sh:NodeShape ;
    sh:targetClass wl:Section ;
    sh:property [
        sh:path wl:status ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue wlc:DesignDocStatus ] ] ;
        sh:message "A Section's wl:status is drawn from wlc:DesignDocStatus (025 §7)." ;
    ] ;
    # The version snapshot a claim is tested against is itself a DesignDoc, and
    # it is ordered by dcat:version — never by comparing version IRIs (025 §4).
    sh:property [
        sh:path wl:lastRevisedIn ;
        sh:class wl:DesignDoc ;
        sh:node [ sh:property [ sh:path dcat:version ; sh:minCount 1 ] ] ;
        sh:message "wl:lastRevisedIn names a versioned DesignDoc snapshot carrying dcat:version (025 §4)." ;
    ] ;
    # 025 §6 — a superseded section explains itself: a successor, or a reason it
    # went away. A bare superseded section is a broken promise to whoever linked
    # it. Read as an implication: not superseded, OR one of the two explanations.
    sh:or (
        [ sh:not [ sh:property [ sh:path wl:status ; sh:hasValue wlc:superseded ] ] ]
        [ sh:property [ sh:path dct:isReplacedBy ; sh:minCount 1 ] ]
        [ sh:property [ sh:path dct:description ; sh:minCount 1 ] ]
    ) ;
    sh:message "A superseded Section needs dct:isReplacedBy or a dct:description saying why it went away (025 §6)." .

wl:DeliverableShape a sh:NodeShape ;
    # Targets wl:Effect too: sh:targetClass follows rdfs:subClassOf*.
    sh:targetClass wl:Deliverable ;
    sh:property [
        sh:path dct:description ;
        sh:minCount 1 ;
        sh:message "A Deliverable states its definition-of-done in dct:description (006 §9)." ;
    ] ;
    sh:property [
        sh:path dct:relation ;
        sh:minCount 1 ;
        sh:message "A Deliverable declares at least one target (Artifact + Environment, or a Deployment for an Effect)." ;
    ] ;
    sh:property [
        sh:path wl:deliveredBy ;
        sh:class wl:Component ;
        sh:minCount 1 ;
        sh:message "A Deliverable names the Component that delivers it, closing the Component→Section join (006 §Properties)." ;
    ] .

wl:EffectShape a sh:NodeShape ;
    # Adds to wl:DeliverableShape, which already targets Effect by subclass.
    sh:targetClass wl:Effect ;
    sh:property [
        sh:path dct:relation ;
        sh:qualifiedValueShape [ sh:class wl:Deployment ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "An Effect declares a Deployment target — its IRI is predictable, a Commit's is not (006 §9)." ;
    ] ;
    sh:property [
        sh:path dct:relation ;
        sh:qualifiedValueShape [ sh:class wl:Artifact ] ;
        sh:qualifiedMaxCount 0 ;
        sh:message "An Effect ships nothing: an Effect that names an Artifact is a plain Deliverable." ;
    ] .

wl:AcceptedDeviationShape a sh:NodeShape ;
    sh:targetClass wl:AcceptedDeviation ;
    # RDF reification names the tolerated edge WITHOUT asserting it (006 §12).
    sh:property [ sh:path rdf:subject   ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path rdf:predicate ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path rdf:object    ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [
        sh:path wl:sanctionedBy ;
        sh:class wl:DesignDoc ;
        sh:minCount 1 ;
        sh:message "A deviation names the decision that authorises it; removing that ADR removes the suppression." ;
    ] ;
    sh:property [
        sh:path dct:valid ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:message "Optional expiry; absent means indefinite, but never invisible (006 §12)." ;
    ] .


# ---------------------------------------------------------------------------
# Execution
# ---------------------------------------------------------------------------

wl:TaskShape a sh:NodeShape ;
    sh:targetClass wl:Task ;
    sh:property [
        sh:path wl:taskKind ;
        sh:minCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue wlc:TaskKind ] ] ;
        sh:message "A Task carries exactly one wl:taskKind from wlc:TaskKind." ;
    ] ;
    # The projected state literal. This list mirrors the tasks.state CHECK
    # constraint (migration 0005_delivery) and must be widened with it; the legal
    # transitions stay in internal/store/tasks.go and are not modelled (006 Open Q3).
    sh:property [
        sh:path wl:taskState ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "draft" "ready" "in_progress" "in_review" "merged"
                "deployed_dev" "deployed_prod" "released" "abandoned" ) ;
        sh:message "A Task mirrors exactly one backbone state literal from the tasks.state CHECK set." ;
    ] ;
    # Mirrors the tasks.priority CHECK constraint (migration 0001_baseline); widen both together.
    sh:property [
        sh:path wl:priority ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "critical" "high" "medium" "low" ) ;
        sh:message "A Task carries exactly one wl:priority from the tasks.priority CHECK set." ;
    ] ;
    # Mirrors the tasks.concern CHECK constraint (migration 0002_prioritization); widen both together.
    sh:property [
        sh:path wl:concern ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ( "completeness" "performance" "usability" "security" ) ;
        sh:message "A Task's wl:concern, when present, is drawn from the tasks.concern CHECK set." ;
    ] ;
    sh:property [
        sh:path wl:followUpTo ;
        sh:class wl:Task ;
        sh:maxCount 1 ;
        sh:message "A Task is a follow-up to at most one origin Task (004 §1.3)." ;
    ] ;
    sh:property [
        sh:path wl:inProject ;
        sh:class wl:Project ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Task belongs to exactly one Project — its quads live in that Project's named graph (006 §7, 025 §13)." ;
    ] ;
    # wl:mirrors is symmetric, so OWL can only give it a Task-or-Issue union for
    # both domain and range (see its rdfs:comment). The intended pairing is
    # closed-world, which is exactly SHACL's job.
    sh:property [
        sh:path wl:mirrors ;
        sh:class wl:Issue ;
        sh:message "A Task mirrors a tracker Issue, not another Task (006 §1)." ;
    ] .


# --- Domain and range for the predicates that state one (026 §6.2) ---
#
# rdfs:domain and rdfs:range are OWL entailments, not constraints: an Artifact
# carrying wl:covers is *inferred* to be a Plan, and only the disjointness
# axiom then makes the graph inconsistent — surfaced, if at all, as a
# contradiction somewhere rather than as the mistyped edge. These shapes say
# what the author meant. They are also the shapes wl:implements' old comment
# claimed existed; 026 §6.2 records that claim as false.
#
# Targeted with sh:targetSubjectsOf rather than the sh:targetClass the rest of
# this file uses, because the constraint belongs to the predicate and not to a
# class's instances: sh:targetClass wl:Plan cannot say that ONLY a Plan covers
# a Section, since it never sees the subject that was typed wrong. One shape
# per predicate carries both ends — the node-level sh:class is the domain, the
# sh:property the range — because every object of a predicate has a subject, so
# one target set reaches both. Named <term>Shape like the class shapes above,
# which leaves the property's own lower-case initial in place.

wl:coversShape a sh:NodeShape ;
    sh:targetSubjectsOf wl:covers ;
    sh:class wl:Plan ;
    sh:message "Only a Plan covers a Section: a plan writes no code, so what it declares is an undertaking (026 §5)." ;
    sh:property [
        sh:path wl:covers ;
        sh:class wl:Section ;
        sh:message "wl:covers names a Section — a plan claiming a whole document says nothing a coverage query can use (026 §5.1)." ;
    ] .

wl:CoverageShape a sh:NodeShape ;
    sh:targetClass wl:Coverage ;
    sh:property [
        sh:path wl:coveringPlan ;
        sh:class wl:Plan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path wl:coveredSection ;
        sh:class wl:Section ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path wl:coverageLevel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( wlc:full wlc:partial wlc:none ) ;
    ] ;
    sh:property [
        sh:path wl:completedWith ;
        sh:class wl:Plan ;
    ] ;
    # A partial claim may name the plans which complete it. Full and none are
    # self-contained claims, so neither can carry a completion set.
    sh:or (
        [ sh:property [ sh:path wl:coverageLevel ; sh:hasValue wlc:partial ] ]
        [ sh:property [ sh:path wl:coverageLevel ; sh:in ( wlc:full wlc:none ) ] ;
          sh:property [ sh:path wl:completedWith ; sh:maxCount 0 ] ]
    ) ;
    sh:sparql [
        sh:message "A qualified coverage record must reify a direct wl:covers edge for the same Plan and Section (026 §5)." ;
        sh:select """
            PREFIX wl: <https://worklode.io/ns/ontology#>
            SELECT $this WHERE {
                $this wl:coveringPlan ?plan ; wl:coveredSection ?section .
                FILTER NOT EXISTS { ?plan wl:covers ?section . }
            }
        """ ;
    ] .

wl:implementsShape a sh:NodeShape ;
    sh:targetSubjectsOf wl:implements ;
    sh:class wl:Component ;
    sh:message "Only a Component implements a Section: this edge is evidence that code landed, not intent to write it (026 §6.2)." ;
    sh:property [
        sh:path wl:implements ;
        sh:class wl:Section ;
        sh:message "wl:implements names a Section, not a whole document — 025 §11 re-pointed 006 §3's DesignDoc range." ;
    ] .

wl:producesShape a sh:NodeShape ;
    sh:targetSubjectsOf wl:produces ;
    # Shaped against the rdfs:domain ontology.ttl states, wl:Task — 026 §6.2
    # narrowed 006 §3's Task|Issue|PullRequest union. Widen this with the
    # domain if the union comes back.
    sh:class wl:Task ;
    sh:message "Only a Task produces a Deliverable (026 §6.2)." ;
    sh:property [
        sh:path wl:produces ;
        sh:class wl:Deliverable ;
        sh:message "wl:produces names a Deliverable, never a Component: a component already exists, and wl:affects is what says work touched one (026 §6.2)." ;
    ] .

wl:affectsShape a sh:NodeShape ;
    sh:targetSubjectsOf wl:affects ;
    # No node-level sh:class: wl:affects states no rdfs:domain, its subject
    # being any of Task, Issue or PullRequest (006 §3). Range only.
    sh:property [
        sh:path wl:affects ;
        sh:class wl:Component ;
        sh:message "wl:affects names the Component a Task, Issue or PullRequest touches (006 §3)." ;
    ] .


# ---------------------------------------------------------------------------
# Runtime (006 §7)
# ---------------------------------------------------------------------------

wl:ArtifactShape a sh:NodeShape ;
    sh:targetClass wl:Artifact ;
    sh:property [
        sh:path wl:artifactKind ;
        sh:minCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue wlc:ArtifactKind ] ] ;
        sh:message "An Artifact carries exactly one wl:artifactKind from wlc:ArtifactKind." ;
    ] ;
    sh:property [ sh:path owl:versionInfo ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path dct:identifier  ; sh:minCount 1 ; sh:maxCount 1 ] .

# Domain and range, on the pattern of the execution-layer block above. Spelled
# wl:covers until 026 §6.1 moved that name to the Plan→Section undertaking, the
# two domains being disjoint and so a contradiction rather than a clash of taste.
wl:cutFromShape a sh:NodeShape ;
    sh:targetSubjectsOf wl:cutFrom ;
    sh:class wl:Artifact ;
    sh:message "Only an Artifact is cut from a Commit: the per-environment frontier has no node (006 §11.1)." ;
    sh:property [
        sh:path wl:cutFrom ;
        sh:class wl:Commit ;
        sh:message "wl:cutFrom names the Commit a release was cut from; the delivery frontier follows from it (026 §6.1)." ;
    ] .

wl:DeploymentShape a sh:NodeShape ;
    sh:targetClass wl:Deployment ;
    sh:property [
        sh:path wl:toEnvironment ;
        sh:class wl:Environment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path wl:targetKind ;
        sh:minCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue wlc:DeployTargetKind ] ] ;
    ] ;
    sh:property [
        sh:path wl:deploymentStatus ;
        sh:minCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue wlc:DeploymentStatus ] ] ;
    ] ;
    # One node per (environment, target kind, target name) mirrors current state,
    # so a Deployment uses at most one thing: an Artifact, or a Commit for
    # IaC/GitOps targets. Rollout history is v2.
    sh:property [
        sh:path prov:used ;
        sh:maxCount 1 ;
        sh:message "A Deployment uses at most one Artifact or Commit; per-rollout history is v2 (006 §3.1)." ;
    ] .

wl:EnvironmentShape a sh:NodeShape ;
    sh:targetClass wl:Environment ;
    # Closed to what the delivery handlers normalise to. 006 §15 item 9 asks
    # whether this closure survives per-cluster preview environments.
    sh:in ( <https://worklode.io/ns/id/environment/dev>
            <https://worklode.io/ns/id/environment/prod> ) ;
    sh:message "The Environment instance set is closed to dev and prod (006 §7)." .

wl:CommitShape a sh:NodeShape ;
    sh:targetClass wl:Commit ;
    sh:property [
        sh:path dct:identifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Commit carries exactly one dct:identifier, the sha (006 §7)." ;
    ] .

# No shape for wl:Build, wl:RuntimeEvent or wl:Skill: 006 specifies none for the
# first two (neither has a v1 projection, and RuntimeEvent has no natural key —
# 006 §15 item 7), and 016 specifies none for Skill.

# Worklode ontology — the `wl:` vocabulary (classes, properties, axioms).
#
# Extracted from the specs, which remain authoritative: spec 006 defines the
# vocabulary and the runtime layer, spec 016 asks 006 to mint two
# skill-registry terms, spec 025 amends the vocabulary (prefix rename,
# wl:Section, versioning, status enum) and restores Plan as a sibling document
# class, and spec 026 adds qualified plan-section coverage. Where a spec
# section is cited below, that section is the reason the term exists.
#
# This file is a reference, not a deployment: the graph is not implemented, and
# publication under https://worklode.io/ns/ belongs to rdf-registry (006 §14).
# It is also the parseable form — the Turtle blocks in the specs are
# illustrative and do not parse, because they concatenate adjacent string
# literals and leave slashes unescaped in prefixed names (wlid:doc/spec-006).
# SKOS concept schemes live in the sibling concept.ttl; SHACL shapes
# (wl-shapes.ttl) are specified but not written.

@prefix wl:   <https://worklode.io/ns/ontology#> .
@prefix wlc:  <https://worklode.io/ns/concept/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://worklode.io/ns/ontology>
    a owl:Ontology ;
    dct:title "Worklode ontology" ;
    rdfs:comment """Intent, execution and runtime vocabulary for Worklode. Standards-first: a
        term is minted only where no community vocabulary carries the intended meaning.""" ;
    dct:source <https://worklode.io/ns/id/doc/spec-worklode-006> ,
               <https://worklode.io/ns/id/doc/spec-worklode-016> ,
               <https://worklode.io/ns/id/doc/spec-worklode-025> ,
               <https://worklode.io/ns/id/doc/spec-worklode-026> ;
    owl:versionInfo "unpublished draft, extracted from docs/specs" .


# ---------------------------------------------------------------------------
# Layer 1 — intent (declared, authored graph-side, crit-reviewed)
# ---------------------------------------------------------------------------

wl:Component a owl:Class ;
    wl:layer wlc:intent ;
    rdfs:comment """A software component — the atomic unit of the platform graph. Repo/project
        (doap:Project) is a coarser grouping via dct:hasPart.""" .

wl:DesignDoc a owl:Class ;
    rdfs:subClassOf foaf:Document , prov:Entity ;
    wl:layer wlc:intent ;
    rdfs:comment """A statement of intent that stays true after implementation: what drift is
        measured against. Superseded, never consumed (025 §2). prov:Entity because 025 asserts
        prov:wasGeneratedBy (§12, the task that wrote it), prov:wasRevisionOf and
        prov:wasAttributedTo (§4) on documents, and all three have prov:Entity as their domain.""" .

wl:Plan a owl:Class ;
    rdfs:subClassOf foaf:Document , prov:Entity ;
    wl:layer wlc:execution ;
    rdfs:comment """An executable document: a bundle of task definitions with instructions
        attached. Reviewable and accept-gated like a DesignDoc, but spent once executed, freely
        mutable, and carrying no frozen section anchors — nothing may pin a claim to a plan.
        A sibling of DesignDoc, never a subclass: 025 §2 dropped wl:Plan because the section
        lock would be harmful here, and 025 §9 restored it on that same reasoning. Acceptance
        mints its tasks (025 §9.2).""" .

wl:ADR a owl:Class ;
    rdfs:subClassOf wl:DesignDoc ;
    wl:layer wlc:intent .

wl:Spec a owl:Class ;
    rdfs:subClassOf wl:DesignDoc ;
    wl:layer wlc:intent .

wl:Section a owl:Class ;
    rdfs:subClassOf foaf:Document ;
    wl:layer wlc:intent ;
    rdfs:comment """An addressable, individually linkable part of a DesignDoc. Stable for the life
        of the document; never deleted once the document is accepted. IRI is
        wlid:section/<doc-slug>/<anchor>, the anchor assigned at first publication and recorded in
        the document source (025 §3).""" .

wl:Plan a owl:Class ;
    rdfs:subClassOf foaf:Document , prov:Entity ;
    wl:layer wlc:execution ;
    rdfs:comment """An executable document: accepting it mints its tasks (025 §4-§5). A sibling of
        wl:DesignDoc, not a subclass — a plan is spent by execution rather than superseded, and
        takes no wl:Section parts and no anchors. 025 §2 dropped the class when plan-shaped work
        was a task subtree; 025 §9 (accepted) reintroduced plans as documents, mirrored here by
        spec 025 §17.""" .

wl:Deliverable a owl:Class ;
    wl:layer wlc:intent ;
    rdfs:comment """A declared definition-of-done: the vertical join point where a Spec's ambition
        meets a running system. Declares its targets as dct:relation to an Artifact and an
        Environment, and its delivering Component via wl:deliveredBy (006 §9).""" .

wl:Effect a owl:Class ;
    rdfs:subClassOf wl:Deliverable ;
    wl:layer wlc:intent ;
    rdfs:comment """A deliverable whose definition-of-done is a state of an existing system, not the
        existence and placement of an artifact — 'admin-cluster has Keycloak SSO configured'.
        Declares its target as a Deployment IRI (stable: environment + target kind + target name)
        and MUST NOT declare an Artifact. Witnessed by that Deployment reaching wlc:deployed over a
        Commit on the delivering component's default branch — the commit is discovered, never
        declared: its IRI carries a SHA (006 §10.1) and so cannot be named in advance. A subclass
        rather than an attribute because the edges differ, not just the coordinates.""" .

wl:AcceptedDeviation a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    wl:layer wlc:intent ;
    rdfs:comment """A tolerated architectural deviation that drift queries suppress. Names the
        accepted edge via RDF reification (rdf:subject/rdf:predicate/rdf:object) WITHOUT asserting
        it — the edge stays out of the intent layer. Carries wl:sanctionedBy and an optional
        dct:valid expiry; past the expiry the violation re-surfaces (006 §12).""" .


# ---------------------------------------------------------------------------
# Layer 2 — execution · VCS (observed; Task and Project projected from the
# backbone, which stays authoritative for state, leases, blocks and child_of)
# ---------------------------------------------------------------------------

wl:Task a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    wl:layer wlc:execution ;
    rdfs:comment """A unit of work, projected read-only from the backbone. prov:Activity so a
        document can name the task that wrote it via prov:wasGeneratedBy, which is distinct from
        the components that wl:implements its sections (025 §12). Task execution-state is NOT wl:status:
        the state machine is backbone-owned (spec 004) and the graph mirrors it as a projected
        literal rather than forking the enum. Being an Activity, a Task names its author with
        prov:wasAssociatedWith (Activity→Agent) and never prov:wasAttributedTo, whose domain is
        prov:Entity: PROV declares Activity and Entity disjoint, so the latter would make every
        authored Task inconsistent.""" .

wl:Project a owl:Class ;
    wl:layer wlc:execution ;
    rdfs:comment """The umbrella for all work in a set of repositories — the backbone's projects
        table, verbatim. Unbounded. NB: doap:Project is a single repository; a wl:Project owns
        1..n of them (project_repos). Projection named graphs are anchored per Project.""" .

wl:Issue a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    wl:layer wlc:execution ;
    rdfs:comment """A tracker issue in a hosting provider, projected from VCS ingest and mirrored to
        a Task by wl:mirrors. Minted: 006 §8.2 pencilled in "reuse doap:", but DOAP has only
        doap:bug-database — a property pointing at a tracker's URL, not a class for one issue —
        and no surveyed vocabulary carries the concept (OSLC CM is the nearest, and 006 §1.1 already
        rejected OSLC as not a standard mainstream tooling recognises). prov:Entity because 006
        §3.2 asserts prov:wasAttributedTo for the author.""" .

wl:PullRequest a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    wl:layer wlc:execution ;
    rdfs:comment """A proposed change against a repository, projected from VCS ingest. Joins its
        Task the GitHub-native way, by closing the Issue the Task wl:mirrors. Minted and
        prov:Entity for the same reasons as wl:Issue.""" .

wl:Skill a owl:Class ;
    wl:layer wlc:execution ;
    rdfs:comment """One org-wide agent skill: identity only — name, description and source-repo
        IRI — so a design document can pin it with wl:recommendsSkill. Content, versions and
        embeddings stay in the backbone; the graph gets identity, not blobs. Execution layer
        because the node mirrors git through the backbone, like Issue and PullRequest — the pin
        that names it is the declared half (016 §1). IRI is wlid:skill/<name>.""" .


# ---------------------------------------------------------------------------
# Layer 3 — runtime · deploy (observed; projected from ingest). Every class is
# anchored on a PROV-O parent where a truthful anchor exists, so PROV-aware
# tooling traverses the layer with no Worklode-specific knowledge (006 §1.1).
# ---------------------------------------------------------------------------

wl:Artifact a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    wl:layer wlc:runtime ;
    rdfs:seeAlso <https://spdx.org/rdf/3.0.1/terms/Software/Package> ;
    rdfs:comment """One built, versioned unit deployed elsewhere: a container image, a PyPI package,
        a git tag or a binary release. Kind is an attribute (wl:artifactKind), not a subclass — the
        kinds differ in coordinates, not in the edges they carry.""" .

wl:Build a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    wl:layer wlc:runtime ;
    rdfs:seeAlso <https://spdx.org/rdf/3.0.1/terms/Build/Build> ;
    rdfs:comment """The activity that produced an Artifact — a CI workflow run. No v1 projection
        source exists (006 §11.1); declared now so wl:Artifact can carry prov:wasGeneratedBy without a
        later breaking change.""" .

wl:Deployment a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    wl:layer wlc:runtime ;
    rdfs:comment """The rollout of an Artifact OR a Commit to one target in one Environment — a Flux
        Kustomization, a PyPI publish, or a manually tracked target. prov:used binds an Artifact for
        built units and a Commit for IaC/GitOps repos, which ship nothing and reconcile a git
        revision instead (the wl:Effect case). Mirrors current state, one node per (environment,
        target kind, target name); rollout history is v2.""" .

wl:Environment a owl:Class ;
    wl:layer wlc:runtime ;
    rdfs:comment """A deployment stage. Deliberately parentless: no surveyed vocabulary models a
        deployment stage, and prov:Location is spatial in intent. The instance set is closed to dev
        and prod by SHACL, matching the normalisation the delivery handlers already enforce.""" .

wl:Commit a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    wl:layer wlc:runtime ;
    rdfs:comment """One commit on a repository's default branch. Promoted from v2 (006) because
        delivery resolution is defined in terms of commit coverage (006 §2.1).""" .

wl:RuntimeEvent a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    wl:layer wlc:runtime ;
    rdfs:comment """An observed runtime incident affecting a deployed Artifact — a crashloop, an OOM
        kill, a Flux reconciliation failure or recovery. Declared but unprojectable until it has a
        natural key (006 §15 item 7).""" .


# ---------------------------------------------------------------------------
# Disjointness — proved by owlrl in CI, never published as closure (ADR-0004).
# ---------------------------------------------------------------------------

[] a owl:AllDisjointClasses ;
   owl:members ( wl:Component wl:DesignDoc wl:Plan wl:Section wl:Task wl:Deliverable wl:Project
                 wl:Skill ) .

[] a owl:AllDisjointClasses ;
   owl:members ( wl:ADR wl:Spec ) .

[] a owl:AllDisjointClasses ;
   owl:members ( wl:Artifact wl:Build wl:Deployment wl:Environment wl:Commit wl:RuntimeEvent ) .


# ---------------------------------------------------------------------------
# Properties — intent
# ---------------------------------------------------------------------------

wl:governs a owl:ObjectProperty ;
    wl:layer wlc:intent ;
    rdfs:domain wl:DesignDoc ;
    rdfs:range wl:Component ;
    rdfs:comment "This design doc governs the architecture of that component." .

wl:deliveredBy a owl:ObjectProperty ;
    wl:layer wlc:intent ;
    rdfs:domain wl:Deliverable ;
    rdfs:range wl:Component ;
    rdfs:comment """The component that delivers this deliverable. Deliberately NOT functional: a
        deliverable may be delivered by several components, each advancing at its own pace. Closes
        the Component→Section → Deliverable → Environment join that makes 'component A implemented
        section B by deploying deliverable C to environment D' answerable per environment. Declared
        rather than derived because the derivable route (Artifact→Build→Commit→paths→Component)
        needs wl:Build, which has no v1 projection source (006 §11.1). SHACL enforces >=1.""" .

wl:status a owl:ObjectProperty, owl:FunctionalProperty ;
    wl:layer wlc:intent ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( wl:DesignDoc wl:Plan wl:Section ) ] ;
    rdfs:range skos:Concept ;
    rdfs:comment """Editorial lifecycle status in wlc:DesignDocStatus, applying to a DesignDoc, a
        Plan, or a single Section (025 §7; 025 §9). Functional catches >1; SHACL enforces >=1.
        Implementation is not a status — it is a coverage query over wl:implements (025 §11).""" .

wl:lastRevisedIn a owl:ObjectProperty, owl:FunctionalProperty ;
    wl:layer wlc:intent ;
    rdfs:domain wl:Section ;
    rdfs:range wl:DesignDoc ;
    rdfs:comment """The document version in which this section's content last changed. Lets a claim
        pinned at version N be tested for staleness without per-section version IRIs. Range is
        wl:DesignDoc because a versioned snapshot (wlid:doc/<slug>/v3) is an instance of the same
        class as its canonical document — DCAT's own pattern, where dcat:hasVersion relates a
        resource to a resource — so no version class is minted. Ordering comes from dcat:version on
        the snapshot, never from comparing IRIs: a claim pinned at v3 is stale iff
        ?sec wl:lastRevisedIn/dcat:version ?n with ?n > 3.""" .

wl:sanctionedBy a owl:ObjectProperty ;
    wl:layer wlc:intent ;
    rdfs:domain wl:AcceptedDeviation ;
    rdfs:range wl:DesignDoc ;
    rdfs:comment "The DesignDoc/ADR that authorises this accepted deviation." .

wl:recommendsSkill a owl:ObjectProperty ;
    wl:layer wlc:intent ;
    rdfs:domain wl:DesignDoc ;
    rdfs:range wl:Skill ;
    rdfs:comment """A design document pins this skill, declared from its `skills:` frontmatter when
        the document is ingested (016 §3). Task pins are the backbone tasks.skills field,
        projected as wl:requiresSkill (025 §9.1), not this edge; brief resolution unions the
        two.""" .

wl:reviewer a owl:ObjectProperty ;
    wl:layer wlc:intent ;
    rdfs:domain wl:Component ;
    rdfs:range foaf:Agent ;
    rdfs:comment "Agent (GitHub user/team IRI) to notify about PRs affecting this component." .


# ---------------------------------------------------------------------------
# Properties — execution
# ---------------------------------------------------------------------------

wl:implements a owl:ObjectProperty ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Component ;
    rdfs:range wl:Section ;
    rdfs:comment """This component's code, at the pinned version, implements this section — the
        claim in .worklode/implements.yaml, derived by observed/repo-implements (025 §11). Evidence,
        where the neighbouring terms are intent and work: a Plan wl:covers a Section to undertake
        it, a Task wl:produces a Deliverable to do the work, and this edge says the code landed.
        Keeps the name because this is the paradigmatic sense of the word; what moved out is the
        Task half (026 §6.2), which is why the domain can finally be stated. 006 §3's DesignDoc
        range was re-pointed to Section by 025 §11. Coverage stays a count query over sections, so
        no wl:fullyImplements is minted.""" .

wl:produces a owl:ObjectProperty ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Task ;
    rdfs:range wl:Deliverable ;
    rdfs:comment """The work that makes a Deliverable exist. Shared wl:implements until 026 §6.2
        separated them: a task does not implement a section — it produces the deliverable, and the
        component is what implements. Authored on the task (006's projection table: task edit).
        006 §3 also ranged this edge over Component and admitted Issue and PullRequest as
        subjects; 026 §6.2 drops all three. wl:affects already carries the component half, and an
        issue or a pull request reaches a deliverable only through the task it is bound to —
        wl:mirrors for the issue, the PR's own task binding for the PR.""" .

wl:covers a owl:ObjectProperty ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Plan ;
    rdfs:range wl:Section ;
    rdfs:comment """A Plan's undertaking to see a Section built, discharged by the tasks its
        acceptance mints (025 §9.2). Deliberately not wl:implements: a plan writes no code, so it
        claims nothing — one word for the promise and for the evidence that redeems it leaves the
        two indistinguishable (026 §5). The frontmatter key is `covers`; `implements` on a plan is
        its retired spelling.""" .

wl:Coverage a owl:Class ;
    wl:layer wlc:execution ;
    rdfs:comment """A qualified wl:covers: how completely one Plan covers one Section. Reified
        beside the direct edge, never in place of it, so 025 §11's coverage queries are untouched
        and no wl:fullyImplements is minted (026 §5). The node names both ends itself
        (wl:coveringPlan, wl:coveredSection) rather than hanging off a Plan→Coverage predicate:
        PROV needs prov:qualifiedAssociation because an Association has no other route back to
        its Activity, whereas here the pair is the node's whole identity, and a predicate whose
        object is a reification node cannot be read aloud as a sentence (026 §6).""" .

wl:coveringPlan a owl:ObjectProperty, owl:FunctionalProperty ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Coverage ;
    rdfs:range wl:Plan .

wl:coveredSection a owl:ObjectProperty, owl:FunctionalProperty ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Coverage ;
    rdfs:range wl:Section .

wl:coverageLevel a owl:ObjectProperty, owl:FunctionalProperty ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Coverage ;
    rdfs:range skos:Concept .

wl:completedWith a owl:ObjectProperty ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Coverage ;
    rdfs:range wl:Plan ;
    rdfs:comment """The plans that, with this one, discharge the section. Checked, never trusted:
        a named plan that does not itself cover the section leaves it partially planned
        (026 §2.1).""" .

wl:affects a owl:ObjectProperty ;
    wl:layer wlc:execution ;
    rdfs:range wl:Component ;
    rdfs:comment "A Task/Issue/PullRequest touches/changes that component." .

wl:taskState a owl:DatatypeProperty, owl:FunctionalProperty ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Task ;
    rdfs:range xsd:string ;
    rdfs:comment """The task's execution state, projected as a literal mirror of the backbone enum:
        one of draft, ready, in_progress, in_review, merged, deployed_dev, deployed_prod, released,
        abandoned. Deliberately NOT wl:status and deliberately not a SKOS scheme — the state machine
        is backbone-owned (spec 004), and modelling it here would fork it (006 Open Q3). The legal
        values are the tasks.state CHECK constraint (migration 0005_delivery); the legal
        transitions between them live in internal/store/tasks.go and are not modelled at all.
        shapes.ttl enumerates the values, so widening the CHECK means widening that shape.""" .

wl:taskKind a owl:ObjectProperty, owl:FunctionalProperty ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Task ;
    rdfs:range skos:Concept ;
    rdfs:comment "Kind of task; see wlc:TaskKind. A fixed enum, never free text." .

wl:dependsOn a owl:ObjectProperty, owl:TransitiveProperty ;
    wl:layer wlc:execution ;
    rdfs:subPropertyOf dct:requires ;
    rdfs:domain wl:Task ;
    rdfs:range wl:Task ;
    rdfs:comment """This task needs that task done first (backbone blocks/dependency mirror).
        Transitive, so reachability is a SPARQL property path (?t wl:dependsOn+ ?x) with no
        reasoner, and CI/owlrl proves the closure. Type-homogeneous by ADR-0004.""" .

wl:blocks a owl:ObjectProperty, owl:TransitiveProperty ;
    wl:layer wlc:execution ;
    owl:inverseOf wl:dependsOn ;
    rdfs:domain wl:Task ;
    rdfs:range wl:Task ;
    rdfs:comment "This task blocks that task (backbone-authoritative, spec 004). Transitive." .

wl:inProject a owl:ObjectProperty, owl:FunctionalProperty ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Task ;
    rdfs:range wl:Project ;
    rdfs:comment """Derived from tasks.project_id: every Task is in exactly one Project. Stays
        split from dct:isPartOf so the Task→Task decomposition remains type-homogeneous and
        cleanly transitive. Projection named graphs are anchored per Project.""" .

wl:requiresSkill a owl:ObjectProperty ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Task ;
    rdfs:range wl:Skill ;
    rdfs:comment """The executing agent loads this skill before starting: the task pin of 016 §3,
        projected from the backbone tasks.skills field and minted onto the task by plan
        acceptance (025 §9.1). Distinct from wl:recommendsSkill because the owners differ — the
        pin on a task is execution-layer fact, the pin in a design document declared intent;
        brief resolution unions the two.""" .

wl:mirrors a owl:ObjectProperty, owl:SymmetricProperty ;
    wl:layer wlc:execution ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( wl:Task wl:Issue ) ] ;
    rdfs:range  [ a owl:Class ; owl:unionOf ( wl:Task wl:Issue ) ] ;
    rdfs:comment """Bidirectional mirror between a backbone Task and a tracker Issue. The PR→Task
        join piggybacks GitHub's native Closes #N (the PR closes the mirrored Issue). Domain and
        range are the SAME union, not Task→Issue: a symmetric property whose domain and range
        differ entails that every Issue is a Task, which contradicts their disjointness. OWL
        therefore states the pair; shapes.ttl pins the intended direction (a Task mirrors an
        Issue).""" .


# ---------------------------------------------------------------------------
# Properties — runtime (006 §3.1)
# ---------------------------------------------------------------------------

wl:artifactKind a owl:ObjectProperty, owl:FunctionalProperty ;
    wl:layer wlc:runtime ;
    rdfs:domain wl:Artifact ;
    rdfs:range skos:Concept ;
    rdfs:comment "Kind of artifact; see wlc:ArtifactKind. Functional catches >1, SHACL catches 0." .

wl:digest a owl:DatatypeProperty ;
    wl:layer wlc:runtime ;
    rdfs:domain wl:Artifact ;
    rdfs:range xsd:string ;
    rdfs:comment """Content digest as an opaque prefixed string, e.g. "sha256:abc…". Minted rather
        than reusing spdx:checksum: that is a class requiring an algorithm/value node, and the
        ingested value is a single opaque string. A spdx:Checksum alignment is additive if SBOM
        interop is ever wanted.""" .

wl:cutFrom a owl:ObjectProperty ;
    wl:layer wlc:runtime ;
    rdfs:domain wl:Artifact ;
    rdfs:range wl:Commit ;
    rdfs:comment """The commit a published release was cut from: its target_commitish where that
        resolves, else the default branch head at publish time (004 §2.5). The delivery frontier
        follows from it rather than being a second edge — the object is a commit on the default
        branch, so the release carries every commit up to and including it, and the resolver
        compares against that ancestry. Domain is Artifact, not Deployment: the per-environment
        frontier has no node (006 §11.1). Spelled wl:covers until 026 §6.1 needed that name for the
        Plan→Section undertaking, and renamed for the fact rather than its consequence.""" .

wl:toEnvironment a owl:ObjectProperty, owl:FunctionalProperty ;
    wl:layer wlc:runtime ;
    rdfs:domain wl:Deployment ;
    rdfs:range wl:Environment ;
    rdfs:comment "The environment this deployment targets." .

wl:deploymentStatus a owl:ObjectProperty, owl:FunctionalProperty ;
    wl:layer wlc:runtime ;
    rdfs:domain wl:Deployment ;
    rdfs:range skos:Concept ;
    rdfs:comment "Current rollout status; see wlc:DeploymentStatus." .

wl:targetKind a owl:ObjectProperty, owl:FunctionalProperty ;
    wl:layer wlc:runtime ;
    rdfs:domain wl:Deployment ;
    rdfs:range skos:Concept ;
    rdfs:comment "Kind of deployment target; see wlc:DeployTargetKind." .

wl:runtimeEventKind a owl:ObjectProperty, owl:FunctionalProperty ;
    wl:layer wlc:runtime ;
    rdfs:domain wl:RuntimeEvent ;
    rdfs:range skos:Concept ;
    rdfs:comment "Kind of runtime incident; see wlc:RuntimeEventKind." .


# ---------------------------------------------------------------------------
# Annotation property
# ---------------------------------------------------------------------------

wl:layer a owl:AnnotationProperty ;
    rdfs:range skos:Concept ;
    rdfs:comment """Model-layer membership (wlc:ModelLayer: intent/execution/runtime) of a
        vocabulary term, so all intent classes etc. can be listed. Annotation only, and untagged
        itself: a self-applied wl:layer would name no layer truthfully.""" .


# ---------------------------------------------------------------------------
# Reused, not minted. Listed so the boundary is visible.
#
#   dct:requires / dct:isRequiredBy    dependency
#   dct:hasPart / dct:isPartOf         decomposition; child_of mirror
#   dct:replaces / dct:isReplacedBy    supersession, whole document or section
#   dct:title / description            labels; Deliverable acceptance criteria
#   dct:relation                       Deliverable → declared Artifact/Environment target
#   dct:created / modified / issued / date / valid / identifier
#   foaf:Document                      super-type of DesignDoc and Section
#   foaf:Agent / prov:Agent            owner, author, reviewer
#   prov:wasAttributedTo               author of an Entity (Issue, PullRequest,
#                                      DesignDoc, AcceptedDeviation)
#   prov:wasAssociatedWith             author of an Activity (Task) — see wl:Task
#   prov:wasGeneratedBy / wasDerivedFrom / wasRevisionOf
#   prov:used                          Deployment → Artifact or Commit
#   prov:startedAtTime / endedAtTime / generatedAtTime
#   doap:Project                       repository grouping (with dct:hasPart)
#   owl:versionInfo                    artifact version string
#   skos:Concept / ConceptScheme / inScheme / OrderedCollection / memberList
#   rdf:subject / predicate / object   names an AcceptedDeviation's edge un-asserted
#   dcat:hasCurrentVersion / hasVersion / version / previousVersion   (025 §4)
#
# Deliberately absent — do not reintroduce:
#
#   wl:supersededSection       retired (025 §3): sections are addressable, so
#                              partial supersession is dct:isReplacedBy between
#                              them. Nothing else needed RDF 1.2, so there is no
#                              ontology.1-2.ttl companion (cf. 006 §0).
#   wl:fullyImplements,        never minted (025 §3): declared coverage is a
#   wl:partiallyImplements     second source of truth that goes stale.
#   wl:Release                 never minted (006 §2.1): a release is a wl:Artifact
#                              of kind wlc:git_tag plus a wl:cutFrom edge.
#   wl:Milestone               v2 (006 §1).
#   wlc:TaskState              no SKOS scheme for task state: wl:taskState is a
#                              literal mirror, so the backbone keeps the enum
#                              and the transitions (006 Open Q3).
# ---------------------------------------------------------------------------

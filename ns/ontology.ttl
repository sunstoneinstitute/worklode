# Worklode ontology — the `wl:` vocabulary (classes, properties, axioms).
#
# Extracted from the specs, which remain authoritative: WL-SPEC-79 defines the
# vocabulary and the runtime layer, WL-SPEC-81 asks WL-SPEC-79 to mint two
# skill-registry terms, WL-SPEC-77 amends the vocabulary (prefix rename,
# wl:Section, versioning, status enum) and restores Plan as a sibling document
# class, and WL-SPEC-78 adds plan coverage. Where a spec
# section is cited below, that section is the reason the term exists.
#
# This file is a reference, not a deployment: the graph is not implemented, and
# publication under https://worklode.io/ns/ belongs to rdf-registry (WL-SPEC-79).
# It is also the parseable form — the Turtle blocks in the specs are
# illustrative and do not parse, because they concatenate adjacent string
# literals and leave slashes unescaped in prefixed names (wlid:doc/spec-006).
# SKOS concept schemes live in the sibling concept.ttl; SHACL shapes
# (wl-shapes.ttl) are specified but not written.
#
# skos:definition is the readable form of a term, kept short so a stored edge
# can be read as a sentence: on a class it is a lowercase noun phrase
# ("task"), on an edge property a third-person verb phrase that joins subject
# to object ("depends on"), so <class> <ref> + <definition> + <class> <ref>
# reads "task WL-7 depends on task WL-9". rdfs:comment keeps the rationale.

@prefix wl:   <https://worklode.io/ns/ontology#> .
@prefix wlc:  <https://worklode.io/ns/concept/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://worklode.io/ns/ontology>
    a owl:Ontology ;
    dct:title "Worklode ontology" ;
    rdfs:comment """Intent, execution and runtime vocabulary for Worklode. Standards-first: a
        term is minted only where no community vocabulary carries the intended meaning.""" ;
    dct:source <https://worklode.io/ns/id/doc/spec-worklode-006> ,
               <https://worklode.io/ns/id/doc/spec-worklode-016> ,
               <https://worklode.io/ns/id/doc/spec-worklode-025> ,
               <https://worklode.io/ns/id/doc/spec-worklode-026> ;
    owl:versionInfo "unpublished draft, extracted from docs/specs" .


# ---------------------------------------------------------------------------
# Layer 1 — intent (declared, authored graph-side, crit-reviewed)
# ---------------------------------------------------------------------------

wl:Component a owl:Class ;
    skos:definition "component" ;
    wl:layer wlc:intent ;
    rdfs:comment """A software component — the atomic unit of the platform graph. Repo/project
        (doap:Project) is a coarser grouping via dct:hasPart.""" .

wl:DesignDoc a owl:Class ;
    skos:definition "design document" ;
    rdfs:subClassOf foaf:Document , prov:Entity ;
    wl:layer wlc:intent ;
    rdfs:comment """A statement of intent that stays true after implementation: what drift is
        measured against. Superseded, never consumed (WL-SPEC-77). prov:Entity because WL-SPEC-77 asserts
        prov:wasGeneratedBy (the task that wrote it), prov:wasRevisionOf and
        prov:wasAttributedTo on documents, and all three have prov:Entity as their domain.""" .

wl:Spec a owl:Class ;
    skos:definition "spec" ;
    rdfs:subClassOf wl:DesignDoc ;
    wl:layer wlc:intent .

wl:Section a owl:Class ;
    skos:definition "section" ;
    rdfs:subClassOf foaf:Document ;
    wl:layer wlc:intent ;
    rdfs:comment """An addressable, individually linkable part of a DesignDoc. Stable for the life
        of the document; never deleted once the document is accepted. IRI is
        wlid:section/<doc-slug>/<anchor>, the anchor assigned at first publication and recorded in
        the document source (WL-SPEC-77).""" .

wl:Plan a owl:Class ;
    skos:definition "plan" ;
    rdfs:subClassOf foaf:Document , prov:Entity ;
    wl:layer wlc:execution ;
    rdfs:comment """An executable document: a bundle of task definitions with instructions
        attached, minted as tasks when it is accepted (WL-SPEC-77). Reviewable and accept-gated
        like a DesignDoc, but spent by execution rather than superseded, freely mutable, and
        taking no wl:Section parts and no frozen anchors — the section lock that protects a
        spec would be harmful here, so nothing may pin a claim to a plan (WL-SPEC-77). A sibling
        of wl:DesignDoc, never a subclass: WL-SPEC-77 reintroduced plans as documents on that
        same reasoning, mirrored here by WL-SPEC-77""" .

wl:Deliverable a owl:Class ;
    skos:definition "deliverable" ;
    wl:layer wlc:intent ;
    rdfs:comment """A declared definition-of-done: the vertical join point where a Spec's ambition
        meets a running system. Declares its targets as dct:relation to an Artifact and an
        Environment, and its delivering Component via wl:deliveredBy (WL-SPEC-79).""" .

wl:Effect a owl:Class ;
    skos:definition "effect" ;
    rdfs:subClassOf wl:Deliverable ;
    wl:layer wlc:intent ;
    rdfs:comment """A deliverable whose definition-of-done is a state of an existing system, not the
        existence and placement of an artifact — 'admin-cluster has Keycloak SSO configured'.
        Declares its target as a Deployment IRI (stable: environment + target kind + target name)
        and MUST NOT declare an Artifact. Witnessed by that Deployment reaching wlc:deployed over a
        Commit on the delivering component's default branch — the commit is discovered, never
        declared: its IRI carries a SHA (WL-SPEC-79) and so cannot be named in advance. A subclass
        rather than an attribute because the edges differ, not just the coordinates.""" .

wl:AcceptedDeviation a owl:Class ;
    skos:definition "accepted deviation" ;
    rdfs:subClassOf prov:Entity ;
    wl:layer wlc:intent ;
    rdfs:comment """A tolerated architectural deviation that drift queries suppress. Names the
        accepted edge via RDF reification (rdf:subject/rdf:predicate/rdf:object) WITHOUT asserting
        it — the edge stays out of the intent layer. Carries wl:sanctionedBy and an optional
        dct:valid expiry; past the expiry the violation re-surfaces (WL-SPEC-79).""" .


# ---------------------------------------------------------------------------
# Layer 2 — execution · VCS (observed; Task and Project projected from the
# backbone, which stays authoritative for state, leases, blocks and child_of)
# ---------------------------------------------------------------------------

wl:Task a owl:Class ;
    skos:definition "task" ;
    rdfs:subClassOf prov:Activity ;
    wl:layer wlc:execution ;
    rdfs:comment """A unit of work, projected read-only from the backbone. prov:Activity so a
        document can name the task that wrote it via prov:wasGeneratedBy, which is distinct from
        the components that wl:implements its sections (WL-SPEC-77). Task execution-state is NOT wl:status:
        the state machine is backbone-owned (WL-SPEC-75) and the graph mirrors it as a projected
        literal rather than forking the enum. Being an Activity, a Task names its author with
        prov:wasAssociatedWith (Activity→Agent) and never prov:wasAttributedTo, whose domain is
        prov:Entity: PROV declares Activity and Entity disjoint, so the latter would make every
        authored Task inconsistent.""" .

wl:Project a owl:Class ;
    skos:definition "project" ;
    wl:layer wlc:execution ;
    rdfs:comment """The umbrella for all work in a set of repositories — the backbone's projects
        table, verbatim. Unbounded. NB: doap:Project is a single repository; a wl:Project owns
        1..n of them (project_repos). Projection named graphs are anchored per Project.""" .

wl:Issue a owl:Class ;
    skos:definition "issue" ;
    rdfs:subClassOf prov:Entity ;
    wl:layer wlc:execution ;
    rdfs:comment """A tracker issue in a hosting provider, projected from VCS ingest and mirrored to
        a Task by wl:mirrors. Minted: WL-SPEC-79 pencilled in "reuse doap:", but DOAP has only
        doap:bug-database — a property pointing at a tracker's URL, not a class for one issue —
        and no surveyed vocabulary carries the concept (OSLC CM is the nearest, and WL-SPEC-79 already
        rejected OSLC as not a standard mainstream tooling recognises). prov:Entity because WL-SPEC-79
        asserts prov:wasAttributedTo for the author.""" .

wl:PullRequest a owl:Class ;
    skos:definition "pull request" ;
    rdfs:subClassOf prov:Entity ;
    wl:layer wlc:execution ;
    rdfs:comment """A proposed change against a repository, projected from VCS ingest. Joins its
        Task the GitHub-native way, by closing the Issue the Task wl:mirrors. Minted and
        prov:Entity for the same reasons as wl:Issue.""" .

wl:Skill a owl:Class ;
    skos:definition "skill" ;
    wl:layer wlc:execution ;
    rdfs:comment """One org-wide agent skill: identity only — name, description and source-repo
        IRI — so a design document can pin it with wl:recommendsSkill. Content, versions and
        embeddings stay in the backbone; the graph gets identity, not blobs. Execution layer
        because the node mirrors git through the backbone, like Issue and PullRequest — the pin
        that names it is the declared half (WL-SPEC-81). IRI is wlid:skill/<name>.""" .

wl:Event a owl:Class ;
    skos:definition "event" ;
    rdfs:subClassOf prov:Activity ;
    wl:layer wlc:execution ;
    rdfs:comment """A domain event in the backbone's append-only log (WL-SPEC-77): a state
        change witnessed at commit, curie in events.type, JSON-LD in events.payload. One subclass
        per event type — types differ in shape, so a class hierarchy, not a SKOS kind scheme.
        Vendor webhook deliveries share the events table but are not wl:Events (WL-SPEC-77: one
        log, two populations).""" .

wl:DocumentSubmitted a owl:Class ;
    skos:definition "document submission" ;
    rdfs:subClassOf wl:Event ;
    wl:layer wlc:execution ;
    rdfs:comment """A draft document was handed to review (lode doc submit, WL-SPEC-77). Changes no
        document column: the open review task is 'under review' (WL-SPEC-77).""" .

wl:DocumentAccepted a owl:Class ;
    skos:definition "document acceptance" ;
    rdfs:subClassOf wl:Event ;
    wl:layer wlc:execution ;
    rdfs:comment """A document moved draft → accepted (WL-SPEC-77). Carries the status transition as
        wl:fromStatus / wl:toStatus.""" .


# ---------------------------------------------------------------------------
# Layer 3 — runtime · deploy (observed; projected from ingest). Every class is
# anchored on a PROV-O parent where a truthful anchor exists, so PROV-aware
# tooling traverses the layer with no Worklode-specific knowledge (WL-SPEC-79).
# ---------------------------------------------------------------------------

wl:Artifact a owl:Class ;
    skos:definition "artifact" ;
    rdfs:subClassOf prov:Entity ;
    wl:layer wlc:runtime ;
    rdfs:seeAlso <https://spdx.org/rdf/3.0.1/terms/Software/Package> ;
    rdfs:comment """One built, versioned unit deployed elsewhere: a container image, a PyPI package,
        a git tag or a binary release. Kind is an attribute (wl:artifactKind), not a subclass — the
        kinds differ in coordinates, not in the edges they carry.""" .

wl:Build a owl:Class ;
    skos:definition "build" ;
    rdfs:subClassOf prov:Activity ;
    wl:layer wlc:runtime ;
    rdfs:seeAlso <https://spdx.org/rdf/3.0.1/terms/Build/Build> ;
    rdfs:comment """The activity that produced an Artifact — a CI workflow run. No v1 projection
        source exists (WL-SPEC-79); declared now so wl:Artifact can carry prov:wasGeneratedBy without a
        later breaking change.""" .

wl:Deployment a owl:Class ;
    skos:definition "deployment" ;
    rdfs:subClassOf prov:Activity ;
    wl:layer wlc:runtime ;
    rdfs:comment """The rollout of an Artifact OR a Commit to one target in one Environment — a Flux
        Kustomization, a PyPI publish, or a manually tracked target. prov:used binds an Artifact for
        built units and a Commit for IaC/GitOps repos, which ship nothing and reconcile a git
        revision instead (the wl:Effect case). Mirrors current state, one node per (environment,
        target kind, target name); rollout history is v2.""" .

wl:Environment a owl:Class ;
    skos:definition "environment" ;
    wl:layer wlc:runtime ;
    rdfs:comment """A deployment stage. Deliberately parentless: no surveyed vocabulary models a
        deployment stage, and prov:Location is spatial in intent. The instance set is closed to dev
        and prod by SHACL, matching the normalisation the delivery handlers already enforce.""" .

wl:Commit a owl:Class ;
    skos:definition "commit" ;
    rdfs:subClassOf prov:Entity ;
    wl:layer wlc:runtime ;
    rdfs:comment """One commit on a repository's default branch. Promoted from v2 (WL-SPEC-79) because
        delivery resolution is defined in terms of commit coverage (WL-SPEC-79).""" .

wl:RuntimeEvent a owl:Class ;
    skos:definition "runtime event" ;
    rdfs:subClassOf prov:Activity ;
    wl:layer wlc:runtime ;
    rdfs:comment """An observed runtime incident affecting a deployed Artifact — a crashloop, an OOM
        kill, a Flux reconciliation failure or recovery. Declared but unprojectable until it has a
        natural key (WL-SPEC-79 item 7).""" .


# ---------------------------------------------------------------------------
# Disjointness — proved by owlrl in CI, never published as closure (ADR-0004).
# ---------------------------------------------------------------------------

[] a owl:AllDisjointClasses ;
   owl:members ( wl:Component wl:DesignDoc wl:Plan wl:Section wl:Task wl:Deliverable wl:Project
                 wl:Skill ) .

[] a owl:AllDisjointClasses ;
   owl:members ( wl:Artifact wl:Build wl:Deployment wl:Environment wl:Commit wl:RuntimeEvent ) .


# ---------------------------------------------------------------------------
# Properties — intent
# ---------------------------------------------------------------------------

wl:governs a owl:ObjectProperty ;
    skos:definition "governs the architecture of" ;
    wl:layer wlc:intent ;
    rdfs:domain wl:DesignDoc ;
    rdfs:range wl:Component ;
    rdfs:comment "This design doc governs the architecture of that component." .

wl:deliveredBy a owl:ObjectProperty ;
    skos:definition "is delivered by" ;
    wl:layer wlc:intent ;
    rdfs:domain wl:Deliverable ;
    rdfs:range wl:Component ;
    rdfs:comment """The component that delivers this deliverable. Deliberately NOT functional: a
        deliverable may be delivered by several components, each advancing at its own pace. Closes
        the Component→Section → Deliverable → Environment join that makes 'component A implemented
        section B by deploying deliverable C to environment D' answerable per environment. Declared
        rather than derived because the derivable route (Artifact→Build→Commit→paths→Component)
        needs wl:Build, which has no v1 projection source (WL-SPEC-79). SHACL enforces >=1.""" .

wl:artifact a owl:DatatypeProperty ;
    wl:layer wlc:intent ;
    rdfs:range xsd:string ;
    rdfs:comment """The declared catalog address or label selector an entity is verified by
        (WL-SPEC-75). No rdfs:domain: a Deliverable, a Task and a DesignDoc all declare one — the
        `artifact` frontmatter/field key. Declares additively: removing the key undeclares
        nothing (WL-SPEC-75).""" .

wl:status a owl:ObjectProperty, owl:FunctionalProperty ;
    skos:definition "has status" ;
    wl:layer wlc:intent ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( wl:DesignDoc wl:Plan wl:Section ) ] ;
    rdfs:range skos:Concept ;
    rdfs:comment """Editorial lifecycle status in wlc:DesignDocStatus, applying to a DesignDoc, a
        Plan, or a single Section (WL-SPEC-77). Functional catches >1; SHACL enforces >=1.
        Implementation is not a status — it is a coverage query over wl:implements (WL-SPEC-77).""" .

wl:lastRevisedIn a owl:ObjectProperty, owl:FunctionalProperty ;
    skos:definition "was last revised in" ;
    wl:layer wlc:intent ;
    rdfs:domain wl:Section ;
    rdfs:range wl:DesignDoc ;
    rdfs:comment """The document version in which this section's content last changed. Lets a claim
        pinned at version N be tested for staleness without per-section version IRIs. Range is
        wl:DesignDoc because a versioned snapshot (wlid:doc/<slug>/v3) is an instance of the same
        class as its canonical document — DCAT's own pattern, where dcat:hasVersion relates a
        resource to a resource — so no version class is minted. Ordering comes from dcat:version on
        the snapshot, never from comparing IRIs: a claim pinned at v3 is stale iff
        ?sec wl:lastRevisedIn/dcat:version ?n with ?n > 3.""" .

wl:sanctionedBy a owl:ObjectProperty ;
    skos:definition "is sanctioned by" ;
    wl:layer wlc:intent ;
    rdfs:domain wl:AcceptedDeviation ;
    rdfs:range wl:DesignDoc ;
    rdfs:comment "The DesignDoc/ADR that authorises this accepted deviation." .

wl:recommendsSkill a owl:ObjectProperty ;
    skos:definition "recommends the skill" ;
    wl:layer wlc:intent ;
    rdfs:domain wl:DesignDoc ;
    rdfs:range wl:Skill ;
    rdfs:comment """A design document pins this skill, declared from its `skills:` frontmatter when
        the document is ingested (WL-SPEC-81). Task pins are the backbone tasks.skills field,
        projected as wl:requiresSkill (WL-SPEC-77), not this edge; brief resolution unions the
        two.""" .

wl:reviewer a owl:ObjectProperty ;
    skos:definition "is reviewed by" ;
    wl:layer wlc:intent ;
    rdfs:domain wl:Component ;
    rdfs:range foaf:Agent ;
    rdfs:comment "Agent (GitHub user/team IRI) to notify about PRs affecting this component." .


# ---------------------------------------------------------------------------
# Properties — execution
# ---------------------------------------------------------------------------

wl:implements a owl:ObjectProperty ;
    skos:definition "implements" ;
    wl:edgeOrigin wlc:declared ;
    wl:storedAs "doc_edges.implements" ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Component ;
    rdfs:range wl:Section ;
    rdfs:comment """This component's code, at the pinned version, implements this section — the
        claim in .worklode/implements.yaml, derived by observed/repo-implements (WL-SPEC-77). Evidence,
        where the neighbouring terms are intent and work: a Plan wl:covers a Section to undertake
        it, a Task wl:produces a Deliverable to do the work, and this edge says the code landed.
        Keeps the name because this is the paradigmatic sense of the word; what moved out is the
        Task half (WL-SPEC-78), which is why the domain can finally be stated. WL-SPEC-79's DesignDoc
        range was re-pointed to Section by WL-SPEC-77 Coverage stays a count query over sections, so
        no wl:fullyImplements is minted.""" .

wl:pinnedVersion a owl:ObjectProperty, owl:FunctionalProperty ;
    skos:definition "was validated against" ;
    wl:layer wlc:execution ;
    rdfs:range wl:DesignDoc ;
    rdfs:comment """The document version a wl:implements claim was validated against — the
        manifest's pinned: value (WL-SPEC-77), carried as an RDF-1.2 annotation on the asserted
        edge (WL-SPEC-79, WL-275). RDF 1.2 annotates an edge through a reifier linked to the edge's
        triple term by rdf:reifies, so a claim emits three N-Triples lines: the edge itself,
        <id/claim/…> rdf:reifies <<( <component> wl:implements <section> )>>, and
        <id/claim/…> wl:pinnedVersion <id/doc/<slug>/v<n>>. The reifier is an IRI keyed on the
        edge, not a blank node, because the projection replaces a whole named graph and must
        render byte-identical output every run. SPARQL reads it back through the annotation
        pattern: <<?c wl:implements ?s>> wl:pinnedVersion ?v. The range is the versioned snapshot,
        which carries the document's own class (WL-SPEC-77) — the same shape wl:lastRevisedIn points
        at, so the stale-claim query compares the two through dcat:version. No rdfs:domain: the
        subject is a reifier of a triple term, which RDF 1.1 tooling cannot state; this
        declaration itself is plain 1.1, and only emitted claim data uses the 1.2 syntax.""" .

wl:produces a owl:ObjectProperty ;
    skos:definition "produces" ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Task ;
    rdfs:range wl:Deliverable ;
    rdfs:comment """The work that makes a Deliverable exist. Shared wl:implements until WL-SPEC-78
        separated them: a task does not implement a section — it produces the deliverable, and the
        component is what implements. Authored on the task; its backbone projection is deferred
        to v2 until a task→deliverable edge exists in the backbone (WL-SPEC-79).
        WL-SPEC-79 also ranged this edge over Component and admitted Issue and PullRequest as
        subjects; WL-SPEC-78 drops all three. wl:affects already carries the component half, and an
        issue or a pull request reaches a deliverable only through the task it is bound to —
        wl:mirrors for the issue, the PR's own task binding for the PR.""" .

wl:covers a owl:ObjectProperty ;
    skos:definition "covers" ;
    wl:edgeOrigin wlc:declared ;
    wl:storedAs "doc_edges.covers" ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Plan ;
    rdfs:range wl:Rule ;
    rdfs:comment """A Plan's undertaking to see a Rule built, discharged by the tasks its
        acceptance mints (WL-SPEC-77). Deliberately not wl:implements: a plan writes no code, so it
        claims nothing — one word for the promise and for the evidence that redeems it leaves the
        two indistinguishable (WL-SPEC-78). The frontmatter key is `covers`; `implements` on a plan is
        its retired spelling.""" .

# --- Rules ---

wl:Rule a owl:Class ;
    skos:definition "rule" ;
    wl:layer wlc:intent ;
    rdfs:subClassOf wl:Section ;
    rdfs:comment "The lowest heading unit of a spec or ADR: the thing that carries an identity (WL-REQ-<n> or WL-RULE-<n>), a kind, a status, versions and edges (S8 to S11)." .

wl:ruleKind a owl:ObjectProperty, owl:FunctionalProperty ;
    skos:definition "is of kind" ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Rule ;
    rdfs:range skos:Concept ;
    rdfs:comment """The rule's kind, from wlc:RuleKind: wlc:requirement, wlc:catalogue,
        wlc:invariant, wlc:definition or wlc:principle (WL-REQ-165). A plan covers
        requirements and catalogues; an invariant governs every task in its project; a
        definition and a principle are read through a rule's context closure (§4c).
        wlc:informative is retired and reads as a principle until the migration (§19.7).""" .

wl:Arrangement a owl:Class ;
    skos:definition "arrangement" ;
    wl:layer wlc:intent ;
    rdfs:subClassOf wl:DesignDoc ;
    rdfs:comment "A document as an ordered selection of rules; it owns no text of its own (WL-SPEC-77)." .

wl:arranges a owl:ObjectProperty ;
    skos:definition "arranges" ;
    wl:layer wlc:intent ;
    rdfs:domain wl:Arrangement ;
    rdfs:range wl:Rule ;
    rdfs:comment "The arrangement includes this rule; the rule's wl:position gives its order." .

wl:position a owl:DatatypeProperty ;
    wl:layer wlc:intent ;
    rdfs:domain wl:Rule ;
    rdfs:range xsd:integer ;
    rdfs:comment "1-based position of the rule in its arrangement." .

wl:refines a owl:ObjectProperty ;
    skos:definition "refines" ;
    wl:edgeOrigin wlc:declared ;
    wl:storedAs "rule_edges.refines" ;
    wl:layer wlc:intent ;
    rdfs:domain wl:Rule ;
    rdfs:range wl:Rule ;
    rdfs:comment """Subject narrows the object, a principle or a wider rule. In the subject's
        context closure (WL-REQ-1367).""" .

wl:refinedBy a owl:ObjectProperty ;
    skos:definition "is refined by" ;
    wl:edgeOrigin wlc:inferred ;
    wl:layer wlc:intent ;
    owl:inverseOf wl:refines ;
    rdfs:domain wl:Rule ;
    rdfs:range wl:Rule ;
    rdfs:comment "Inferred from wl:refines, never stored (WL-REQ-1288)." .

wl:needs a owl:ObjectProperty ;
    skos:definition "needs" ;
    wl:edgeOrigin wlc:declared ;
    wl:storedAs "rule_edges.needs" ;
    wl:layer wlc:intent ;
    rdfs:domain wl:Rule ;
    rdfs:range wl:Rule ;
    rdfs:comment """Subject cannot be applied without a fact or term the object states, and does
        not narrow the object. In the subject's context closure (WL-REQ-1367).""" .

wl:neededBy a owl:ObjectProperty ;
    skos:definition "is needed by" ;
    wl:edgeOrigin wlc:inferred ;
    wl:layer wlc:intent ;
    owl:inverseOf wl:needs ;
    rdfs:domain wl:Rule ;
    rdfs:range wl:Rule ;
    rdfs:comment "Inferred from wl:needs, never stored (WL-REQ-1288)." .

wl:constrains a owl:ObjectProperty ;
    skos:definition "constrains" ;
    wl:edgeOrigin wlc:declared ;
    wl:storedAs "rule_edges.constrains" ;
    wl:layer wlc:intent ;
    rdfs:domain wl:Rule ;
    rdfs:range wl:Rule ;
    rdfs:comment "Subject must hold whenever the object does; a task implementing the object must also satisfy the subject (S12)." .

wl:conflictsWith a owl:ObjectProperty, owl:SymmetricProperty ;
    skos:definition "conflicts with" ;
    wl:edgeOrigin wlc:declared ;
    wl:storedAs "rule_edges.conflictsWith" ;
    wl:layer wlc:intent ;
    rdfs:domain wl:Rule ;
    rdfs:range wl:Rule ;
    rdfs:comment """Two rules state one fact with different values. A finding against the spec
        until the rule that does not own the fact is fixed (WL-REQ-1367).""" .

wl:references a owl:ObjectProperty ;
    skos:definition "references" ;
    wl:edgeOrigin wlc:declared ;
    wl:storedAs "rule_edges.references" ;
    wl:layer wlc:intent ;
    rdfs:domain wl:Rule ;
    rdfs:range wl:Rule ;
    rdfs:comment """A textual pointer from the rule to another rule, derived from the rule text on
        every version and replaced with it (S26), or written by hand for context that helps a
        reader and is not needed to apply the rule. Outside the context closure (WL-REQ-1367).""" .

wl:referencedBy a owl:ObjectProperty ;
    skos:definition "is referenced by" ;
    wl:edgeOrigin wlc:inferred ;
    wl:layer wlc:intent ;
    owl:inverseOf wl:references ;
    rdfs:domain wl:Rule ;
    rdfs:range wl:Rule ;
    rdfs:comment "Inferred from wl:references, never stored (WL-REQ-1288)." .

wl:defers a owl:ObjectProperty ;
    skos:definition "defers" ;
    wl:edgeOrigin wlc:declared ;
    wl:storedAs "doc_edges.defers" ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Plan ;
    rdfs:range wl:Section ;
    rdfs:comment """A Plan's explicit handoff of a Section it will not build (WL-SPEC-78). The
        deferring plan contributes no coverage; the section stays a planning gap, named rather
        than silent, until some plan covers it. The owner hangs off the qualified wl:Deferral
        node, never off this edge. Frontmatter key `defers`, entries {spec, to}; stored as a
        doc_edges 'defers' row with the owner on the row (owner_doc or owner_external).""" .

wl:amends a owl:ObjectProperty ;
    skos:definition "amends" ;
    wl:edgeOrigin wlc:declared ;
    wl:storedAs "rule_edges.amends" ;
    wl:layer wlc:intent ;
    rdfs:domain wl:Rule ;
    rdfs:range wl:Rule ;
    rdfs:comment """The subject rule changes how the object rule is read without replacing it
        (WL-SPEC-77). A rule_edges row from the amending rule to the amended one, written by
        `lode rule link A --amends B`. Documents do not amend each other.""" .

wl:Deferral a owl:Class ;
    skos:definition "deferral" ;
    wl:layer wlc:execution ;
    rdfs:comment """A qualified wl:defers: which document owns the handed-off Section. Reified
        beside the direct edge, never in place of it. The node names both ends itself
        (wl:deferringPlan, wl:deferredSection) rather than hanging off a Plan→Deferral predicate,
        because a predicate whose object is a reification node cannot be read aloud as a
        sentence (WL-SPEC-78).""" .

wl:deferringPlan a owl:ObjectProperty, owl:FunctionalProperty ;
    skos:definition "was declared by" ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Deferral ;
    rdfs:range wl:Plan .

wl:deferredSection a owl:ObjectProperty, owl:FunctionalProperty ;
    skos:definition "hands off" ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Deferral ;
    rdfs:range wl:Section .

wl:deferredTo a owl:ObjectProperty, owl:FunctionalProperty ;
    skos:definition "hands off to" ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Deferral ;
    rdfs:range [ a owl:Class ; owl:unionOf ( wl:DesignDoc wl:Plan ) ] ;
    rdfs:comment """The owner: the document whose plans are expected to cover the deferred
        section. Usually a spec, whose future plans inherit the handoff; a plan when the
        successor already exists (WL-SPEC-78). Naming an owner gates nothing — delivery is any
        plan covering the section (WL-SPEC-78).""" .

wl:affects a owl:ObjectProperty ;
    skos:definition "affects" ;
    wl:layer wlc:execution ;
    rdfs:range wl:Component ;
    rdfs:comment "A Task/Issue/PullRequest touches/changes that component." .

wl:taskState a owl:DatatypeProperty, owl:FunctionalProperty ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Task ;
    rdfs:range xsd:string ;
    rdfs:comment """The task's execution state, projected as a literal mirror of the backbone enum:
        one of draft, ready, in_progress, in_review, merged, deployed_dev, deployed_prod, released,
        abandoned. Deliberately NOT wl:status and deliberately not a SKOS scheme — the state machine
        is backbone-owned (WL-SPEC-75), and modelling it here would fork it (WL-SPEC-79). The legal
        values are the tasks.state CHECK constraint (migration 0005_delivery); the legal
        transitions between them live in internal/store/tasks.go and are not modelled at all.
        shapes.ttl enumerates the values, so widening the CHECK means widening that shape.""" .

wl:priority a owl:DatatypeProperty, owl:FunctionalProperty ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Task ;
    rdfs:range xsd:string ;
    rdfs:comment """Projected literal mirror of the backbone priority enum: critical, high, medium,
        low. Deliberately NOT a SKOS scheme — the backbone owns the enum (WL-SPEC-79). The legal
        values are the tasks.priority CHECK constraint (migration 0001_baseline).""" .

wl:concern a owl:DatatypeProperty ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Task ;
    rdfs:range xsd:string ;
    rdfs:comment """Projected literal mirror of the backbone concern enum: completeness,
        performance, usability, security; absent when the task has none. Deliberately NOT a SKOS
        scheme — the backbone owns the enum (WL-SPEC-79). The legal values are the tasks.concern
        CHECK constraint (migration 0002_prioritization).""" .

wl:humanOnly a owl:DatatypeProperty, owl:FunctionalProperty ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Task ;
    rdfs:range xsd:boolean ;
    rdfs:comment """Projected mirror of the backbone tasks.human_only flag (migration
        0060_task_human_only): the task is reserved for a human and no agent may claim it.
        Emitted only when true; absent means false.""" .

wl:unmatchedPath a owl:DatatypeProperty ;
    wl:layer wlc:execution ;
    rdfs:domain doap:Project ;
    rdfs:range xsd:string ;
    rdfs:comment "A repo-relative path prefix matched by no component in the repo's .worklode/components.yaml — a coverage gap (WL-SPEC-82). Subject is the repo (doap:Project) node; written only by the repo-layout deriver." .

wl:taskKind a owl:ObjectProperty, owl:FunctionalProperty ;
    skos:definition "is of kind" ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Task ;
    rdfs:range skos:Concept ;
    rdfs:comment "Kind of task; see wlc:TaskKind. A fixed enum, never free text." .

wl:dependsOn a owl:ObjectProperty, owl:TransitiveProperty ;
    skos:definition "depends on" ;
    wl:edgeOrigin wlc:declared ;
    wl:storedAs "task_edges.dependsOn" ;
    wl:layer wlc:execution ;
    rdfs:subPropertyOf dct:requires ;
    rdfs:domain wl:Task ;
    rdfs:range wl:Task ;
    rdfs:comment """This task needs that task done first, stored as a task_edges `dependsOn` row
        from the dependent task (WL-REQ-87). Transitive, so reachability is a SPARQL property path (?t wl:dependsOn+ ?x) with no
        reasoner, and CI/owlrl proves the closure. Type-homogeneous by ADR-0004.""" .

wl:blocks a owl:ObjectProperty, owl:TransitiveProperty ;
    skos:definition "blocks" ;
    wl:edgeOrigin wlc:inferred ;
    wl:layer wlc:execution ;
    owl:inverseOf wl:dependsOn ;
    rdfs:domain wl:Task ;
    rdfs:range wl:Task ;
    rdfs:comment "This task blocks that task: inferred from wl:dependsOn, never stored. Transitive." .

wl:blockedByPlan a owl:ObjectProperty, owl:TransitiveProperty ;
    skos:definition "is ordered after" ;
    wl:edgeOrigin wlc:declared ;
    wl:storedAs "doc_edges.blockedBy" ;
    wl:layer wlc:execution ;
    rdfs:subPropertyOf dct:requires ;
    rdfs:domain wl:Plan ;
    rdfs:range wl:Plan ;
    rdfs:comment """This plan is ordered after that plan — the document-level blocks edge
        (WL-SPEC-77): every task in this plan is held while any task in the blocking plan's
        set is open. A distinct property, never a widened wl:dependsOn, so the Task→Task
        closure stays type-homogeneous (ADR-0004) and ?t wl:dependsOn+ ?x never walks across
        document ordering. Transitive, so plan-ordering reachability is a property path
        (?p wl:blockedByPlan+ ?x) with no reasoner. Declared by the document-level plan
        frontmatter keys `blocks`/`blockedBy` (WL-SPEC-77) — document references, unlike the
        task-level `blockedBy` numbers inside a plan's ## Tasks, which mint Task→Task
        wl:blocks edges (WL-SPEC-77). Declared by the later plan, stored as a doc_edges
        `blockedBy` row from the later plan to the earlier one.""" .

wl:blocksPlan a owl:ObjectProperty, owl:TransitiveProperty ;
    skos:definition "is ordered before" ;
    wl:edgeOrigin wlc:inferred ;
    wl:layer wlc:execution ;
    owl:inverseOf wl:blockedByPlan ;
    rdfs:domain wl:Plan ;
    rdfs:range wl:Plan ;
    rdfs:comment """This plan is ordered before that plan (WL-SPEC-77): inferred, never
        stored. Transitive. "Plan B after plan A"
        is A wl:blocksPlan B.""" .

wl:duplicateOf a owl:ObjectProperty, owl:FunctionalProperty ;
    skos:definition "duplicates" ;
    wl:edgeOrigin wlc:declared ;
    wl:storedAs "task_edges.duplicate_of" ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Task ;
    rdfs:range wl:Task ;
    rdfs:comment """This task is the same request as that task, which is the canonical one
        (backbone duplicate_of, WL-SPEC-75). Provenance, not scheduling: deliberately NOT
        a subproperty of dct:requires and deliberately not transitive, and it absorbs nothing
        -- the canonical task inherits none of the duplicate's skills, edges or body.
        Functional -- a duplicate names exactly one canonical task, mirroring the
        task_edges_single_canonical index. Distinct from wl:mirrors, which pairs a Task with
        the external Issue tracking it; this pairs two Tasks. No named inverse: the canonical
        task's duplicates are a backwards traversal, not a second stored edge.""" .

wl:followUpTo a owl:ObjectProperty, owl:FunctionalProperty ;
    skos:definition "follows up on" ;
    wl:edgeOrigin wlc:declared ;
    wl:storedAs "task_edges.follow_up_to" ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Task ;
    rdfs:range wl:Task ;
    rdfs:comment """This task was spun out of the work on that task (backbone follow_up_to,
        WL-SPEC-75). Provenance, not scheduling: deliberately NOT a subproperty of
        dct:requires and deliberately not transitive, because it implies no ordering and
        nothing walks it. Functional -- a task has at most one origin, mirroring the
        task_edges_single_origin index. No named inverse: the origin's follow-ups are a
        backwards traversal, not a second stored edge.""" .

wl:plannedIn a owl:ObjectProperty, owl:FunctionalProperty ;
    skos:definition "was planned in" ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Task ;
    rdfs:range wl:Plan ;
    rdfs:comment "The plan whose acceptance minted this task (WL-SPEC-77; backbone tasks.plan_doc)." .

wl:about a owl:ObjectProperty, owl:FunctionalProperty ;
    skos:definition "is about" ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Task ;
    rdfs:range foaf:Document ;
    rdfs:comment """The document a review, planning or escalation task is about (WL-SPEC-77;
        backbone tasks.about_doc). Document-level: the section, when one is named, stays in
        the backbone.""" .

wl:inProject a owl:ObjectProperty, owl:FunctionalProperty ;
    skos:definition "is in" ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Task ;
    rdfs:range wl:Project ;
    rdfs:comment """Derived from tasks.project_id: every Task is in exactly one Project. Stays
        split from dct:isPartOf so the Task→Task decomposition remains type-homogeneous and
        cleanly transitive. Projection named graphs are anchored per Project.""" .

wl:requiresSkill a owl:ObjectProperty ;
    skos:definition "requires the skill" ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Task ;
    rdfs:range wl:Skill ;
    rdfs:comment """The executing agent loads this skill before starting: the task pin of WL-SPEC-81,
        projected from the backbone tasks.skills field and minted onto the task by plan
        acceptance (WL-SPEC-77). Distinct from wl:recommendsSkill because the owners differ — the
        pin on a task is execution-layer fact, the pin in a design document declared intent;
        brief resolution unions the two.""" .

wl:mirrors a owl:ObjectProperty, owl:SymmetricProperty ;
    skos:definition "mirrors" ;
    wl:layer wlc:execution ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( wl:Task wl:Issue ) ] ;
    rdfs:range  [ a owl:Class ; owl:unionOf ( wl:Task wl:Issue ) ] ;
    rdfs:comment """Bidirectional mirror between a backbone Task and a tracker Issue. The PR→Task
        join piggybacks GitHub's native Closes #N (the PR closes the mirrored Issue). Domain and
        range are the SAME union, not Task→Issue: a symmetric property whose domain and range
        differ entails that every Issue is a Task, which contradicts their disjointness. OWL
        therefore states the pair; shapes.ttl pins the intended direction (a Task mirrors an
        Issue).""" .

wl:subject a owl:ObjectProperty ;
    skos:definition "is about" ;
    wl:layer wlc:execution ;
    rdfs:domain wl:Event ;
    rdfs:comment """The thing the event is about (WL-SPEC-77). Range deliberately open: any
        backbone entity.""" .

wl:fromStatus a owl:ObjectProperty, owl:FunctionalProperty ;
    skos:definition "moved from status" ;
    wl:layer wlc:execution ;
    rdfs:domain wl:DocumentAccepted ; rdfs:range skos:Concept ;
    rdfs:comment "Status before the transition (a wlc: editorial status)." .

wl:toStatus a owl:ObjectProperty, owl:FunctionalProperty ;
    skos:definition "moved to status" ;
    wl:layer wlc:execution ;
    rdfs:domain wl:DocumentAccepted ; rdfs:range skos:Concept ;
    rdfs:comment "Status after the transition (a wlc: editorial status)." .


# ---------------------------------------------------------------------------
# Properties — runtime (WL-SPEC-79)
# ---------------------------------------------------------------------------

wl:artifactKind a owl:ObjectProperty, owl:FunctionalProperty ;
    skos:definition "is of kind" ;
    wl:layer wlc:runtime ;
    rdfs:domain wl:Artifact ;
    rdfs:range skos:Concept ;
    rdfs:comment "Kind of artifact; see wlc:ArtifactKind. Functional catches >1, SHACL catches 0." .

wl:digest a owl:DatatypeProperty ;
    wl:layer wlc:runtime ;
    rdfs:domain wl:Artifact ;
    rdfs:range xsd:string ;
    rdfs:comment """Content digest as an opaque prefixed string, e.g. "sha256:abc…". Minted rather
        than reusing spdx:checksum: that is a class requiring an algorithm/value node, and the
        ingested value is a single opaque string. A spdx:Checksum alignment is additive if SBOM
        interop is ever wanted.""" .

wl:cutFrom a owl:ObjectProperty ;
    skos:definition "was cut from" ;
    wl:layer wlc:runtime ;
    rdfs:domain wl:Artifact ;
    rdfs:range wl:Commit ;
    rdfs:comment """The commit a published release was cut from: its target_commitish where that
        resolves, else the default branch head at publish time (WL-SPEC-75). The delivery frontier
        follows from it rather than being a second edge — the object is a commit on the default
        branch, so the release carries every commit up to and including it, and the resolver
        compares against that ancestry. Domain is Artifact, not Deployment: the per-environment
        frontier has no node (WL-SPEC-79). Spelled wl:covers until WL-SPEC-78 needed that name for the
        Plan→Section undertaking, and renamed for the fact rather than its consequence.""" .

wl:toEnvironment a owl:ObjectProperty, owl:FunctionalProperty ;
    skos:definition "deploys to" ;
    wl:layer wlc:runtime ;
    rdfs:domain wl:Deployment ;
    rdfs:range wl:Environment ;
    rdfs:comment "The environment this deployment targets." .

wl:deploymentStatus a owl:ObjectProperty, owl:FunctionalProperty ;
    skos:definition "has rollout status" ;
    wl:layer wlc:runtime ;
    rdfs:domain wl:Deployment ;
    rdfs:range skos:Concept ;
    rdfs:comment "Current rollout status; see wlc:DeploymentStatus." .

wl:targetKind a owl:ObjectProperty, owl:FunctionalProperty ;
    skos:definition "targets a" ;
    wl:layer wlc:runtime ;
    rdfs:domain wl:Deployment ;
    rdfs:range skos:Concept ;
    rdfs:comment "Kind of deployment target; see wlc:DeployTargetKind." .

wl:runtimeEventKind a owl:ObjectProperty, owl:FunctionalProperty ;
    skos:definition "is of kind" ;
    wl:layer wlc:runtime ;
    rdfs:domain wl:RuntimeEvent ;
    rdfs:range skos:Concept ;
    rdfs:comment "Kind of runtime incident; see wlc:RuntimeEventKind." .


# ---------------------------------------------------------------------------
# Annotation property
# ---------------------------------------------------------------------------

wl:layer a owl:AnnotationProperty ;
    rdfs:range skos:Concept ;
    rdfs:comment """Model-layer membership (wlc:ModelLayer: intent/execution/runtime) of a
        vocabulary term, so all intent classes etc. can be listed. Annotation only, and untagged
        itself: a self-applied wl:layer would name no layer truthfully.""" .

wl:edgeOrigin a owl:AnnotationProperty ;
    rdfs:range skos:Concept ;
    rdfs:comment "Marks an edge property wlc:declared or wlc:inferred (WL-REQ-1288)." .

wl:storedAs a owl:AnnotationProperty ;
    rdfs:range xsd:string ;
    rdfs:comment """On a declared edge property, the stored type as "<table>.<type>". A property
        stored in two tables carries two values.""" .

# Reused edge terms, annotated only: no rdfs:domain or rdfs:range, because a
# domain on a shared term would type every subject in every graph.

dct:requires wl:edgeOrigin wlc:declared ;
    skos:definition "requires" ;
    wl:storedAs "doc_edges.requires" ;
    rdfs:comment "Declared between documents: the subject needs the object." .

dct:isRequiredBy wl:edgeOrigin wlc:inferred ;
    skos:definition "is required by" ;
    owl:inverseOf dct:requires ;
    rdfs:comment "Inferred from dct:requires, never stored." .

prov:wasDerivedFrom wl:edgeOrigin wlc:declared ;
    skos:definition "was derived from" ;
    wl:storedAs "doc_edges.wasDerivedFrom", "rule_edges.wasDerivedFrom" ;
    rdfs:comment "Declared on a document or rule derived from the object." .

dct:replaces wl:edgeOrigin wlc:declared ;
    skos:definition "supersedes" ;
    wl:storedAs "rule_edges.supersedes" ;
    rdfs:comment "Declared on wl:Rule supersession, new → old." .

dct:isReplacedBy wl:edgeOrigin wlc:inferred ;
    skos:definition "is superseded by" ;
    owl:inverseOf dct:replaces ;
    rdfs:comment "Inferred from dct:replaces, never stored." .

dct:isPartOf wl:edgeOrigin wlc:declared ;
    skos:definition "is part of" ;
    wl:storedAs "task_edges.child_of" ;
    rdfs:comment "Declared on a child task, pointing at its parent." .

dct:hasPart wl:edgeOrigin wlc:inferred ;
    skos:definition "contains" ;
    owl:inverseOf dct:isPartOf ;
    rdfs:comment "Inferred from dct:isPartOf, never stored." .


# ---------------------------------------------------------------------------
# Reused, not minted. Listed so the boundary is visible.
#
#   dct:requires / dct:isRequiredBy    dependency
#   dct:hasPart / dct:isPartOf         decomposition; child_of mirror
#   dct:replaces / dct:isReplacedBy    supersession between wl:Rule nodes; rule edges
#                                      store dct:replaces as supersedes (new → old,
#                                      12 S22) and dct:isReplacedBy is inferred, never
#                                      stored. Documents do not replace each other
#   dct:title / description            labels; Deliverable acceptance criteria
#   dct:relation                       Deliverable → declared Artifact/Environment target
#   dct:created / modified / issued / date / valid / identifier
#   foaf:Document                      super-type of DesignDoc and Section
#   foaf:Agent / prov:Agent            owner, author, reviewer
#   prov:wasAttributedTo               author of an Entity (Issue, PullRequest,
#                                      DesignDoc, AcceptedDeviation)
#   prov:wasAssociatedWith             author of an Activity (Task) — see wl:Task
#   prov:wasGeneratedBy / wasDerivedFrom / wasRevisionOf
#                                      rule edges store the derivation edge as
#                                      wasDerivedFrom (12 S22)
#   prov:used                          Deployment → Artifact or Commit
#   prov:startedAtTime / endedAtTime / generatedAtTime
#   doap:Project                       repository grouping (with dct:hasPart)
#   owl:versionInfo                    artifact version string
#   skos:Concept / ConceptScheme / inScheme / OrderedCollection / memberList
#   rdf:subject / predicate / object   names an AcceptedDeviation's edge un-asserted
#   rdf:reifies                        RDF 1.2 reifier → triple term, carrying
#                                      wl:pinnedVersion on a wl:implements edge
#   dcat:hasCurrentVersion / hasVersion / version / previousVersion   (WL-SPEC-77)
#
# Deliberately absent — do not reintroduce:
#
#   wl:supersededSection       retired (WL-SPEC-77): sections are addressable, so
#                              partial supersession is dct:isReplacedBy between
#                              them. wl:pinnedVersion's *data* uses an RDF-1.2
#                              triple term and rdf:reifies, but its declaration
#                              is plain 1.1, so there is still no
#                              ontology.1-2.ttl companion (cf. WL-SPEC-79).
#   wl:fullyImplements,        never minted (WL-SPEC-77): declared coverage is a
#   wl:partiallyImplements     second source of truth that goes stale.
#   wl:Coverage,               retired (WL-REQ-208): a covers edge means
#   wl:coverageLevel,          the plan builds the whole rule, so there is no
#   wl:completedWith,          level to qualify it with.
#   wlc:CoverageLevel
#   wl:Release                 never minted (WL-SPEC-79): a release is a wl:Artifact
#                              of kind wlc:git_tag plus a wl:cutFrom edge.
#   wl:Milestone               v2 (WL-SPEC-79).
#   wlc:TaskState,             no SKOS scheme for a backbone-owned enum:
#   wlc:TaskPriority,          wl:taskState, wl:priority and wl:concern are
#   wlc:Concern                literal mirrors, so the backbone keeps the enums
#                              and the transitions (WL-SPEC-79).
#   wlc:EvidenceState,         no SKOS scheme for a backbone-owned enum: the
#   wlc:EvidenceProvenance     artifact_evidence.state/provenance CHECKs are
#                              the source, the same liability the
#                              wlc:TaskState precedent already names
#                              (WL-PLAN-102 Decisions).
#   wlc:ActorKind              never minted: actors are foaf:Agent/prov:Agent
#                              (WL-SPEC-79), and prov:Person vs
#                              prov:SoftwareAgent already carries the split.
#                              concept.ttl's closing block has the reasoning.
# ---------------------------------------------------------------------------

# Task-kind behavior properties. Instance values live in task-kinds.ttl.
# Subjects are concepts in wlc:TaskKind, not individual tasks.

wl:claimable a owl:DatatypeProperty ;
    rdfs:domain skos:Concept ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Tasks of this kind may be leased. State, hierarchy and other eligibility checks still apply." .

wl:allowsChildren a owl:DatatypeProperty ;
    rdfs:domain skos:Concept ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Tasks of this kind may be hierarchy parents." .

wl:planMintable a owl:DatatypeProperty ;
    rdfs:domain skos:Concept ;
    rdfs:range xsd:boolean ;
    rdfs:comment "A plan may declare tasks of this kind for creation on acceptance." .

wl:allowsDecisions a owl:DatatypeProperty ;
    rdfs:domain skos:Concept ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Tasks of this kind may carry decision questions." .

wl:canBlock a owl:DatatypeProperty ;
    rdfs:domain skos:Concept ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Tasks of this kind may be the source of a blocks edge to another task." .

wl:kindMutable a owl:DatatypeProperty ;
    rdfs:domain skos:Concept ;
    rdfs:range xsd:boolean ;
    rdfs:comment "The public API permits changing into or out of this kind, subject to the target kind requirements. Both kinds must permit the change." .

wl:closesOnAnswers a owl:DatatypeProperty ;
    rdfs:domain skos:Concept ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Recording the final outstanding answer closes a task of this kind." .

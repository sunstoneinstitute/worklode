# Worklode concept schemes — the `wlc:` SKOS vocabularies.
#
# Companion to ontology.ttl, split by purpose per ADR-0007. Every scheme is a
# fixed enum, and every scheme is the range of one `wl:` object property in
# ontology.ttl — that is what earns a scheme, not being CHECK-backed. See
# "Enums with no scheme" at the foot of this file. All but wlc:ModelLayer do
# also mirror a CHECK constraint in the schema, and internal/store's
# TestConceptSchemesMatchCheckConstraints holds each one to its column.
# Sources: WL-SPEC-79, WL-SPEC-77 (status enum and task kinds),
# WL-SPEC-79 (the four runtime enums) and WL-SPEC-77 (document lifecycle).

@prefix wl:   <https://worklode.io/ns/ontology#> .
@prefix wlc:  <https://worklode.io/ns/concept/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://worklode.io/ns/concept/>
    dct:title "Worklode concept schemes" ;
    dct:source <https://worklode.io/ns/id/doc/spec-worklode-006> ,
               <https://worklode.io/ns/id/doc/spec-worklode-025> ,
               <https://worklode.io/ns/id/doc/spec-worklode-026> .


# ---------------------------------------------------------------------------
# DesignDoc lifecycle — purely editorial. `implemented` was removed by WL-SPEC-77:
# implementation is per-section and derived, so a document-level status would be
# a hand-maintained, lossy summary of something computable. WL-SPEC-77 removed
# `proposed`: a document under review stays `draft` with an open review task.
# ---------------------------------------------------------------------------

wlc:DesignDocStatus a skos:ConceptScheme ; skos:prefLabel "DesignDoc lifecycle" .

wlc:draft a skos:Concept ; skos:inScheme wlc:DesignDocStatus ; skos:prefLabel "draft" ;
    skos:definition "Being written, or under review with the review unresolved." .
wlc:accepted a skos:Concept ; skos:inScheme wlc:DesignDocStatus ; skos:prefLabel "accepted" ;
    skos:definition "Crit-resolved and approved as intent." .
wlc:stale a skos:Concept ; skos:inScheme wlc:DesignDocStatus ; skos:prefLabel "stale" ;
    skos:definition "A plan whose covered section was amended before execution and needs re-planning." .
wlc:superseded a skos:Concept ; skos:inScheme wlc:DesignDocStatus ; skos:prefLabel "superseded" ;
    skos:definition "Every rule the document contains is withdrawn; rule supersession is dct:replaces between rules." .
wlc:withdrawn a skos:Concept ; skos:inScheme wlc:DesignDocStatus ; skos:prefLabel "withdrawn" ;
    skos:definition "An accepted document closed without a successor." .
wlc:spent a skos:Concept ; skos:inScheme wlc:DesignDocStatus ; skos:prefLabel "spent" ;
    skos:definition "A plan whose every minted task has closed (12 S5)." .

# The order is data, so "is X before Y" is queryable. RDF still does not enforce
# legal transitions; those rules live with the authoring skill (WL-SPEC-80).
wlc:DesignDocStatusOrder a skos:OrderedCollection ;
    skos:memberList ( wlc:draft wlc:accepted wlc:stale wlc:superseded wlc:withdrawn wlc:spent ) .


# ---------------------------------------------------------------------------
# Rule kind — the rules.kind CHECK (WL-REQ-165). The kind sets the ref's
# infix: WL-REQ-<n> for a requirement, WL-RULE-<n> otherwise.
# ---------------------------------------------------------------------------

wlc:RuleKind a skos:ConceptScheme ; skos:prefLabel "Rule kind" .

wlc:requirement a skos:Concept ; skos:inScheme wlc:RuleKind ; skos:prefLabel "requirement" ;
    skos:definition "A plan builds it once; a gap until an accepted plan covers it." .
wlc:invariant a skos:Concept ; skos:inScheme wlc:RuleKind ; skos:prefLabel "invariant" ;
    skos:definition "Binds every task in its project and is never finished; never covered, never a gap." .
wlc:catalogue a skos:Concept ; skos:inScheme wlc:RuleKind ; skos:prefLabel "catalogue" ;
    skos:definition "A set of entries with one shape, each answering the same question; a plan builds its entries, checked by membership." .
wlc:definition a skos:Concept ; skos:inScheme wlc:RuleKind ; skos:prefLabel "definition" ;
    skos:definition "One term, one meaning, in one scope; read through a context closure, never covered, never a gap." .
wlc:principle a skos:Concept ; skos:inScheme wlc:RuleKind ; skos:prefLabel "principle" ;
    skos:definition "A design stance other rules refine; checkable only through its refiners, never covered, never a gap." .
wlc:informative a skos:Concept ; skos:inScheme wlc:RuleKind ; skos:prefLabel "informative" ;
    skos:definition "Retired (WL-REQ-165): reads as a principle until the §19.7 migration reclassifies it; stays in the CHECK until then." .


# ---------------------------------------------------------------------------
# Task kind — the union matching the tasks.kind CHECK constraint. Every kind
# describes a nature of work, not the artifact produced and not a structural
# role: container-ness is inferred from child_of edges (WL-SPEC-75), never
# declared here. wlc:rally is the one exception — it carries no work of its
# own, only the blocks edges naming what to finish now.
# ---------------------------------------------------------------------------

wlc:TaskKind a skos:ConceptScheme ; skos:prefLabel "Task kind" .

wlc:feature a skos:Concept ; skos:inScheme wlc:TaskKind ; skos:prefLabel "feature" ;
    skos:definition "New capability or behaviour." .
wlc:bug a skos:Concept ; skos:inScheme wlc:TaskKind ; skos:prefLabel "bug" ;
    skos:definition "Fix incorrect existing behaviour." .
wlc:chore a skos:Concept ; skos:inScheme wlc:TaskKind ; skos:prefLabel "chore" ;
    skos:definition "Maintenance with no behaviour change (deps, tooling, cleanup)." .
wlc:design a skos:Concept ; skos:inScheme wlc:TaskKind ; skos:prefLabel "design" ;
    skos:definition "Write or revise a design document; the document it produced is reachable by prov:wasGeneratedBy." .
wlc:review a skos:Concept ; skos:inScheme wlc:TaskKind ; skos:prefLabel "review" ;
    skos:definition "Review/evaluate someone else's work." .
wlc:spike a skos:Concept ; skos:inScheme wlc:TaskKind ; skos:prefLabel "spike" ;
    skos:definition "Time-boxed experiment to validate an approach; throwaway output." .
wlc:decision a skos:Concept ; skos:inScheme wlc:TaskKind ; skos:prefLabel "decision" ;
    skos:definition "Answer a posed question and record the answer on the task; the deliverable is the recorded answer in task_decisions, never a document or a diff." .
wlc:rally a skos:Concept ; skos:inScheme wlc:TaskKind ; skos:prefLabel "rally" ;
    skos:definition "A hand-assembled goal that carries no work of its own; its blocks edges name the tasks to finish now, and it ranks them first in pickup. Drafts are unlimited and inert; at most one is active per project." .


# ---------------------------------------------------------------------------
# Model layer — the wl:layer tag on every minted term.
# ---------------------------------------------------------------------------

wlc:ModelLayer a skos:ConceptScheme ; skos:prefLabel "Model layer" .

wlc:intent a skos:Concept ; skos:inScheme wlc:ModelLayer ; skos:prefLabel "intent" ;
    skos:definition "Declared design layer — what should be true." .
wlc:execution a skos:Concept ; skos:inScheme wlc:ModelLayer ; skos:prefLabel "execution" ;
    skos:definition "Observed execution/VCS layer — tasks, issues, PRs." .
wlc:runtime a skos:Concept ; skos:inScheme wlc:ModelLayer ; skos:prefLabel "runtime" ;
    skos:definition "Observed runtime/deploy layer — artifacts, deployments, environments." .


# ---------------------------------------------------------------------------
# Edge origin — the wl:edgeOrigin tag on every edge property (WL-REQ-1288).
# ---------------------------------------------------------------------------

wlc:EdgeOrigin a skos:ConceptScheme ; skos:prefLabel "Edge origin" .

wlc:declared a skos:Concept ; skos:inScheme wlc:EdgeOrigin ; skos:prefLabel "declared" ;
    skos:definition "Stored subject → object and owned by the subject." .
wlc:inferred a skos:Concept ; skos:inScheme wlc:EdgeOrigin ; skos:prefLabel "inferred" ;
    skos:definition "Read from the far end of a declared edge through owl:inverseOf, never stored." .


# ---------------------------------------------------------------------------
# Artifact kind (WL-SPEC-79). In v1 only git_tag rows are ever created; the other
# three are grammar, not data (WL-SPEC-79).
# ---------------------------------------------------------------------------

wlc:ArtifactKind a skos:ConceptScheme ; skos:prefLabel "Artifact kind" .

wlc:docker_image a skos:Concept ; skos:inScheme wlc:ArtifactKind ; skos:prefLabel "docker image" ;
    skos:definition "An OCI container image in a registry, identified by name, tag and digest." .
wlc:pypi a skos:Concept ; skos:inScheme wlc:ArtifactKind ; skos:prefLabel "PyPI package" ;
    skos:definition "A Python distribution published to a package index." .
wlc:git_tag a skos:Concept ; skos:inScheme wlc:ArtifactKind ; skos:prefLabel "git tag" ;
    skos:definition "A published release tag on a repository." .
wlc:binary a skos:Concept ; skos:inScheme wlc:ArtifactKind ; skos:prefLabel "binary release" ;
    skos:definition "A compiled executable published as a release asset." .


# ---------------------------------------------------------------------------
# Deployment status (WL-SPEC-79).
# ---------------------------------------------------------------------------

wlc:DeploymentStatus a skos:ConceptScheme ; skos:prefLabel "Deployment status" .

wlc:pending a skos:Concept ; skos:inScheme wlc:DeploymentStatus ; skos:prefLabel "pending" ;
    skos:definition "Target known; no reconciliation observed yet." .
wlc:reconciling a skos:Concept ; skos:inScheme wlc:DeploymentStatus ; skos:prefLabel "reconciling" ;
    skos:definition "Rollout in progress." .
wlc:deployed a skos:Concept ; skos:inScheme wlc:DeploymentStatus ; skos:prefLabel "deployed" ;
    skos:definition """Reconciliation succeeded; what the deployment used — an artifact, or a commit
        for IaC/GitOps targets — is live on this target.""" .
wlc:failed a skos:Concept ; skos:inScheme wlc:DeploymentStatus ; skos:prefLabel "failed" ;
    skos:definition "Reconciliation failed; the target is not serving the intended artifact." .


# ---------------------------------------------------------------------------
# Deployment target kind (WL-SPEC-79). wlc:pypi_target is spelled apart from
# wlc:pypi deliberately: the artifact kind and the target kind are different
# concepts that happen to share a name in the relational schema.
# ---------------------------------------------------------------------------

wlc:DeployTargetKind a skos:ConceptScheme ; skos:prefLabel "Deployment target kind" .

wlc:flux_kustomization a skos:Concept ; skos:inScheme wlc:DeployTargetKind ;
    skos:prefLabel "Flux Kustomization" ;
    skos:definition """A Flux-reconciled target. v1 files HelmRelease events here too; the
        distinction survives in the event type, not the target kind.""" .
wlc:pypi_target a skos:Concept ; skos:inScheme wlc:DeployTargetKind ; skos:prefLabel "PyPI publish" ;
    skos:definition "Publication to a package index as the delivery target." .
wlc:manual a skos:Concept ; skos:inScheme wlc:DeployTargetKind ; skos:prefLabel "manual" ;
    skos:definition "A target tracked by hand, with no automated reconciliation signal." .


# ---------------------------------------------------------------------------
# Runtime event kind (WL-SPEC-79).
# ---------------------------------------------------------------------------

wlc:RuntimeEventKind a skos:ConceptScheme ; skos:prefLabel "Runtime event kind" .

wlc:crashloop a skos:Concept ; skos:inScheme wlc:RuntimeEventKind ; skos:prefLabel "crashloop" .
wlc:oom a skos:Concept ; skos:inScheme wlc:RuntimeEventKind ; skos:prefLabel "OOM kill" .
wlc:flux_failure a skos:Concept ; skos:inScheme wlc:RuntimeEventKind ; skos:prefLabel "Flux failure" .
wlc:flux_recovery a skos:Concept ; skos:inScheme wlc:RuntimeEventKind ; skos:prefLabel "Flux recovery" .


# ---------------------------------------------------------------------------
# Enums with no scheme. A `wlc:` scheme is earned by being the range of a
# minted `wl:` object property — a controlled vocabulary a graph consumer
# reasons over. Being CHECK-backed is not the test: three backbone enums are
# CHECK-backed and still get no scheme.
#
# - `tasks.state`, `tasks.priority` and `tasks.concern` reach the graph as
#   projected literals on `wl:taskState`, `wl:priority` and `wl:concern`, all
#   xsd:string datatype properties (WL-SPEC-79). The backbone owns the enums and
#   the state machine; a scheme here would fork them (WL-SPEC-79), which is
#   the drift WL-SPEC-77 exists to prevent. ontology.ttl's "deliberately absent"
#   register already names them.
# - `actors.kind` has no `wl:` property to be the range of. Actors project as
#   `foaf:Agent`/`prov:Agent`, reused rather than minted (WL-SPEC-79), and
#   human/agent/service is the split `prov:Person` and `prov:SoftwareAgent`
#   already carry — so WL-SPEC-79's standards-first rule forbids the mint.
#
# All three are pinned in Go instead: `model.TaskStates`,
# `model.TaskPriorities` and `model.ActorKinds`, each held to its CHECK
# constraint by a test in internal/store.
# ---------------------------------------------------------------------------

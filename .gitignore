# The claim-time secrets ceremony writes this into every worktree. It holds
# op:// references, never values, but it is machine state rather than repo
# content. .worklode/config.toml next to it IS committed, so ignore the file
# and not the directory.
.worklode/secrets.env

# `lode secrets exec` renders templated catalog entries here (spec 042): 0600
# files holding real credential bytes, removed by `lode secrets purge`.
.worklode/secrets/


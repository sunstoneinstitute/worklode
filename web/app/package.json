    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.46.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",

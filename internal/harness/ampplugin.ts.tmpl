// worklode-hook v1 — installed by `lode install`; do not edit.
//
// Amp's JSON hook actions can only send a user message or redact tool input,
// so no hook binding in Amp's settings can reach the worklode CLI. Amp's
// Plugin API can: it runs this file under Bun and hands each handler a shell.
// So this plugin only pipes a hook payload into `lode hook <event>`. There is
// no worklode logic here; the binary is the integration.
//
// It sends the workspace root as `cwd` rather than letting `lode hook` fall
// back to its own working directory. An Amp plugin is "a long-lived process
// that may run for multiple threads concurrently", so the process cwd is fixed
// at Amp startup and says nothing about which workspace a given thread is in.
// Without `cwd` a hook would resolve the wrong worktree — and `lode hook`'s
// guard turns that into a silent NOP, which is the failure that looks exactly
// like success.
//
// `amp` and the handler arguments are typed `any` deliberately: Amp executes
// this file with Bun, which strips types without resolving them, and importing
// `@ampcode/plugin` would make a generated file depend on a package the user
// may not have installed.

export const description = "Worklode: binds Amp's session and turn events to `lode hook`."

export default function (amp: any) {
	// workspaceRoot is Amp's `system.workspaceRoot` as a filesystem path, or ""
	// when Amp is running without a workspace. An empty cwd is the payload
	// field simply being absent, which is what `lode hook` already handles.
	const workspaceRoot = (ctx: any): string => {
		const uri = ctx?.system?.workspaceRoot
		if (!uri) return ""
		try {
			return amp?.helpers?.filePathFromURI?.(uri) ?? ""
		} catch {
			return ""
		}
	}

	// bind wraps one `lode hook` invocation as an Amp event handler. It returns
	// nothing on every path: session.start is fire-and-forget, and agent.end's
	// result type admits void. agent.start's does not name a void arm, but its
	// one field is optional and Bun does not typecheck, so an absent result is
	// the same "append no context message" an empty object would be.
	//
	// The payload is interpolated into the shell template rather than
	// concatenated into it, so Bun quotes it as a single argument. That is the
	// one behaviour of `$` this file depends on and the one the Plugin API
	// reference does not spell out — it documents only "Bun's shell".
	const bind = (ampEvent: string, run: (payload: string, ctx: any) => Promise<any>) =>
		async (event: any, ctx: any): Promise<void> => {
			const payload = JSON.stringify({
				hook_event_name: ampEvent,
				session_id: event?.thread?.id ?? ctx?.thread?.id ?? "",
				cwd: workspaceRoot(ctx),
			})
			try {
				const result = await run(payload, ctx)
				// `$` reports a failed command through exitCode rather than by
				// throwing, so a silent non-zero would otherwise go unrecorded.
				if (result?.exitCode) {
					ctx?.logger?.log?.(
						`worklode: ${ampEvent} hook exited ${result.exitCode}: ${result.stderr ?? ""}`,
					)
				}
			} catch (err) {
				// A `lode` that is not on PATH, or a shell that throws instead of
				// reporting an exit code: neither is the user's problem mid-turn.
				// Worklode degrades to the git pre-commit heartbeat rather than
				// interrupting the session.
				ctx?.logger?.log?.(`worklode: ${ampEvent} hook failed: ${err}`)
			}
		}

{{ range .Bindings }}	amp.on({{ .Event | js }}, bind({{ .Event | js }}, (payload: string, ctx: any) => ctx.$`echo ${payload} | {{ .Command }}`))
{{ end }}}

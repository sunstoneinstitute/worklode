package api

// task.templ renders taskPageData for GET /tasks/{id}. Ported from
// templates/task.html. row.URL (webTimelineRow) is rendered as a plain Go
// string href, same as the pre-migration template — templ's own href
// sanitizer (github.com/a-h/templ's SafeURL / JoinURLErrs) neutralizes an
// unsafe scheme the same way html/template's contextual autoescaping did,
// just with a different placeholder (see web_test.go's
// TestTaskPageEscapesHostileTimelineURL).

templ Task(data taskPageData) {
	@Page(data.basePage) {
		<h1>{ data.Task.ID }: { data.Task.Title }</h1>
		<p>
			if data.Blocked {
				<span class="badge state-blocked">blocked</span>
			} else {
				<span class={ "badge state-" + data.Task.State }>{ data.Task.State }</span>
			}
			&nbsp;{ data.Task.Priority } / { data.Task.Kind }
			&nbsp;project: <a href={ "/projects/" + data.Task.ProjectID }>{ data.Task.ProjectID }</a>
		</p>
		<p class="muted">Created { FmtTime(data.Task.CreatedAt) } by { data.Task.CreatedBy } &mdash; updated { FmtTime(data.Task.UpdatedAt) }</p>
		if data.Task.Assignee != "" {
			<p class="muted">Assigned to { data.Task.Assignee }</p>
		}
		if data.Holder != nil {
			<p><strong>Held by:</strong> { data.Holder.ActorID } (expires { FmtTime(data.Holder.ExpiresAt) })</p>
		}

		<h2>Body</h2>
		<pre>{ data.Task.Body }</pre>

		<h2>Edges</h2>
		<ul>
			<li>Blocks:
				if len(data.Blocks) == 0 {
					<span class="muted">none</span>
				} else {
					for _, id := range data.Blocks {
						<a href={ "/tasks/" + id }>{ id }</a>{ " " }
					}
				}
			</li>
			<li>Blocked by:
				if len(data.BlockedBy) == 0 {
					<span class="muted">none</span>
				} else {
					for _, id := range data.BlockedBy {
						<a href={ "/tasks/" + id }>{ id }</a>{ " " }
					}
				}
			</li>
			<li>Parent:
				if data.Parent == "" {
					<span class="muted">none</span>
				} else {
					<a href={ "/tasks/" + data.Parent }>{ data.Parent }</a>
				}
			</li>
			<li>Children:
				if len(data.Children) == 0 {
					<span class="muted">none</span>
				} else {
					for _, id := range data.Children {
						<a href={ "/tasks/" + id }>{ id }</a>{ " " }
					}
					<span class="muted">({ data.Progress.Closed }/{ data.Progress.Total } closed)</span>
				}
			</li>
		</ul>

		<h2>Timeline</h2>
		if len(data.Timeline) == 0 {
			<p class="muted">No timeline entries yet.</p>
		} else {
			<table>
				<tr><th>When</th><th>Type</th><th>Summary</th><th>Source</th></tr>
				for _, row := range data.Timeline {
					<tr>
						<td>{ FmtTime(row.At) }</td>
						<td>{ row.Label }</td>
						<td>{ row.Summary }</td>
						<td>
							if row.URL != "" {
								<a href={ row.URL } rel="noreferrer">Open source</a>
							}
						</td>
					</tr>
				}
			</table>
		}
	}
}

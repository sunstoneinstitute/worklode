package api

import "strings"

// project.templ renders projectPageData for GET /projects/{id}: the project
// cockpit shell (spec 032 §10). Ported from templates/project.html.
// projectNav and workItem are shared with placeholder.templ, which needs
// the identical eight-item local nav (just with a different current-section
// marker) and the identical work-item line — html/template couldn't share
// them across pages (each page parsed alone with layout.html; see the
// removed parseWebTemplates), but templ's single package namespace can.

templ Project(data projectPageData) {
	@Page(data.basePage) {
		<link rel="canonical" href={ data.Cockpit.CanonicalURL }/>
		<div class="cockpit-grid">
			<nav aria-label="Project" class="project-nav">
				@projectNav(data.Cockpit.Project.ID, "overview")
			</nav>
			<div class="cockpit-canvas">
				<section aria-labelledby="outcome-heading">
					<h1 id="outcome-heading">{ data.Cockpit.Project.Name }</h1>
					<p class="muted">Project id: { data.Cockpit.Project.ID } &middot; key: { data.Cockpit.Project.Key }</p>
					<p>{ data.Cockpit.Project.Key } &middot; { data.Cockpit.Mode.Name }</p>
					<p class="muted">{ data.Cockpit.Mode.Basis.Summary }</p>
				</section>

				<section id="work" aria-labelledby="work-heading">
					<h2 id="work-heading">Current work</h2>

					<h3>Running</h3>
					<ul>
						if len(data.Cockpit.Work.InProgress) == 0 {
							<li>None</li>
						} else {
							for _, item := range data.Cockpit.Work.InProgress {
								<li>@workItem(item)</li>
							}
						}
					</ul>

					<h3>Awaiting review</h3>
					<ul>
						if len(data.Cockpit.Work.InReview) == 0 {
							<li>None</li>
						} else {
							for _, item := range data.Cockpit.Work.InReview {
								<li>@workItem(item)</li>
							}
						}
					</ul>

					<h3>Ready</h3>
					<ul>
						if len(data.Cockpit.Work.Ready) == 0 {
							<li>None</li>
						} else {
							for _, item := range data.Cockpit.Work.Ready {
								<li>@workItem(item)</li>
							}
						}
					</ul>

					<h3>Blocked</h3>
					<ul>
						if len(data.Cockpit.Work.Blocked) == 0 {
							<li>None</li>
						} else {
							for _, item := range data.Cockpit.Work.Blocked {
								<li>@workItem(item)</li>
							}
						}
					</ul>
				</section>

				<details>
					<summary>Evidence</summary>
					<p>Ranking focus: { rankingFocusText(data.Cockpit.RankingFocus) }</p>

					<h3>Repositories</h3>
					<ul>
						if len(data.Cockpit.Repositories) == 0 {
							<li>No mapped repositories</li>
						} else {
							for _, r := range data.Cockpit.Repositories {
								<li>{ r.Repo }: { r.DoneState } ({ r.StatusEvidence.Category })</li>
							}
						}
					</ul>

					<h3>Blocking concerns</h3>
					<ul>
						if len(data.Cockpit.SecondaryConcerns) == 0 {
							<li>No open blockers</li>
						} else {
							for _, c := range data.Cockpit.SecondaryConcerns {
								<li><a href={ c.URL }>{ c.Title }</a>: { c.Evidence.Summary }</li>
							}
						}
					</ul>

					<h3>Cost, last 30 days</h3>
					<ul>
						if len(data.Cockpit.Cost.Totals) == 0 {
							<li>No cost recorded</li>
						} else {
							for _, t := range data.Cockpit.Cost.Totals {
								<li>{ t.Currency } { t.CostAmount }, { t.UnpricedTokens } unpriced tokens</li>
							}
						}
					</ul>

					<a href={ "/projects/" + data.Cockpit.Project.ID + "/activity" }>Open project activity</a>
				</details>
			</div>
			<aside aria-label="Next decision">
				<h2>Next decision</h2>
				if data.Cockpit.NextDecision != nil {
					<p>{ data.Cockpit.NextDecision.Title }</p>
					<p>Accountable: { data.Cockpit.NextDecision.Accountable }</p>
					<p>{ data.Cockpit.NextDecision.Readiness }</p>
				} else {
					<p>No governed decision is ready.</p>
				}
			</aside>
		</div>
	}
}

// projectNav renders the eight-item project-local nav in the exact order
// docs/specs/032-project-cockpit.md §2 requires (Overview, Crew, Work,
// Deliverables, Reviews, Decisions, Documents, Activity), marking the item
// matching active as aria-current="page". Callers: Project always passes
// "overview" (project.html's project-nav always marked Overview current,
// unconditionally); Placeholder passes ActiveSection, one of the
// projectSections keys (never "overview"), so Overview is never marked
// there — matching the two pre-migration templates exactly.
templ projectNav(projectID, active string) {
	<ul>
		<li><a href={ "/projects/" + projectID } if active == "overview" { aria-current="page" }>Overview</a></li>
		<li><a href={ "/projects/" + projectID + "/crew" } if active == "crew" { aria-current="page" }>Crew</a></li>
		<li><a href={ "/projects/" + projectID + "#work" }>Work</a></li>
		<li><a href={ "/projects/" + projectID + "/deliverables" } if active == "deliverables" { aria-current="page" }>Deliverables</a></li>
		<li><a href={ "/projects/" + projectID + "/reviews" } if active == "reviews" { aria-current="page" }>Reviews</a></li>
		<li><a href={ "/projects/" + projectID + "/decisions" } if active == "decisions" { aria-current="page" }>Decisions</a></li>
		<li><a href={ "/projects/" + projectID + "/documents" } if active == "documents" { aria-current="page" }>Documents</a></li>
		<li><a href={ "/projects/" + projectID + "/activity" } if active == "activity" { aria-current="page" }>Activity</a></li>
	</ul>
}

// workItem renders one cockpitWorkItem as project.html's work-item template
// did: id/title link, state/status-evidence summary, then the owner/delegate
// annotations when present.
templ workItem(item cockpitWorkItem) {
	<a href={ item.URL }>{ item.ID } &mdash; { item.Title }</a>: { item.State } ({ item.StatusEvidence.Category }) &mdash; { item.StatusEvidence.Summary }
	if item.Owner != nil {
		&middot; Owned by { item.Owner.Name }
	}
	if item.Delegate != nil {
		&middot; { item.Delegate.Name } is the delegate
	}
}

// rankingFocusText renders Cockpit.RankingFocus for display, matching the
// pre-migration
// {{range .Cockpit.RankingFocus}}{{.}} {{end}}{{else}}none{{end}}
// exactly: space-separated with a trailing space, or the literal "none".
func rankingFocusText(focus []string) string {
	if len(focus) == 0 {
		return "none"
	}
	return strings.Join(focus, " ") + " "
}

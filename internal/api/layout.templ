package api

// layout.templ is the application shell every page renders through: the
// document head, skip link, primary nav, and the <main id="main-content">
// landmark each page's content fills via { children... }. Ported from
// templates/layout.html, which this replaces (see web.go's render call
// sites — each page component wraps its own content in @Page(p.basePage)).
// The self-hosted HTMX script tag at the end of <body> is dormant substrate:
// no hx-* attributes or behavior anywhere yet (that's spec 032 §11).

templ Page(p basePage) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.Title }</title>
			<link rel="stylesheet" href="/assets/app.css"/>
		</head>
		<body>
			<a class="skip-link" href="#main-content">Skip to content</a>
			<header>
				<nav aria-label="Primary">
					@primaryNav(p.ActiveGlobal)
				</nav>
			</header>
			<main id="main-content">
				{ children... }
			</main>
			<script src="/assets/htmx.min.js" defer></script>
		</body>
	</html>
}

// primaryNav renders the seven global destinations in the exact order
// docs/specs/032-project-cockpit.md §2 requires (Home, Intake, Projects,
// Work, Reviews, Deliveries, Knowledge), marking the one matching active as
// aria-current="page". Project-scoped pages pass "" — matching none of
// these — since their own local nav (see projectNav in project.templ)
// carries the current-page marker instead; every page sets
// aria-current="page" exactly once, never on both navs.
templ primaryNav(active string) {
	<a
		href="/"
		if active == "home" {
			aria-current="page"
		}
	>Home</a>
	<a
		href="/intake"
		if active == "intake" {
			aria-current="page"
		}
	>Intake</a>
	<a
		href="/projects"
		if active == "projects" {
			aria-current="page"
		}
	>Projects</a>
	<a
		href="/work"
		if active == "work" {
			aria-current="page"
		}
	>Work</a>
	<a
		href="/reviews"
		if active == "reviews" {
			aria-current="page"
		}
	>Reviews</a>
	<a
		href="/deliveries"
		if active == "deliveries" {
			aria-current="page"
		}
	>Deliveries</a>
	<a
		href="/knowledge"
		if active == "knowledge" {
			aria-current="page"
		}
	>Knowledge</a>
}

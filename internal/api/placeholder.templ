package api

// placeholder.templ renders placeholderPageData: an honest "not built yet"
// page for a global or project-scoped destination whose governing spec
// section is not implemented. Cockpit is nil for a global destination and
// set for a project section, which renders the same project-local
// navigation (projectNav, defined in project.templ) as the Overview page.
// Ported from templates/placeholder.html.

templ Placeholder(data placeholderPageData) {
	@Page(data.basePage) {
		if data.Cockpit != nil {
			<link rel="canonical" href={ data.Cockpit.CanonicalURL }/>
			<div class="cockpit-grid">
				<nav aria-label="Project" class="project-nav">
					@projectNav(data.Cockpit.Project.ID, data.ActiveSection)
				</nav>
				<div>
					<h1>{ data.Cockpit.Project.Name }: { data.Heading }</h1>
					<p>{ data.Message }</p>
				</div>
			</div>
		} else {
			<h1>{ data.Heading }</h1>
			<p>{ data.Message }</p>
		}
	}
}

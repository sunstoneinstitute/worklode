package api

// projects.templ renders projectsPageData for GET /projects: the
// cross-project portfolio, linking each project to its canonical cockpit
// URL. Ported from templates/projects.html.

templ Projects(data projectsPageData) {
	@Page(data.basePage) {
		<h1>Projects</h1>
		if len(data.Projects) == 0 {
			<p class="muted">No projects yet.</p>
		} else {
			<table>
				<tr><th>Project</th><th>Key</th></tr>
				for _, proj := range data.Projects {
					<tr><td><a href={ "/projects/" + proj.ID }>{ proj.Name }</a></td><td>{ proj.Key }</td></tr>
				}
			</table>
		}
	}
}

package ui

// deliverables.templ renders a project's Deliverables destination (GET
// /projects/{id}/deliverables): the declared outputs of the project (spec 029
// §3), grouped by the milestone each is attached to (spec 029 §2), and the
// affordance to declare another.
//
// Each row shows what is stored — id, name, description, the declared
// artifact address, and who declared it when — plus the newest state reported
// about that address. Spec 029 §3.2 makes deliverable state something emitters
// and probers report: an emitter can now report one (the catalog ingest), the
// poll prober cannot yet, so a row with no report says "Declared" instead of
// dressing a declaration up as a status.
//
// A project with no milestones (or none holding a deliverable) shows exactly
// one group — Groups' unattached entry — which renders with no subheading:
// the flat list this page has always shown. Once a second group exists, every
// group gets a heading, "No milestone" for the unattached one, so a
// declared row is never dropped off the page for lacking one.

templ Deliverables(v DeliverablesView) {
	@Page(v.Page) {
		<link rel="canonical" href={ v.CanonicalURL }/>
		@projectShell(v.Project, "deliverables") {
			<div class="canvas">
				<section class="card">
					<div class="hd">
						<h3>Deliverables</h3>
						<div class="meta">
							<a class="newlink" href={ v.NewURL }>Declare a deliverable</a>
						</div>
					</div>
					<div class="bd">
						if v.totalRows() == 0 {
							<p class="muted">
								No deliverable is declared for this project yet. A deliverable is
								what the project ships &mdash; a dataset, an analysis, a report,
								a story &mdash; and declaring one states the intent, not that it exists.
							</p>
						} else if len(v.Groups) <= 1 {
							<div class="dod">
								for _, d := range v.Groups[0].Rows {
									@deliverableRow(d)
								}
							</div>
						} else {
							for _, g := range v.Groups {
								@deliverableGroup(g)
							}
						}
					</div>
				</section>
				<p class="muted small">
					Deliverable state is reported, never declared (spec 029 §3.2). Emitters
					can report it &mdash; a data catalog files a state against the declared
					address &mdash; but the poll prober that would check an address nothing
					reports on is not built yet, so a row shows a state only once something
					has reported one.
				</p>
			</div>
		}
	}
}

// deliverableGroup renders one milestone's (or the unattached) deliverables
// as a subsection: a heading, then every row.
templ deliverableGroup(g DeliverableGroup) {
	<h4>{ g.header() }</h4>
	<div class="dod">
		for _, d := range g.Rows {
			@deliverableRow(d)
		}
	</div>
}

// deliverableRow renders one declared deliverable. The chip is the newest
// state reported about the declared address; with nothing reported it falls
// back to "Declared", the only evidence category a typed-in deliverable can
// honestly carry on its own (spec 032 §1).
templ deliverableRow(d DeliverableRow) {
	<div class="dodrow">
		<div>
			<div class="name">{ d.Name }</div>
			<div class="def mono">{ d.ID }</div>
			if d.Description != "" {
				<div class="def">{ d.Description }</div>
			}
			if d.Artifact != "" {
				<div class="def">verified by <span class="mono">{ d.Artifact }</span></div>
			}
			if d.URL != "" {
				<div class="ev"><a href={ d.URL } rel="noreferrer">{ d.URL }</a></div>
			}
		</div>
		<div class="st">
			<span class={ "chip " + deliverableChip(d.ReportedState) }>
				<span class="cd" aria-hidden="true"></span>{ deliverableLabel(d.ReportedState) }
			</span>
			if d.ReportedAt != nil {
				<div class="def">{ "reported " + fmtTime(*d.ReportedAt) }</div>
			}
			<div class="def">
				if d.CreatedBy != "" {
					{ "declared by " + d.CreatedBy + " · " + fmtTime(d.CreatedAt) }
				} else {
					{ "declared " + fmtTime(d.CreatedAt) }
				}
			</div>
		</div>
	</div>
}

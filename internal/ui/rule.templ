package ui

// rule.templ renders a design rule's cockpit page
// (docs/specs2/12-spec-refactoring-design-tree.md S8-S11, S20): the rule's
// current or a named version, the documents that arrange it, the tasks it
// governs, and its version history. Read-only, like the document corpus it
// is drawn from — a rule is edited through its arranging document, never
// on this page (S14, S35).
templ Rule(v RuleView) {
	@Page(v.Page) {
		@globalShell() {
			<section class="card pad">
				<h1>{ v.Rule.Ref }: { v.Rule.Heading }</h1>
				<p>
					<span class={ "chip " + docStatusChip(v.Rule.Status) }>{ v.Rule.Status }</span>
					<span class="chip plain">version { v.Rule.Version }</span>
					if v.Rule.Owner != "" {
						<span class="chip plain">owner { v.Rule.Owner }</span>
					}
					for _, tag := range v.Rule.Tags {
						<span class="chip plain">{ tag }</span>
					}
				</p>
			</section>
			if !v.Current {
				<section class="card pad">
					<p><strong>Viewing version { v.Rule.Version }</strong> &mdash; <a href={ v.CanonicalURL }>back to current</a></p>
				</section>
			}
			<section class="card">
				<div class="hd"><h3>Body</h3></div>
				<div class="bd prose">
					// BodyHTML is emitted unescaped for the reason Doc's Body
					// section gives: internal/mdrender has already reduced it
					// to an allowlist.
					@templ.Raw(string(v.BodyHTML))
				</div>
			</section>
			<section class="card">
				<div class="hd"><h3>Arranged in</h3></div>
				<div class="bd">
					if len(v.Arranged) == 0 {
						<p class="muted">Not arranged in any document.</p>
					} else {
						<ul>
							for _, a := range v.Arranged {
								<li>
									<a href={ templ.SafeURL(a.Href) }>{ a.DocRef }#{ a.Anchor }</a>
									<span class="muted small">{ " " }depth { a.Depth }</span>
								</li>
							}
						</ul>
					}
				</div>
			</section>
			<section class="card">
				<div class="hd"><h3>Covered by</h3></div>
				<div class="bd">
					if len(v.Rule.CoveredBy) == 0 {
						<p class="muted">No plan covers this rule.</p>
					} else {
						<ul>
							for _, p := range v.Rule.CoveredBy {
								<li>
									<a href={ templ.SafeURL("/docs/ref/" + p.DocRef) }>{ p.DocRef }</a>
									<span class="muted small">{ " " }{ p.Status } · { p.Coverage }</span>
								</li>
							}
						</ul>
					}
				</div>
			</section>
			<section class="card">
				<div class="hd"><h3>Governs</h3></div>
				<div class="bd">
					if len(v.Rule.GovernedTasks) == 0 {
						<p class="muted">No tasks.</p>
					} else {
						<ul>
							for _, t := range v.Rule.GovernedTasks {
								<li>
									<a href={ templ.SafeURL("/tasks/" + t.ID) }>{ t.ID }</a>
									{ " " }{ t.Title }{ " " }
									<span class={ "chip " + stateChip(t.State) }>{ stateLabel(t.State) }</span>
									<span class="muted small">{ " " }{ t.Source } · v{ t.RuleVersion }</span>
								</li>
							}
						</ul>
					}
				</div>
			</section>
			<section class="card">
				<div class="hd"><h3>Edges</h3></div>
				<div class="bd">
					if len(v.Rule.Edges) == 0 {
						<p class="muted">No edges.</p>
					} else {
						<ul>
							for _, e := range v.Rule.Edges {
								<li>
									if e.From == v.Rule.Ref {
										<span class="mono">{ e.Type }</span>{ " " }
										<a href={ templ.SafeURL("/rules/" + e.To) }>{ e.To }</a>{ " " }{ e.ToHeading }
									} else {
										<a href={ templ.SafeURL("/rules/" + e.From) }>{ e.From }</a>{ " " }{ e.FromHeading }{ " " }
										<span class="mono">{ e.Type }</span>{ " this" }
									}
									<span class="muted small">{ " " }{ e.Source }</span>
								</li>
							}
						</ul>
					}
				</div>
			</section>
			if len(v.Versions) > 0 {
				<section class="card">
					<div class="hd"><h3>Versions</h3></div>
					<div class="bd">
						@tableWrap("Versions") {
							<table>
								<tr><th>Version</th><th>Heading</th><th>Created</th></tr>
								for _, ver := range v.Versions {
									<tr>
										<td class="mono"><a href={ ruleVersionURL(v.CanonicalURL, ver.Version) }>{ ver.Version }</a></td>
										<td><a href={ ruleVersionURL(v.CanonicalURL, ver.Version) }>{ ver.Heading }</a></td>
										<td class="mono">{ fmtTime(ver.CreatedAt) }</td>
									</tr>
								}
							</table>
						}
					</div>
				</section>
			}
		}
	}
}

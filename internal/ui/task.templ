package ui

import (
	"strconv"
	"strings"
)

// task.templ renders one task's detail page (GET /tasks/{id}): identity,
// state/priority/kind and project link, then the body, then collapsed
// sections for prerequisites, agent sessions, activity, attachments, edges
// and the full timeline.
//
// The body is the page's one piece of untrusted markup (spec 021 §8): it
// arrives as v.BodyHTML, already rendered and sanitised by internal/mdrender
// at the api boundary, and is the only value emitted raw. Everything else,
// row.URL (TimelineRow.URL) included, is rendered as a plain string href, so
// templ's SafeURL sanitizer neutralizes an unsafe scheme into
// "about:invalid#TemplFailedSanitizationURL" before it reaches the page (see
// web_test.go's TestTaskPageEscapesHostileTimelineURL).
//
// It renders through projectShell — the same frame crew.templ and every
// other project-scoped page use (spec 056 §2) — with local-nav active ""
// since the task page is not itself one of the sidebar's destinations;
// PageProps.ActiveGlobal stays unset too, so the page carries both nav
// landmarks but marks neither current (web_test.go's assertNoAriaCurrent).

templ Task(v TaskView) {
	@Page(v.Page) {
		@projectShell(v.Project, "") {
			<div class="canvas">
				<section class="card pad">
					<h1>{ v.Task.ID }: { v.Task.Title }</h1>
					<p>
						if v.Blocked {
							<span class="chip crit">blocked</span>
						} else {
							<span class={ "chip " + stateChip(v.Task.State) }>{ v.Task.State }</span>
						}
						<span class="chip plain">{ v.Task.Priority }</span>
						<span class="chip plain">{ v.Task.Kind }</span>
						<span class="muted">&nbsp;project: <a href={ "/projects/" + v.Task.Project }>{ v.Task.Project }</a></span>
						if v.Task.Milestone != "" {
							<span class="muted">&nbsp;milestone: <a href={ "/projects/" + v.Task.Project + "/milestones" }>{ v.Task.Milestone }</a></span>
						}
					</p>
					<p class="muted small">Created { fmtTime(v.Task.CreatedAt) } by { v.Task.CreatedBy } &mdash; updated { fmtTime(v.Task.UpdatedAt) }</p>
					if v.Task.Assignee != "" {
						<p class="muted small">Assigned to { v.Task.Assignee }</p>
					}
					if v.Holder != nil {
						<p><strong>Held by:</strong> { v.Holder.ActorID } (expires { fmtTime(v.Holder.ExpiresAt) })</p>
					}
				</section>

				<section class="card" aria-labelledby="body-heading">
					<div class="hd"><h3 id="body-heading">Body</h3></div>
					// BodyHTML is the one value this package emits unescaped. What
					// makes that safe is internal/mdrender: the untrusted body is
					// rendered permissively, then the OUTPUT HTML is reduced to an
					// allowlist, so no element, attribute or URL scheme reaches
					// this div that the sanitiser did not pass.
					<div class="bd prose">
						@templ.Raw(string(v.BodyHTML))
					</div>
					if hasMermaid(v.BodyHTML) {
						@mermaidScripts()
					}
				</section>

				// Every section after the body is a native <details>, collapsed
				// by default, so the body renders near the top of the page.
				if v.Prerequisites != nil {
					@taskPrerequisites(v)
				}

				if len(v.AgentSessions) > 0 {
					<details class="card" aria-labelledby="agent-sessions-heading">
						<summary class="hd"><h3 id="agent-sessions-heading">Agent sessions ({ strconv.Itoa(len(v.AgentSessions)) })</h3></summary>
						@agentSessionRows(v.AgentSessions)
					</details>
				}

				// The Activity card (spec 071 §4). It is omitted outright when
				// the task has neither rows nor an open session, rather than
				// standing empty over a task no agent ever worked or whose
				// lease outlived its session. A held task with no rows yet
				// keeps the card: the open session is a fact worth showing,
				// and the empty list is where the stream prepends. Its summary
				// carries no count, since the stream adds rows after render.
				if len(v.Activity) > 0 || hasRunningSession(v.AgentSessions) {
					<details class="card" id="activity" aria-labelledby="activity-heading" data-task={ v.Task.ID }>
						<summary class="hd"><h3 id="activity-heading">Activity</h3></summary>
						<div class="bd">
							<ol class="activity">
								for _, r := range v.Activity {
									@activityRow(r)
								}
							</ol>
							if len(v.Activity) == 0 {
								<p class="activity-empty muted">No activity recorded yet.</p>
							}
						</div>
					</details>
				}

				if len(v.Attachments) > 0 {
					<details class="card" aria-labelledby="attachments-heading">
						<summary class="hd"><h3 id="attachments-heading">Attachments ({ strconv.Itoa(len(v.Attachments)) })</h3></summary>
						<div class="bd">
							<ul class="attachments">
								for _, b := range v.Attachments {
									<li>
										if b.Filename != "" {
											<a href={ b.URL }>{ b.Filename }</a>
										} else {
											<a href={ b.URL } class="mono">{ b.Hash }</a>
										}
										<span class="meta">{ b.MediaType } &middot; { fmtBytes(b.Size) }</span>
									</li>
								}
							</ul>
						</div>
					</details>
				}

				<details class="card" aria-labelledby="edges-heading">
					<summary class="hd"><h3 id="edges-heading">Edges</h3></summary>
					<div class="bd">
						<ul>
							@taskEdgeIDs("Blocks", v.Blocks)
							@taskEdgeIDs("Blocked by", v.BlockedBy)
							@taskEdgeID("Parent", v.Parent)
							<li>Children:
								if len(v.Children) == 0 {
									<span class="muted">none</span>
								} else {
									for _, id := range v.Children {
										<a href={ "/tasks/" + id }>{ id }</a>{ " " }
									}
									<span class="muted">({ v.Progress.Closed }/{ v.Progress.Total } closed)</span>
								}
							</li>
							@taskEdgeID("Follow-up to", v.FollowUpTo)
							@taskEdgeIDs("Follow-ups", v.FollowUps)
							@taskEdgeID("Duplicate of", v.DuplicateOf)
							@taskEdgeIDs("Duplicates", v.Duplicates)
						</ul>
					</div>
				</details>

				<details class="card" aria-labelledby="timeline-heading">
					<summary class="hd"><h3 id="timeline-heading">Timeline ({ strconv.Itoa(len(v.Timeline)) })</h3></summary>
					<div class="bd">
						if len(v.Timeline) == 0 {
							<p class="muted">No timeline entries yet.</p>
						} else {
							@tableWrap("Timeline") {
								<table>
									<tr><th>When</th><th>Type</th><th>Summary</th><th>Source</th></tr>
									for _, row := range v.Timeline {
										<tr>
											<td class="mono">{ fmtTime(row.At) }</td>
											<td>@timelineIcon(row)</td>
											<td>
												{ row.Summary }
												if row.Detail != "" {
													<details class="tl-detail">
														<summary>see more</summary>
														<pre>{ row.Detail }</pre>
													</details>
												}
											</td>
											<td>
												if row.URL != "" {
													<a href={ row.URL } rel="noreferrer">Open source</a>
												}
											</td>
										</tr>
									}
								</table>
							}
						}
					</div>
				</details>
			</div>
			<script src={ assetURL("activity.js") } defer></script>
		}
	}
}

// activityRow renders one activity row. data-id is the store id: the stream's
// cursor, and what lets the page tell a row it already has from a new one.
// The session is abbreviated to what distinguishes it, with the whole id kept
// as the title.
templ activityRow(r ActivityRow) {
	<li data-id={ strconv.FormatInt(r.ID, 10) }>
		<span class="at mono">{ fmtTime(r.At) }</span>
		<span class="ev">{ r.Event }</span>
		if r.Summary != "" {
			<span class="sum">{ r.Summary }</span>
		}
		if r.Session != "" {
			<span class="sess mono" title={ r.Session }>{ shortSession(r.Session) }</span>
		}
	</li>
}

// ActivityRowFragment is one row rendered on its own: the data of a frame on
// GET /tasks/{id}/activity/events (§4). The stream sends the same markup the
// page draws, so an inserted row can never disagree with a reloaded one.
templ ActivityRowFragment(r ActivityRow) {
	@activityRow(r)
}

// taskEdgeIDs renders one labelled edge row as a link per related task id, or
// an honest "none" when the edge has no other end. The Children row stays
// inline in Task above: it is the one row that renders more than the links (a
// closed/total counter), and a { children... } slot here would emit a stray
// whitespace node into every row that passes none.
templ taskEdgeIDs(label string, ids []string) {
	<li>
		{ label }:
		if len(ids) == 0 {
			<span class="muted">none</span>
		} else {
			for _, id := range ids {
				<a href={ "/tasks/" + id }>{ id }</a>{ " " }
			}
		}
	</li>
}

// taskEdgeID renders one labelled edge row that holds at most one task id
// (Parent, Follow-up to, Duplicate of), or an honest "none" when it is unset.
templ taskEdgeID(label, id string) {
	<li>
		{ label }:
		if id == "" {
			<span class="muted">none</span>
		} else {
			<a href={ "/tasks/" + id }>{ id }</a>
		}
	</li>
}

// timelineIcon renders one Timeline row's type as a compact icon instead of
// its text label (WL-298), so the "Type" column stops eating horizontal
// space on narrow/mobile widths. row.Label stays the accessible name — it is
// both the native title tooltip (desktop hover) and the aria-label (screen
// readers and touch, where a title alone is not reliably exposed) — so
// nobody loses information the old text cell gave them; role="img" makes the
// wrapper's aria-label the thing assistive tech announces instead of trying
// to describe the SVG. The glyphs are hand-drawn to match this file's
// existing 24x24, stroke=currentColor line-icon convention (see
// internal/ui/cockpit.templ, internal/ui/layout.templ) rather than
// vendoring Google's Material Symbols font/glyph set, which would introduce
// a second icon convention and (for the font path) an external request this
// self-contained, CSP-friendly UI does not otherwise make.
templ timelineIcon(row TimelineRow) {
	<span class="ticon" role="img" title={ row.Label } aria-label={ row.Label }>
		switch row.Type {
		case "state":
			// sync/transition arrows: a state change.
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h12l-3-3"></path><path d="M20 17H8l3 3"></path></svg>
		case "pr":
			// branch-with-circles: a pull request.
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="2.2"></circle><circle cx="6" cy="18" r="2.2"></circle><circle cx="18" cy="6" r="2.2"></circle><path d="M6 8.2V15.8"></path><path d="M18 8.2v3.3a4 4 0 0 1-4 4h-2.3"></path><path d="M14.5 12.6l3 3 3-3"></path></svg>
		case "ci":
			// check in a ring: a CI run.
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.5 2.5L16 9.5"></path></svg>
		case "review":
			// an eye: a human review.
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 12S6 5 12 5s9.5 7 9.5 7-3.5 7-9.5 7S2.5 12 2.5 12z"></path><circle cx="12" cy="12" r="3"></circle></svg>
		case "artifact":
			// a package: a built artifact.
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7l9-4 9 4-9 4-9-4z"></path><path d="M3 7v10l9 4 9-4V7"></path><path d="M12 11v10"></path></svg>
		case "deployment":
			// a rocket: a deployment.
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2c3 3 4 6 4 9 0 3-1.5 5-4 7-2.5-2-4-4-4-7 0-3 1-6 4-9z"></path><path d="M9 16l-3 5M15 16l3 5"></path><circle cx="12" cy="9.5" r="1.6"></circle></svg>
		case "runtime":
			// a warning triangle: a runtime/crash event.
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.3 3.3a2 2 0 0 1 3.4 0l8.2 14a2 2 0 0 1-1.7 3H3.8a2 2 0 0 1-1.7-3z"></path><path d="M12 9v4.5M12 17v.5"></path></svg>
		case "landed":
			// branch merging into one: the PR landed on main.
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="2.2"></circle><circle cx="6" cy="18" r="2.2"></circle><circle cx="18" cy="12" r="2.2"></circle><path d="M6 8.2V15.8"></path><path d="M6 12h6a4 4 0 0 0 4-4"></path></svg>
		case "deployed":
			// a delivery truck: confirmed delivered to an environment.
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 13V7h9v6"></path><path d="M12 10h4l3 3v3"></path><path d="M3 13h16v4H3z"></path><circle cx="7.5" cy="18.5" r="1.4"></circle><circle cx="16" cy="18.5" r="1.4"></circle></svg>
		case "released":
			// a price tag: a released version.
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 21 11l-9.5 9.5a2 2 0 0 1-2.8 0L3 14.8a2 2 0 0 1 0-2.8z"></path><circle cx="15.5" cy="7.5" r="1.5"></circle></svg>
		default:
			// a plain circle: an event type this file does not otherwise
			// know how to draw (kept honest rather than silently blank).
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle></svg>
		}
	</span>
}

// taskPrerequisites renders the prerequisite tree (WL-877, WL-902): a
// summary, the plans ordered first, the task with its direct prerequisites
// below it, and a full-title list. Each level below that opens on demand: a
// card with prerequisites of its own is a nested <details>, so expanding it
// shows its next level only, with no script.
templ taskPrerequisites(v TaskView) {
	{{ p := v.Prerequisites }}
	<details class="card" id="prerequisites" aria-labelledby="prerequisites-heading">
		<summary class="hd"><h3 id="prerequisites-heading">Prerequisites ({ strconv.Itoa(p.Remaining) })</h3></summary>
		<div class="bd pq">
			<p class="pq-summary">
				<strong>{ strconv.Itoa(p.Remaining) }</strong> open prerequisite task{ pluralSuffix(p.Remaining) },
				<strong>{ strconv.Itoa(p.Direct) }</strong> direct.
				if len(p.Candidates) > 0 {
					Candidates to start next:
					for i, id := range p.Candidates {
						if i > 0 {
							{ ", " }
						}
						<a href={ "/tasks/" + id }>{ id }</a>
					}
					<span class="muted">(no open prerequisite task of their own; a plan gate or a lease can still hold them)</span>
				}
			</p>
			if len(p.Cycle) > 0 {
				<p class="pq-warn" role="note">
					Cycle: the prerequisites loop back through { strings.Join(p.Cycle, ", ") }. No task on the loop can finish first, so the frontier above is incomplete. The edge that closes the loop shows as a reference marked cycle.
				</p>
			}
			if p.Hidden > 0 {
				<p class="pq-warn" role="note">
					The tree shows the { strconv.Itoa(p.Remaining-p.Hidden) } nearest prerequisites; { strconv.Itoa(p.Hidden) } more are in the list below.
				</p>
			}
			if len(p.Plans) > 0 {
				<h4>Plans ordered first</h4>
				<ul class="pq-plans">
					for _, pl := range p.Plans {
						<li><a href={ pl.URL }>{ pl.Slug }</a> { pl.Title } <span class={ "chip " + docStatusChip(pl.Status) }>{ pl.Status }</span></li>
					}
				</ul>
			}
			if len(p.Tree) > 0 {
				<div class="pq-tree">
					<div class="pq-node pq-target" id={ "pq-" + v.Task.ID }>
						@prereqCard(PrerequisiteNode{ID: v.Task.ID, Title: v.Task.Title, State: "this task", Levels: p.Levels, Below: p.Below})
					</div>
					@prereqLevel(p.Tree)
				</div>
				<details class="pq-all">
					<summary>All { strconv.Itoa(p.Remaining) } prerequisites, nearest first</summary>
					<ol class="pq-list">
						for _, c := range p.List {
							<li>
								<a href={ "/tasks/" + c.ID }>{ c.ID }</a> { c.Title }
								<span class={ "chip " + stateChip(c.State) }>{ c.State }</span>
								if c.Cycle {
									<span class="chip crit">cycle</span>
								}
								<span class="muted small">needed by { strings.Join(c.NeededBy, ", ") }</span>
							</li>
						}
					</ol>
				</details>
			}
		</div>
	</details>
}

// prereqLevel renders one level of the tree as a wrapping row of cards.
templ prereqLevel(nodes []PrerequisiteNode) {
	<ul class="pq-level">
		for _, n := range nodes {
			<li class="pq-item">
				@prereqNode(n)
			</li>
		}
	</ul>
}

// prereqNode renders one occurrence of a task: a reference to the card drawn
// in full elsewhere, a card that opens onto its next level, or a leaf card.
templ prereqNode(n PrerequisiteNode) {
	if n.Ref {
		<a class={ "pq-ref", templ.KV("cycle", n.Cycle) } href={ "#pq-" + n.ID } title={ n.ID + ": " + n.Title }>
			<span aria-hidden="true">&#8618;</span> { n.ID }
			if n.Cycle {
				<span class="chip crit">cycle</span>
			} else {
				<span class="muted">shown above</span>
			}
		</a>
	} else if len(n.Children) > 0 {
		<details class="pq-node" id={ "pq-" + n.ID }>
			<summary>
				@prereqCard(n)
			</summary>
			@prereqLevel(n.Children)
		</details>
	} else {
		<div class="pq-node" id={ "pq-" + n.ID }>
			@prereqCard(n)
		</div>
	}
}

// prereqCard is a task's card body: linked id, title, state, and how much
// sits beneath it.
templ prereqCard(n PrerequisiteNode) {
	<span class="pq-card">
		<span class="pq-head"><a href={ "/tasks/" + n.ID }>{ n.ID }</a> <span class={ "chip " + stateChip(n.State) }>{ n.State }</span></span>
		<span class="pq-title">{ n.Title }</span>
		if n.Levels > 0 {
			<span class="pq-depth">{ prereqDepth(n.Levels, n.Below) }</span>
		}
	</span>
}

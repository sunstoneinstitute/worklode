package ui

// milestones.templ renders a project's Milestones destination (GET
// /projects/{id}/milestones): every milestone in the project as a section,
// in position order, with the tasks and deliverables its progress was
// derived from (spec 029 §2, spec 032 §10).
//
// One page carries list and detail. A research project holds a handful of
// milestones, so a per-milestone page would be chrome without a reader.
//
// Progress is plain counts. Spec 029 §2 derives it as a query over the
// children — two small integers per kind — and a percentage or a bar would
// claim a precision those integers do not carry.

templ Milestones(v MilestonesView) {
	@Page(v.Page) {
		<link rel="canonical" href={ v.CanonicalURL }/>
		@projectShell(v.Project, "milestones") {
			<div class="canvas">
				if len(v.Milestones) == 0 {
					<section class="card">
						<div class="hd">
							<h3>Milestones</h3>
						</div>
						<div class="bd">
							<p class="muted">
								No milestones yet. A milestone is an ordered container in this
								project (spec 029 §2), holding the work and the deliverables
								that belong to one step of it.
							</p>
						</div>
					</section>
				} else {
					for _, m := range v.Milestones {
						@milestoneSection(m)
					}
				}
			</div>
		}
	}
}

// milestoneSection renders one milestone: its id and title, the derived
// progress line, and the children the progress was counted from. A milestone
// with nothing attached says so rather than rendering two empty containers.
templ milestoneSection(m MilestoneSection) {
	<section class="card">
		<div class="hd">
			<h3><span class="mono">{ m.ID }</span> &mdash; { m.Title }</h3>
		</div>
		<div class="bd">
			<p class="muted small">{ m.progress() }</p>
			if !m.hasChildren() {
				<p class="muted">Nothing is attached to this milestone yet.</p>
			} else {
				if len(m.Tasks) > 0 {
					@tableWrap(m.Title + " tasks") {
						<table>
							<tr><th>Task</th><th>Title</th><th>State</th><th>Assignee</th></tr>
							for _, t := range m.Tasks {
								<tr>
									<td><a href={ "/tasks/" + t.ID }>{ t.ID }</a></td>
									<td>{ t.Title }</td>
									<td><span class={ "chip " + stateChip(t.State) }>{ stateLabel(t.State) }</span></td>
									<td>
										if t.Assignee != "" {
											{ t.Assignee }
										} else {
											<span class="muted">unassigned</span>
										}
									</td>
								</tr>
							}
						</table>
					}
				}
				if len(m.Deliverables) > 0 {
					<div class="dod">
						for _, d := range m.Deliverables {
							@deliverableRow(d)
						}
					</div>
				}
			}
			@milestoneRefs(m)
		</div>
	</section>
}

// milestoneRefs renders the milestone's deliverable references (spec 029 §5)
// and the affordance to declare another. A reference is the one edge allowed
// to cross a project boundary, so each row shows the deliverable id whole —
// its project key is what makes a cross-project origin visible — and links
// to the origin project's Deliverables page. The state is the deliverable's
// own reported state, chipped exactly as the Deliverables page chips it.
//
// The deliverable is typed rather than picked: a menu here would have to
// list every deliverable on the instance to be useful, which is more than
// this project's page is entitled to show.
templ milestoneRefs(m MilestoneSection) {
	<h4>References</h4>
	<div aria-live="polite">
		if m.AddError != "" {
			<p class="formerr" role="alert">{ m.AddError }</p>
		}
	</div>
	if len(m.References) == 0 {
		<p class="muted">No deliverable references.</p>
	} else {
		@tableWrap(m.Title + " references") {
			<table>
				<tr><th>Deliverable</th><th>Name</th><th>State</th></tr>
				for _, r := range m.References {
					<tr>
						<td><a href={ r.DeliverablesURL() }>{ r.ID }</a></td>
						<td>{ r.Name }</td>
						<td><span class={ "chip " + deliverableChip(r.State) }>{ deliverableLabel(r.State) }</span></td>
					</tr>
				}
			</table>
		}
	}
	<form method="post" action={ m.AddAction }>
		<p class="fieldrow">
			<label for={ "ref-" + m.ID }>Deliverable id</label>
			<input id={ "ref-" + m.ID } name="deliverable" type="text" required maxlength="200" value={ m.AddValue }/>
			<span class="hint">A deliverable this milestone depends on, in this project or another (for example COW-DEL-3).</span>
		</p>
		<div class="btnrow">
			<button type="submit" class="btn">Add reference</button>
		</div>
	</form>
}

package ui

import "strconv"

// approvals.templ renders the Reviews destination (GET /reviews): the
// awaiting-approvals queue (spec 029 §7.1), one row per approval still in
// state 'awaiting', oldest first, each with the decide form (029 §7.3). A row
// links to whatever it governs — a pull request jumps out to GitHub, which
// stays the review surface for one; every other kind links to its cockpit
// page — and names the kind, so the queue does not ask a reviewer to infer it
// from the URL. The project name and task id stay in-app links. A row whose
// approval names no revision says so in place of the decide form: the store
// refuses that decide, so the page does not offer it. An empty queue states
// that honestly rather than showing a fabricated record.
//
// It also renders the approval detail page (GET /approvals/{id}, 032 §7):
// see ApprovalDetail's own doc comment below.

templ Approvals(v ApprovalsView) {
	@Page(v.Page) {
		@globalShell() {
			<h1>Reviews</h1>
			if len(v.Rows) == 0 {
				<p class="muted">No approvals are waiting.</p>
			} else {
				<ul class="approvalq">
					for _, row := range v.Rows {
						@approvalRow(row)
					}
				</ul>
			}
		}
	}
}

// approvalRow renders one queue row. rel="noreferrer" on the entity link
// matches the task page's own jump-out convention for an external source
// link. Every line-two part is conditional: only a PR-kind row has a task,
// and only a row answering a named lane (029 §7.2) has one to show.
templ approvalRow(row ApprovalRow) {
	<li>
		<div>
			if row.Kind != "" {
				<span class="mono muted">{ row.Kind }</span>
				{ " " }
			}
			<a href={ row.URL } rel="noreferrer">{ row.Title }</a>
			{ " " }
			<span class="mono muted">{ row.EntityID }</span>
		</div>
		<div class="muted small">
			if row.ProjectID != "" {
				<a href={ "/projects/" + row.ProjectID }>{ row.ProjectName }</a>
				{ " · " }
			}
			if row.TaskID != "" {
				<a href={ "/tasks/" + row.TaskID }>{ row.TaskID }</a>
				{ " · " }
			}
			if row.Revision != "" {
				{ "version " + row.Revision }
				{ " · " }
			}
			if row.Lane != "" {
				<span class="mono">{ row.Lane }</span>
				{ " · " }
			}
			if row.RequiredActorName != "" {
				{ "awaiting " + row.RequiredActorName }
				{ " · " }
			}
			{ row.Age }
		</div>
		if row.Decidable {
			<form method="post" action={ "/approvals/" + strconv.FormatInt(row.ID, 10) + "/decide" } class="decide">
				// A row rendered outside the queue says where deciding it should
				// land; the queue itself leaves this empty and keeps the default.
				if row.ReturnURL != "" {
					<input type="hidden" name="return" value={ row.ReturnURL }/>
				}
				<button type="submit" name="decision" value="approve" class="btn primary">Approve</button>
				<button type="submit" name="decision" value="request_changes" class="btn">Request changes</button>
				<button type="submit" name="decision" value="reject" class="btn ghost">Reject</button>
			</form>
		} else {
			<p class="muted">No revision designated for review yet.</p>
		}
	</li>
}

// impactActs renders the two acts an open impact review offers (029 §7.1):
// the dependent owner writes down what the upstream change means for their
// entity, and a prior approver then says whether their own approval still
// holds. The buttons post the ordinary decide values — the question they
// answer is the impact one, so they are labelled for it rather than for the
// generic approve/request-changes pair.
templ impactActs(id int64) {
	<form method="post" action={ "/approvals/" + strconv.FormatInt(id, 10) + "/note" } class="decide">
		<label for="impact-note">What does the upstream change mean here?</label>
		<textarea id="impact-note" name="note" rows="3"></textarea>
		<button type="submit" class="btn">Save note</button>
	</form>
	<form method="post" action={ "/approvals/" + strconv.FormatInt(id, 10) + "/decide" } class="decide">
		<input type="hidden" name="return" value={ "/approvals/" + strconv.FormatInt(id, 10) }/>
		<button type="submit" name="decision" value="approve" class="btn primary">Confirm decision holds</button>
		<button type="submit" name="decision" value="request_changes" class="btn">Reopen</button>
	</form>
}

// ApprovalDetail renders GET /approvals/{id} (032 §7), the tracer for the
// review-graph presentation surface: one approval, the entity it governs,
// its full decision history, and the review-graph references its own
// designation recorded. Read-mostly: the only acts it offers are an open
// impact review's note and decision, and the self-review exception on a row
// whose policy permits one.
//
// It renders in the global shell with PageProps.ActiveGlobal left empty:
// none of the five bar destinations names this page, so the bar marks
// nothing (like Reviews, Home, and the task page). The page's one
// aria-current="page" sits on the history row whose id matches the page's
// own — an ordinary use of the attribute, since every history row links to
// its own /approvals/{id} page and exactly one of them is the page the
// browser is on.
templ ApprovalDetail(v ApprovalDetailView) {
	@Page(v.Page) {
		@globalShell() {
			<section class="card pad">
				<h1>
					if v.Kind != "" {
						<span class="mono muted">{ v.Kind }</span>
						{ " " }
					}
					{ v.EntityID }
				</h1>
				<p>
					<span class={ "chip " + approvalStateChip(v.State) }>{ v.State }</span>
					{ " " }
					<span class="muted">revision <span class="mono">{ v.Revision }</span></span>
				</p>
				if v.URL != "" {
					<p>
						<a href={ v.URL } rel="noreferrer">
							if v.Title != "" {
								{ v.Title }
							} else {
								{ v.EntityID }
							}
						</a>
					</p>
				} else {
					<p class="muted">No linked record for this entity yet.</p>
				}
				<p class="muted small">
					if v.DecidedBy != "" {
						{ "decided by " + v.DecidedBy }
						if v.DecidedAt != nil {
							{ " · " + fmtTime(*v.DecidedAt) }
						}
					} else {
						Not yet decided.
					}
				</p>
				if v.CompareURL != "" {
					<p><a href={ v.CompareURL } rel="noreferrer">Compare with previous revision</a></p>
				}
				if v.Note != "" {
					<p><strong>Impact note:</strong> { v.Note }</p>
				}
				if v.ExceptionAuthorizedBy != "" {
					if v.ExceptionFlow != "" {
						<p><strong>Self-review permitted by flow</strong> <span class="mono">{ v.ExceptionFlow }</span></p>
					}
					<p><strong>Self-review exception authorized by:</strong> { v.ExceptionAuthorizedBy }</p>
				}
				if v.CanAuthorizeException {
					<form method="post" action={ "/approvals/" + strconv.FormatInt(v.ID, 10) + "/exception" } class="decide">
						<button type="submit" class="btn">Authorize self-review exception</button>
					</form>
				}
				if v.ImpactOpen {
					@impactActs(v.ID)
				}
			</section>

			<section class="card" aria-labelledby="approval-history-heading">
				<div class="hd"><h3 id="approval-history-heading">Decision history</h3></div>
				<div class="bd">
					<ul class="approvalq">
						for _, row := range v.History {
							<li>
								<div>
									<a
										href={ "/approvals/" + strconv.FormatInt(row.ID, 10) }
										if row.Current {
											aria-current="page"
										}
									>
										<span class="mono">{ row.Revision }</span>
										{ " " }
										<span class={ "chip " + approvalStateChip(row.State) }>{ row.State }</span>
									</a>
									if row.DecidedBy != "" {
										<span class="muted small">
											{ " decided by " + row.DecidedBy }
											if row.DecidedAt != nil {
												{ " · " + fmtTime(*row.DecidedAt) }
											}
										</span>
									}
								</div>
							</li>
						}
					</ul>
				</div>
			</section>

			<section class="card" aria-labelledby="governed-refs-heading">
				<div class="hd"><h3 id="governed-refs-heading">Governed references</h3></div>
				<div class="bd">
					if len(v.Governed) == 0 {
						<p class="muted">None recorded.</p>
					} else {
						<ul>
							for _, g := range v.Governed {
								<li class="mono">{ g.Kind + " " + g.ID + " @ " + g.Revision }</li>
							}
						</ul>
					}
				</div>
			</section>
		}
	}
}

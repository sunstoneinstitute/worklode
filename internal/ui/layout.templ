package ui

// layout.templ is the application shell every page renders through: the
// document head, skip link, the sticky top bar — brand link, global
// navigation, inbox icon, theme toggle and avatar, one row (spec 056 §1) —
// and the .shell each page's content fills via { children... }. Global pages
// have one content column; project pages add a left sidebar for
// project-local navigation. Both put the page's one <main id="main-content">
// landmark after every nav landmark, so "Skip to content" bypasses them all
// (WCAG 2.4.1). Styled with the prototype design system (see
// internal/ui/styles/app.tailwind.css): .topbar, nav.global, .shell,
// .top-right/.iconbtn/.avatar. The self-hosted HTMX script tag is dormant
// substrate (no hx-* behavior yet; spec 032 §11); the inline theme script
// toggles data-theme on <html>, honoring the OS colour-scheme on first click.
//
// The inbox icon (spec 056 §4) links to /inbox on every page and carries a
// small alert-toned dot when inboxDot(ctx) is true. ctx is a templ-provided
// implicit, not a Go parameter of Page: renderWeb (internal/api/webform.go)
// computes the has-items flag once per request, before rendering, and
// carries it through the same context.Context Render already threads to
// every nested component (internal/ui/context.go).
//
// Below 880px the top bar wraps: brand and controls keep the first row and
// nav.global takes a full-width row beneath them, so the narrow behaviour 032
// §10 requires carries over in its new position. nav.global and nav.local stay
// the exact same landmark elements (never duplicated — the aria-current
// invariant is "never two for the whole document", and zero on a page that is
// not a destination). The nav row keeps its three primary destinations and a
// "More" button; the two secondary ones (Intake, Knowledge) expand below it.
// nav.local becomes a project drawer. Flex `order` keeps spec 056 §1's DOM
// order while grouping the menu.
// nav.local hides entirely below 880px and reappears as a full sheet when the
// project header's menu button opens it. Both toggles, plus the shared
// backdrop, are wired by /assets/nav.js; open/closed state lives in one
// attribute, body[data-open-panel="more"|"drawer"].

// htmxConfig is the <meta name="htmx-config"> payload HTMX merges into its
// defaults before it does anything else. It exists for one setting:
// includeIndicatorStyles defaults to true, which makes HTMX inject an
// unnonced <style> element into the head on every page load — the reason the
// page CSP used to need style-src 'unsafe-inline' (WL-227). No page uses the
// htmx-indicator class, so the rules it injects are dead weight anyway. If a
// future page wants them, restore them in app.tailwind.css rather than
// re-enabling the injection.
const htmxConfig = `{"includeIndicatorStyles":false}`

templ Page(p PageProps) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.Title }</title>
			<meta name="htmx-config" content={ htmxConfig }/>
			<link rel="icon" type="image/svg+xml" href={ assetURL("logo.svg") }/>
			<link rel="stylesheet" href={ assetURL("app.css") }/>
		</head>
		<body>
			<a class="skip-link" href="#main-content">Skip to content</a>
			<header class="topbar">
				<a class="brand" href="/">
					<span class="mark">
						<img src={ assetURL("logo.svg") } alt=""/>
					</span>
					worklode
				</a>
				@primaryNav(p.ActiveGlobal)
				<div class="top-right">
					<a href="/inbox" class="iconbtn" aria-label="Inbox">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 4.5 1.5 6 2 6.5H4c.5-.5 2-2 2-6.5Z"></path><path d="M9.5 18.5a2.5 2.5 0 0 0 5 0"></path></svg>
						if inboxDot(ctx) {
							<span class="dot dot-alert"></span>
						}
					</a>
					<button id="theme" type="button" class="iconbtn" aria-label="Toggle colour theme">
						<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path></svg>
					</button>
					<div class="avatar" aria-hidden="true">SB</div>
				</div>
			</header>
			{ children... }
			<div class="sheet-backdrop" aria-hidden="true"></div>
			<script src={ assetURL("theme.js") } defer></script>
			<script src={ assetURL("nav.js") } defer></script>
			<script src={ assetURL("mdinput.js") } defer></script>
			<script src={ assetURL("htmx.min.js") } defer></script>
		</body>
	</html>
}

// mermaidScripts loads mermaid.js and starts it, for the two pages that
// render a body through mdrender (task.templ, docs.templ) rather than every
// page: at 3.5MB, layout.templ's shared footer is the wrong place for it.
// Both scripts are deferred, so document order relative to each other is what
// makes mermaid-init.js see window.mermaid already set.
templ mermaidScripts() {
	<script src={ assetURL("mermaid.min.js") } defer></script>
	<script src={ assetURL("mermaid-init.js") } defer></script>
}

// tableWrap is the scroll container every data table on a page renders inside.
// A table is the one thing WCAG 1.4.10 exempts from reflow — it needs two
// dimensions to mean anything — so at 320px it scrolls horizontally inside
// this container instead of widening the page, which is what the four tables
// in this package used to do. tabindex="0" is what makes that scrolling
// reachable from the keyboard (2.1.1) in browsers that do not focus scroll
// containers on their own, and the label is what a screen reader announces on
// arriving in the region it thereby becomes.
templ tableWrap(label string) {
	<div class="tablewrap" role="region" aria-label={ label } tabindex="0">
		{ children... }
	</div>
}

// navLink renders one nav anchor — project-local — marking it current when
// key matches active. The label is emitted tight against the tags
// (>{label}<) so every destination keeps its exact >Name< text marker.
templ navLink(href, label, key, active string) {
	<a
		href={ href }
		if key == active {
			class="active"
			aria-current="page"
		}
	>{ label }</a>
}

// globalLink renders one icon-and-label global-nav anchor, tiered "primary"
// (one of the three links shown below 880px) or "secondary" (tucked under the
// "More" control at that width — see layout.templ's header comment). The tier
// class and the conditional "active" class must go through one templ.KV-joined class
// expression, not two separate `class` attributes (unlike navLink, which
// only ever has one) — two literal class="..." attributes is invalid HTML,
// and the browser keeps only the first, silently dropping "active".
templ globalLink(href, label, key, active, tier string) {
	<a
		href={ href }
		class={ "tab-" + tier, templ.KV("active", key == active) }
		if key == active {
			aria-current="page"
		}
	>
		<span class="navicon" aria-hidden="true">
			@globalIcon(key)
		</span>
		<span class="tab-label">{ label }</span>
	</a>
}

// globalIcon is the line-style icon (24x24, stroke=currentColor, matching the
// topbar's existing inline SVGs) for each global destination and More.
templ globalIcon(key string) {
	switch key {
		case "ideas":
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6M10 21h4"></path><path d="M12 3a6 6 0 0 0-3.2 11.1c.5.4.9 1 .9 1.7v.7h4.6v-.7c0-.7.4-1.3.9-1.7A6 6 0 0 0 12 3z"></path></svg>
		case "intake":
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16v16H4z"></path><path d="M4 14h4l2 3h4l2-3h4"></path></svg>
		case "work":
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11"></path><path d="M4.5 6l1 1 2-2M4.5 12l1 1 2-2M4.5 18l1 1 2-2"></path></svg>
		case "projects":
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"></path></svg>
		case "knowledge":
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5.5A3.5 3.5 0 0 1 7.5 2H11v17H7.5A3.5 3.5 0 0 0 4 22z"></path><path d="M20 5.5A3.5 3.5 0 0 0 16.5 2H13v17h3.5A3.5 3.5 0 0 1 20 22z"></path></svg>
		case "more":
			<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="12" r="1.7" fill="currentColor"></circle><circle cx="12" cy="12" r="1.7" fill="currentColor"></circle><circle cx="18" cy="12" r="1.7" fill="currentColor"></circle></svg>
	}
}

// menuIcon is the project-drawer toggle's hamburger glyph.
templ menuIcon() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
}

// primaryNav is the Primary nav landmark carrying the five global
// destinations in the exact order
// docs/specs/056-nav-shell-and-cross-project-inbox.md §1 requires (Ideas,
// Intake, Projects, Work, Knowledge), marking the one matching active as both
// aria-current="page" and .active. §1 amends spec 032 §2: Home, Reviews and
// Deliveries left the list, keeping their routes and pages. Page renders this
// inside the top bar, so global navigation is reachable everywhere from one
// row. Project-scoped pages, and the pages that are no longer destinations,
// pass "" — matching none of these; a project page's local nav carries the
// current-page marker instead. No page ever marks aria-current="page" twice.
// The trailing "More" button only shows below 880px (see this file's header
// comment); it has no destination of its own.
//
// Knowledge lands on /docs: spec 032 §2 defines that destination as
// "documents and graph-backed expert views", and the document corpus is the
// half of it this backbone holds (025 §5). The graph-backed views join it
// there when they exist rather than taking a destination of their own.
templ primaryNav(active string) {
	<nav aria-label="Primary" class="global" id="global-nav">
		@globalLink("/ideas", "Ideas", "ideas", active, "primary")
		@globalLink("/intake", "Intake", "intake", active, "secondary")
		@globalLink("/projects", "Projects", "projects", active, "primary")
		@globalLink("/work", "Work", "work", active, "primary")
		@globalLink("/docs", "Knowledge", "knowledge", active, "secondary")
		<button type="button" class={ "tab-more", templ.KV("active", active == "intake" || active == "knowledge") } id="more-toggle" aria-haspopup="true" aria-expanded="false" aria-controls="global-nav">
			<span class="navicon" aria-hidden="true">
				@globalIcon("more")
			</span>
			<span class="tab-label">More</span>
		</button>
	</nav>
}

// globalShell wraps a global (non-project) page's content below the top bar.
// The Primary nav landmark lives in the bar itself (Page), so this takes no
// active key; a page names its destination through PageProps.ActiveGlobal.
// Project pages use projectShell instead.
templ globalShell() {
	<div class="shell" data-global="true">
		<main id="main-content" class="main" tabindex="-1">
			<div class="canvas">
				{ children... }
			</div>
		</main>
	</div>
}

// projectShell wraps a project page's content in the unified two-column
// .shell frame: project sidebar left, content in the main landmark. Callers
// supply the content column themselves — a plain .canvas, or the cockpit's
// .mode grid of canvas plus decision rail.
templ projectShell(p CockpitProject, active string) {
	<div class="shell">
		@sidebar(p, active)
		<main id="main-content" class="main" tabindex="-1">
			{ children... }
		</main>
	</div>
}

// sidebar renders the project-scoped left column shared by the cockpit and the
// project placeholder pages: the back-link, project header (name + key) and
// project-local nav, with active marking the current local destination.
// A project page leaves PageProps.ActiveGlobal empty so its single
// aria-current="page" belongs to the local destination; the two landmarks
// remain distinct, labelled and visually separated.
//
// drawer-toggle only renders/shows below 880px (layout.templ's header
// comment): nav.local hides there and this button reopens it as a sheet,
// exactly the way primaryNav's "More" button works for the global nav.
templ sidebar(p CockpitProject, active string) {
	<div class="sidebar">
		<a class="backlink" href="/projects">&larr; All projects</a>
		<button type="button" class="drawer-toggle" id="drawer-toggle" aria-haspopup="true" aria-expanded="false" aria-controls="project-local-nav" aria-label="Project navigation">
			@menuIcon()
		</button>
		<div class="proj-head">
			<div class="proj-kicker"><span class="dot"></span> Project</div>
			<h2 class="proj-name">{ p.Name }</h2>
			<div class="proj-lead"><span class="mono">{ p.Key }</span></div>
			if p.ModeName != "" {
				@modePill(p.ModeName, p.ModeBasis)
			}
		</div>
		<nav aria-label="Project" class="local" id="project-local-nav">
			@localNav(p.ID, active)
		</nav>
	</div>
}

// modePill renders the cockpit's operating mode under the project key. The
// basis — why the project is in this mode — is the pill's native title tooltip
// plus aria-label rather than a line of its own, the same title+aria-label
// convention unattributedInfo uses (internal/ui/cockpit.templ): the basis is
// explanatory, and a permanently visible sentence cost the canvas more height
// than it earned.
templ modePill(name, basis string) {
	if basis == "" {
		<span class="mode-name ok">
			@modePillIcon()
			{ modeLabel(name) }
		</span>
	} else {
		<span class="mode-name ok" title={ basis } aria-label={ modeLabel(name) + " mode: " + basis }>
			@modePillIcon()
			{ modeLabel(name) }
		</span>
	}
}

// modePillIcon is the pill's leading pulse glyph, hand-drawn inline to match
// the other icons in this package rather than pulling in an icon font.
templ modePillIcon() {
	<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 12h4l2 6 4-14 2 8h6"></path></svg>
}

// localNav renders the eight project-local destinations in the exact order
// docs/specs/032-project-cockpit.md §2 requires (Overview, Crew, Work,
// Deliverables, Reviews, Decisions, Documents, Activity), marking the item
// matching active as aria-current="page".
//
// Deleted follows them, outside that order deliberately: it is spec 044's
// tombstone review rather than one of 032 §2's destinations, and it is last
// because a deleted row is the rarest thing anyone comes here to read. Spec
// 032 §2's list is owed an amendment naming it (docs/follow-ups.md).
templ localNav(projectID, active string) {
	@navLink("/projects/"+projectID, "Overview", "overview", active)
	@navLink("/projects/"+projectID+"/crew", "Crew", "crew", active)
	@navLink("/projects/"+projectID+"/work", "Work", "work", active)
	@navLink("/projects/"+projectID+"/deliverables", "Deliverables", "deliverables", active)
	@navLink("/projects/"+projectID+"/reviews", "Reviews", "reviews", active)
	@navLink("/projects/"+projectID+"/decisions", "Decisions", "decisions", active)
	@navLink("/projects/"+projectID+"/documents", "Documents", "documents", active)
	@navLink("/projects/"+projectID+"/activity", "Activity", "activity", active)
	@navLink("/projects/"+projectID+"/deleted", "Deleted", "deleted", active)
}

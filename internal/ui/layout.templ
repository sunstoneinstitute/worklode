package ui

// layout.templ is the application shell every page renders through: the
// document head, skip link, the sticky top bar (brand + theme toggle +
// avatar — no navigation), and the two-column .shell each page's content
// fills via { children... }. Global pages wrap their content in globalShell,
// project pages in projectShell; both sidebars open with the Primary nav
// landmark, and the project one adds the Project landmark below it. Both put
// the page's one <main id="main-content"> landmark in the content column, a
// sibling of the sidebar, so "Skip to content" lands past every nav landmark
// (WCAG 2.4.1).
// Styled with the prototype design system (see
// internal/ui/styles/app.tailwind.css): .topbar, nav.global, .shell,
// .top-right/.iconbtn/.avatar. The self-hosted HTMX script tag is dormant
// substrate (no hx-* behavior yet; spec 032 §11); the inline theme script
// toggles data-theme on <html>, honoring the OS colour-scheme on first click.
//
// Below 880px nav.global and nav.local stay the exact same landmark elements
// (never duplicated — TestGlobalNavOrder's assertOneAriaCurrent invariant is
// "never zero, never two" for the whole document) but are CSS-restyled into a
// GitHub-app-style bottom tab bar and a project drawer instead of the old
// horizontal-scroll strip. nav.global's five primary destinations (tier
// "primary") form the persistent tab row; the three secondary ones (tier
// "secondary" — Intake, Deliveries, Knowledge) are display:none until the
// "More" tab opens them as a stacked sheet above the row, using flex `order`
// so the DOM keeps spec 032 §2's exact order regardless of visual grouping.
// nav.local hides entirely below 880px and reappears as a full sheet when the
// project header's menu button opens it. Both toggles, plus the shared
// backdrop, are wired by /assets/nav.js; open/closed state lives in one
// attribute, body[data-open-panel="more"|"drawer"].

// htmxConfig is the <meta name="htmx-config"> payload HTMX merges into its
// defaults before it does anything else. It exists for one setting:
// includeIndicatorStyles defaults to true, which makes HTMX inject an
// unnonced <style> element into the head on every page load — the reason the
// page CSP used to need style-src 'unsafe-inline' (WL-227). No page uses the
// htmx-indicator class, so the rules it injects are dead weight anyway. If a
// future page wants them, restore them in app.tailwind.css rather than
// re-enabling the injection.
const htmxConfig = `{"includeIndicatorStyles":false}`

templ Page(p PageProps) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.Title }</title>
			<meta name="htmx-config" content={ htmxConfig }/>
			<link rel="icon" type="image/svg+xml" href="/assets/logo.svg"/>
			<link rel="stylesheet" href="/assets/app.css"/>
		</head>
		<body>
			<a class="skip-link" href="#main-content">Skip to content</a>
			<header class="topbar">
				<div class="brand">
					<span class="mark">
						<img src="/assets/logo.svg" alt=""/>
					</span>
					worklode
				</div>
				<div class="top-right">
					<button id="theme" type="button" class="iconbtn" aria-label="Toggle colour theme">
						<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path></svg>
					</button>
					<div class="avatar" aria-hidden="true">SB</div>
				</div>
			</header>
			{ children... }
			<div class="sheet-backdrop" aria-hidden="true"></div>
			<script src="/assets/theme.js" defer></script>
			<script src="/assets/nav.js" defer></script>
			<script src="/assets/mdinput.js" defer></script>
			<script src="/assets/htmx.min.js" defer></script>
		</body>
	</html>
}

// tableWrap is the scroll container every data table on a page renders inside.
// A table is the one thing WCAG 1.4.10 exempts from reflow — it needs two
// dimensions to mean anything — so at 320px it scrolls horizontally inside
// this container instead of widening the page, which is what the four tables
// in this package used to do. tabindex="0" is what makes that scrolling
// reachable from the keyboard (2.1.1) in browsers that do not focus scroll
// containers on their own, and the label is what a screen reader announces on
// arriving in the region it thereby becomes.
templ tableWrap(label string) {
	<div class="tablewrap" role="region" aria-label={ label } tabindex="0">
		{ children... }
	</div>
}

// navLink renders one nav anchor — project-local — marking it current when
// key matches active. The label is emitted tight against the tags
// (>{label}<) so every destination keeps its exact >Name< text marker.
templ navLink(href, label, key, active string) {
	<a
		href={ href }
		if key == active {
			class="active"
			aria-current="page"
		}
	>{ label }</a>
}

// globalLink renders one global-nav anchor, tiered "primary" (one of the five
// GitHub-app-style bottom tabs below 880px) or "secondary" (tucked into the
// "More" sheet at that width — see layout.templ's header comment). Only tier
// "primary" carries an icon: secondary destinations render as plain text rows
// in the sheet, matching nav.local's existing style. The tier class and the
// conditional "active" class must go through one templ.KV-joined class
// expression, not two separate `class` attributes (unlike navLink, which
// only ever has one) — two literal class="..." attributes is invalid HTML,
// and the browser keeps only the first, silently dropping "active".
templ globalLink(href, label, key, active, tier string) {
	<a
		href={ href }
		class={ "tab-" + tier, templ.KV("active", key == active) }
		if key == active {
			aria-current="page"
		}
	>
		if tier == "primary" {
			<span class="navicon" aria-hidden="true">
				@globalIcon(key)
			</span>
		}
		<span class="tab-label">{ label }</span>
	</a>
}

// globalIcon is the line-style icon (24x24, stroke=currentColor, matching the
// topbar's existing inline SVGs) for each of primaryNav's five primary tabs
// plus the More toggle. Secondary destinations render no icon (see
// globalLink), so they have none here.
templ globalIcon(key string) {
	switch key {
		case "home":
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11l8-7 8 7"></path><path d="M6 10v9h12v-9"></path></svg>
		case "ideas":
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6M10 21h4"></path><path d="M12 3a6 6 0 0 0-3.2 11.1c.5.4.9 1 .9 1.7v.7h4.6v-.7c0-.7.4-1.3.9-1.7A6 6 0 0 0 12 3z"></path></svg>
		case "work":
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11"></path><path d="M4.5 6l1 1 2-2M4.5 12l1 1 2-2M4.5 18l1 1 2-2"></path></svg>
		case "reviews":
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.5 2.5L16 9.5"></path></svg>
		case "projects":
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"></path></svg>
		case "more":
			<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="12" r="1.7" fill="currentColor"></circle><circle cx="12" cy="12" r="1.7" fill="currentColor"></circle><circle cx="18" cy="12" r="1.7" fill="currentColor"></circle></svg>
	}
}

// menuIcon is the project-drawer toggle's hamburger glyph.
templ menuIcon() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
}

// primaryNav is the Primary nav landmark carrying the eight global
// destinations in the exact order docs/specs/032-project-cockpit.md §2
// requires (Home, Ideas, Intake, Projects, Work, Reviews, Deliveries,
// Knowledge), marking the one matching active as both aria-current="page"
// and .active. Every page renders it — global pages as their sidebar's only
// block, project pages above the project blocks — so global navigation is
// reachable everywhere (spec 032 §2). Project-scoped pages pass "" —
// matching none of these — since their project-local nav carries the
// current-page marker instead; every page sets aria-current="page" exactly
// once. The trailing "More" button only renders/shows below 880px (see this
// file's header comment); it has no destination of its own, so it carries no
// active state.
//
// Knowledge lands on /docs: spec 032 §2 defines that destination as
// "documents and graph-backed expert views", and the document corpus is the
// half of it this backbone holds (025 §5). The graph-backed views join it
// there when they exist rather than taking a destination of their own.
templ primaryNav(active string) {
	<nav aria-label="Primary" class="global" id="global-nav">
		@globalLink("/", "Home", "home", active, "primary")
		@globalLink("/ideas", "Ideas", "ideas", active, "primary")
		@globalLink("/intake", "Intake", "intake", active, "secondary")
		@globalLink("/projects", "Projects", "projects", active, "primary")
		@globalLink("/work", "Work", "work", active, "primary")
		@globalLink("/reviews", "Reviews", "reviews", active, "primary")
		@globalLink("/deliveries", "Deliveries", "deliveries", active, "secondary")
		@globalLink("/docs", "Knowledge", "knowledge", active, "secondary")
		<button type="button" class="tab-more" id="more-toggle" aria-haspopup="true" aria-expanded="false" aria-controls="global-nav">
			<span class="navicon" aria-hidden="true">
				@globalIcon("more")
			</span>
			<span class="tab-label">More</span>
		</button>
	</nav>
}

// globalShell wraps a global (non-project) page's content in the unified
// two-column .shell frame: the Primary nav landmark alone in the sidebar,
// content in the main landmark's .canvas. Project pages use projectShell
// instead.
templ globalShell(active string) {
	<div class="shell">
		<div class="sidebar">
			@primaryNav(active)
		</div>
		<main id="main-content" class="main" tabindex="-1">
			<div class="canvas">
				{ children... }
			</div>
		</main>
	</div>
}

// projectShell wraps a project page's content in the unified two-column
// .shell frame: project sidebar left, content in the main landmark. Callers
// supply the content column themselves — a plain .canvas, or the cockpit's
// .mode grid of canvas plus decision rail.
templ projectShell(p CockpitProject, active string) {
	<div class="shell">
		@sidebar(p, active)
		<main id="main-content" class="main" tabindex="-1">
			{ children... }
		</main>
	</div>
}

// sidebar renders the project-scoped left column shared by the cockpit and the
// project placeholder pages: the Primary nav landmark, then the back-link, the
// project header (name + key) and the project-local nav, with active marking
// the current local destination. The global nav is passed "" — on a project
// page the single aria-current="page" belongs to the local destination — and
// the two landmarks stay distinct, labelled and visually separated.
//
// drawer-toggle only renders/shows below 880px (layout.templ's header
// comment): nav.local hides there and this button reopens it as a sheet,
// exactly the way primaryNav's "More" button works for the global nav.
templ sidebar(p CockpitProject, active string) {
	<div class="sidebar">
		@primaryNav("")
		<a class="backlink" href="/projects">&larr; All projects</a>
		<button type="button" class="drawer-toggle" id="drawer-toggle" aria-haspopup="true" aria-expanded="false" aria-controls="project-local-nav" aria-label="Project navigation">
			@menuIcon()
		</button>
		<div class="proj-head">
			<div class="proj-kicker"><span class="dot"></span> Project</div>
			<h2 class="proj-name">{ p.Name }</h2>
			<div class="proj-lead"><span class="mono">{ p.Key }</span></div>
		</div>
		<nav aria-label="Project" class="local" id="project-local-nav">
			@localNav(p.ID, active)
		</nav>
	</div>
}

// localNav renders the eight project-local destinations in the exact order
// docs/specs/032-project-cockpit.md §2 requires (Overview, Crew, Work,
// Deliverables, Reviews, Decisions, Documents, Activity), marking the item
// matching active as aria-current="page". The Work item links to the
// overview's #work anchor and is never marked current.
//
// Deleted follows them, outside that order deliberately: it is spec 044's
// tombstone review rather than one of 032 §2's destinations, and it is last
// because a deleted row is the rarest thing anyone comes here to read. Spec
// 032 §2's list is owed an amendment naming it (docs/follow-ups.md).
templ localNav(projectID, active string) {
	@navLink("/projects/"+projectID, "Overview", "overview", active)
	@navLink("/projects/"+projectID+"/crew", "Crew", "crew", active)
	<a href={ "/projects/" + projectID + "#work" }>Work</a>
	@navLink("/projects/"+projectID+"/deliverables", "Deliverables", "deliverables", active)
	@navLink("/projects/"+projectID+"/reviews", "Reviews", "reviews", active)
	@navLink("/projects/"+projectID+"/decisions", "Decisions", "decisions", active)
	@navLink("/projects/"+projectID+"/documents", "Documents", "documents", active)
	@navLink("/projects/"+projectID+"/activity", "Activity", "activity", active)
	@navLink("/projects/"+projectID+"/deleted", "Deleted", "deleted", active)
}

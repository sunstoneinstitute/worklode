package ui

// docs.templ renders the backbone's document corpus (spec 025 §5): the index
// at /docs and one document at /docs/{id}. Both are read-only. Authoring is
// not a page: a document's body is a markdown artifact with frontmatter,
// submitted whole through the API or `lode doc`, and a textarea in a browser
// would be a worse editor pretending to be the source of truth.
//
// The body arrives as v.BodyHTML, already rendered and sanitised by
// internal/mdrender, the way the task page's body does. A spec is long-form
// prose with headings, tables and code fences, none of which survive the <pre>
// this used to be; the document flavour also keeps the {#sec-N} heading
// anchors, which is what lets the Sections table link into it.
//
// The document page is a review surface (WL-716), so what it defaults to
// showing is the consolidated body — every effective amendment folded into
// the section it acts on (026 §3.2) — alongside the review state the backbone
// already holds: the reviewer roster, the open approvals with their decide
// form, and the anchored notes. The stored source is one link away and says
// which of the two is on screen. What is deliberately absent is comment
// threads and rounds: that is WL-SPEC-59, and a note is not a thread.

// Docs carries the link to /drift because Knowledge is where the graph-backed
// expert views live (layout.templ's primaryNav doc comment): the drift board
// takes no nav destination of its own, so without this card it is reachable
// only by typing the URL.
templ Docs(v DocsView) {
	@Page(v.Page) {
		@globalShell() {
			<section class="card">
				<div class="hd"><h3>Drift &amp; overview</h3></div>
				<div class="bd">
					<p><a href="/drift">Drift board</a></p>
					<p class="muted small">Architectural violations, stale intent and coverage gaps from the knowledge graph, alongside the ready frontier and the critical path from the backbone.</p>
				</div>
			</section>
			<section class="card">
				<div class="hd"><h3>Documents</h3></div>
				<div class="bd">
					if len(v.Docs) == 0 {
						<p class="muted">No documents yet. Specs, ADRs and plans land here as they are authored.</p>
					} else {
						@tableWrap("Documents") {
							<table>
								<tr><th>Reference</th><th>Title</th><th>Project</th><th>Status</th><th>Version</th></tr>
								for _, d := range v.Docs {
									<tr>
										<td><a href={ d.URL }>{ d.Ref }</a></td>
										<td><a href={ d.URL }>{ d.Doc.Title }</a></td>
										<td><a href={ "/projects/" + d.Doc.Project }>{ d.Doc.Project }</a></td>
										<td><span class={ "chip " + docStatusChip(d.Doc.Status) }>{ d.Doc.Status }</span></td>
										<td class="mono">{ d.Doc.Version }</td>
									</tr>
								}
							</table>
						}
					}
				</div>
			</section>
		}
	}
}

templ Doc(v DocView) {
	@Page(v.Page) {
		@globalShell() {
			<section class="card pad">
				<h1>{ v.Doc.Title }</h1>
				<p>
					<span class={ "chip " + docStatusChip(v.Doc.Status) }>{ v.Doc.Status }</span>
					<span class="chip plain">{ v.Ref }</span>
					<span class="chip plain">version { v.Doc.Version }</span>
					<span class="muted">&nbsp;project: <a href={ "/projects/" + v.Doc.Project }>{ v.Doc.Project }</a></span>
				</p>
				<p class="muted small">
					Created { fmtTime(v.Doc.CreatedAt) } by { v.Doc.CreatedBy } &mdash; updated { fmtTime(v.Doc.UpdatedAt) }
					if v.Doc.Issued != "" {
						{ " · issued " + v.Doc.Issued }
					}
				</p>
				if v.Doc.Owner != "" {
					<p class="muted small">Owned by { v.Doc.Owner }</p>
				}
				if v.Doc.GeneratedByTask != "" {
					<p class="muted small">
						Written by task <a href={ "/tasks/" + v.Doc.GeneratedByTask }>{ v.Doc.GeneratedByTask }</a>
					</p>
				}
				if v.Revision != nil {
					<p><strong>A candidate revision is open</strong>, by { v.Revision.CreatedBy } ({ fmtTime(v.Revision.CreatedAt) }). The accepted version below stays authoritative until it lands.</p>
				}
			</section>
			if len(v.Versions) > 0 {
				<section class="card">
					<div class="hd"><h3>Versions</h3></div>
					<div class="bd">
						@tableWrap("Versions") {
							<table>
								<tr><th>Version</th><th>Title</th><th>Issued</th><th>Snapshot at</th></tr>
								for _, ver := range v.Versions {
									<tr>
										<td class="mono"><a href={ docVersionURL(v.Doc.ID, ver.Version) }>{ ver.Version }</a></td>
										<td><a href={ docVersionURL(v.Doc.ID, ver.Version) }>{ ver.Title }</a></td>
										<td class="mono">{ ver.Issued }</td>
										<td class="mono">{ fmtTime(ver.CreatedAt) }</td>
									</tr>
								}
							</table>
						}
					</div>
				</section>
			}
			if len(v.Sections) > 0 {
				<section class="card">
					<div class="hd"><h3>Sections</h3></div>
					<div class="bd">
						@tableWrap("Sections") {
							<table>
								<tr><th>Anchor</th><th>Heading</th><th>Last revised in</th><th>Published</th></tr>
								for _, sec := range v.Sections {
									<tr>
										// The anchor links at the heading it names in the
										// body below, which is what makes this table a table
										// of contents rather than a list of fragment names.
										// An anchor outside the 025 §3 grammar is stored but
										// dropped by the sanitiser, so its link goes nowhere
										// — the corpus lint is what stops one being written.
										<td class="mono"><a href={ "#" + sec.Anchor }>{ "#" + sec.Anchor }</a></td>
										<td>{ sec.Heading }</td>
										<td class="mono">{ sec.LastRevisedIn }</td>
										<td>
											if sec.Published {
												<span class="chip ok">published</span>
											} else {
												<span class="chip plain">draft</span>
											}
										</td>
									</tr>
								}
							</table>
						}
					</div>
				</section>
			}
			<section class="card">
				<div class="hd"><h3>Relations</h3></div>
				<div class="bd">
					@docEdges("Out of this document", v.Edges)
					@docEdges("Into this document", v.EdgesIn)
				</div>
			</section>
			@docReview(v)
			@docNotes(v)
			<section class="card">
				<div class="hd">
					<h3>Body</h3>
					if v.Consolidated {
						<span class="muted small">amendments folded in &middot; <a href={ v.SourceURL }>stored source</a></span>
					} else {
						<span class="muted small">stored source &middot; <a href={ v.ConsolidatedURL }>with amendments folded in</a></span>
					}
				</div>
				// BodyHTML is emitted unescaped for the reason task.templ
				// gives: internal/mdrender has already reduced it to an
				// allowlist. The document flavour adds one attribute to that
				// allowlist, an id on a heading matching the section-anchor
				// grammar, and nothing else.
				<div class="bd prose">
					@templ.Raw(string(v.BodyHTML))
				</div>
				if hasMermaid(v.BodyHTML) {
					@mermaidScripts()
				}
			</section>
		}
	}
}

// DocVersion renders one version of a document, current or superseded
// (025 §4.5), reusing Doc's header/chip markup. The body is read-only, as
// every document body is; a superseded version additionally gets a banner
// pointing back to the current one.
templ DocVersion(v DocVersionView) {
	@Page(v.Page) {
		@globalShell() {
			<section class="card pad">
				<h1>{ v.Version.Title }</h1>
				<p>
					<span class={ "chip " + docStatusChip(v.Doc.Status) }>{ v.Doc.Status }</span>
					<span class="chip plain">{ v.Ref }</span>
					<span class="chip plain">version { v.Version.Version }</span>
					<span class="muted">&nbsp;project: <a href={ "/projects/" + v.Doc.Project }>{ v.Doc.Project }</a></span>
				</p>
				<p class="muted small">
					Snapshot { fmtTime(v.Version.CreatedAt) }
					if v.Version.Issued != "" {
						{ " · issued " + v.Version.Issued }
					}
				</p>
			</section>
			if !v.Current {
				<section class="card pad">
					<p><strong>Viewing version { v.Version.Version }</strong> &mdash; <a href={ v.DocURL }>back to current</a></p>
				</section>
			}
			<section class="card">
				<div class="hd"><h3>Body</h3></div>
				// BodyHTML is emitted unescaped for the reason Doc's Body
				// section gives.
				<div class="bd prose">
					@templ.Raw(string(v.BodyHTML))
				</div>
			</section>
		}
	}
}

// docReview renders the review state 025 §7.3 and 029 §7 already hold: the
// durable reviewer roster with who still owes a verdict, and every approval
// still awaiting a decision, each with the same decide form the Reviews queue
// posts (the form carries this page as its return, so deciding here comes
// back here). It states an empty roster and an empty queue outright rather
// than rendering a card that looks like it failed to load.
templ docReview(v DocView) {
	<section class="card">
		<div class="hd"><h3>Review</h3></div>
		<div class="bd">
			<h4>Reviewers</h4>
			if len(v.Reviewers) == 0 {
				<p class="muted">No reviewers are assigned.</p>
			} else {
				<ul>
					for _, rev := range v.Reviewers {
						<li>
							{ rev.Actor }{ " " }
							if rev.Awaiting {
								<span class="chip warn">awaiting</span>
							} else {
								<span class="chip ok">reviewed</span>
							}
						</li>
					}
				</ul>
			}
			<h4>Approvals</h4>
			if len(v.Approvals) == 0 {
				<p class="muted">No approvals are open on this document.</p>
			} else {
				<ul class="approvalq">
					for _, row := range v.Approvals {
						@approvalRow(row)
					}
				</ul>
			}
		</div>
	</section>
}

// docNotes renders the document's anchored notes (025 §8.5). A note settles
// nothing and blocks nothing, so it is listed where it applies — the anchor
// links at the section in the body below — and never presented as a verdict.
templ docNotes(v DocView) {
	<section class="card">
		<div class="hd"><h3>Notes</h3></div>
		<div class="bd">
			if len(v.Notes) == 0 {
				<p class="muted">No notes.</p>
			} else {
				<ul>
					for _, n := range v.Notes {
						<li>
							<p class="muted small">
								<a href={ "#" + n.Anchor } class="mono">{ "#" + n.Anchor }</a>
								{ " · " }{ n.CreatedBy }{ " · " }{ fmtTime(n.CreatedAt) }
								if n.Task != "" {
									{ " · " }<a href={ "/tasks/" + n.Task }>{ n.Task }</a>
								}
							</p>
							<div class="prose">
								@templ.Raw(string(n.BodyHTML))
							</div>
						</li>
					}
				</ul>
			}
		</div>
	</section>
}

// docEdges renders one direction of a document's relations. An unresolved
// cross-corpus reference (URL "") is rendered as text: it names something this
// backbone does not hold, and a link to nothing is worse than none.
templ docEdges(heading string, edges []DocEdgeRow) {
	<h4>{ heading }</h4>
	if len(edges) == 0 {
		<p class="muted">none</p>
	} else {
		<ul>
			for _, e := range edges {
				<li>
					if e.Anchor != "" {
						<span class="mono">{ "#" + e.Anchor }</span>{ " " }
					}
					<span class="chip plain">{ e.Type }</span>{ " " }
					if e.Ref != "" {
						<span class="chip plain">{ e.Ref }</span>{ " " }
					}
					if e.URL != "" {
						<a href={ e.URL }>{ e.Label }</a>
					} else {
						<span class="mono">{ e.Label }</span>
					}
				</li>
			}
		</ul>
	}
}

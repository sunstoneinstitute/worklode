          "type": "text",
          "text": "    // x holds the lease; reviewers {a}.\n",
          "offset": 1276
        },
        {
          "type": "text",
          "text": "    // a opens a question; x replies; task still in_review; lease active.\n",
          "offset": 1317
        },
        {
          "type": "text",
          "text": "    // a opens a question; x runs EscalateTask → the thread's last message names the escalation task,\n",
          "offset": 1391
        },
        {
          "type": "text",
          "text": "    //   role author; review open; task still in_review; lease released.\n",
          "offset": 1495
        },
        {
          "type": "text",
          "text": "    // x approves → ErrForbidden (self-approval).\n",
          "offset": 1568
        },
        {
          "type": "text",
          "text": "    // a sends changes_requested → task in_progress, lease active, review state changes_requested.\n",
          "offset": 1620
        },
        {
          "type": "text",
          "text": "    // x SubmitAuthorRound{sha2} → task in_review, state open.\n",
          "offset": 1721
        },
        {
          "type": "text",
          "text": "    // a approves at sha2 → state approved.\n",
          "offset": 1786
        },
        {
          "type": "text",
          "text": "    // transition in_review → merged → review closed, outcome merged, event wl:ReviewClosed.\n",
          "offset": 1832
        },
        {
          "type": "text",
          "text": "}\n",
          "offset": 1929
        }

          "styles": {
            "code": true
          },
          "offset": 27
        },
        {
          "type": "text",
          "text": " of an accepted spec, the query looks at every live plan with a ",
          "offset": 29
        },
        {
          "type": "text",
          "text": "covers",
          "styles": {
            "code": true
          },
          "offset": 94
        },
        {
          "type": "text",
          "text": " edge that claims ",
          "offset": 101
        },
        {
          "type": "text",
          "text": "S",
          "styles": {
            "code": true
          },
          "offset": 120
        },
        {
          "type": "text",
          "text": ", and every plan that ",
          "offset": 122
        },
        {
          "type": "text",
          "text": "defers",
          "styles": {
            "code": true
          },
          "offset": 145
        },
        {
          "type": "text",
          "text": " ",
          "offset": 152
        },
        {
          "type": "text",
          "text": "S",
          "styles": {
            "code": true
          },
          "offset": 154
        },
        {
          "type": "text",
          "text": ". A plan discharges ",
          "offset": 156
        },
        {
          "type": "text",
          "text": "S",
          "styles": {
            "code": true
          },
          "offset": 177
        },
        {
          "type": "text",
          "text": " when its status is ",
          "offset": 179
        },
        {
          "type": "text",
          "text": "accepted",
          "styles": {
            "code": true
          },
          "offset": 200
        },
        {
          "type": "text",
          "text": ", ",
          "offset": 209
        },
        {
          "type": "text",
          "text": "superseded",
          "styles": {
            "code": true
          },
          "offset": 212
        },
        {
          "type": "text",
          "text": " or ",
          "offset": 223
        },
        {
          "type": "text",
          "text": "executed",
          "styles": {
            "code": true
          },
          "offset": 228
        },
        {
          "type": "text",
          "text": ". Draft plans never discharge: an unapproved split must not hide a gap.",
          "offset": 237
        }
      ],

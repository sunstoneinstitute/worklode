# Uncomment what you need. `make up`, `make dev-db`, `make dev-embeddings` and
# `make dev-server` load this file through `op run`. This file is committed:
# put secrets in as op:// references, never as values.
# Variables mirror docker-compose.yml, deploy/base/configmap.yaml and the
# secrets the deployment references. Values shown are examples, not defaults,
# unless noted.

# --- Local stack (docker-compose.yml) ---

# Required on first run to create the admin actor. Format: wl_ + 40 hex chars.
# Generate one with: echo wl_$(openssl rand -hex 20)
# LODE_BOOTSTRAP_TOKEN=

# Serves the web pages without OIDC login. Compose defaults to 1. Only safe on
# a trusted network. A server with neither this nor LODE_OIDC_* refuses to
# serve web pages.
# LODE_WEB_OPEN=1

# Host ports for compose's Postgres and its opt-in embeddings server
# (`--profile embeddings`). Change them when the defaults are taken.
# LODE_POSTGRES_PORT=5432
# LODE_EMBEDDINGS_PORT=8081

# HMAC secrets for the signed webhook endpoints. Empty means that endpoint
# answers 503.
# LODE_GITHUB_WEBHOOK_SECRET=
# LODE_FLUX_WEBHOOK_SECRET=
# LODE_CATALOG_WEBHOOK_SECRET=
# LODE_CMS_WEBHOOK_SECRET=

# --- Server (deploy/base/configmap.yaml and secrets) ---

# Postgres connection string. Compose and `make` set this for the local stack.
# LODE_DSN=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

# Which kind of instance this is (WL-REQ-21): "dev" or "prod". Compose defaults
# to dev. A prod instance that believes it is dev drops decision records.
# LODE_INSTANCE_ENV=dev

# Maps observed clusters to environments. This is not LODE_INSTANCE_ENV, which
# describes this instance.
# LODE_CLUSTER_ENV_MAP=

# Task branch name template. Empty means {{ .id }}-{{ .slug }}.
# LODE_BRANCH_TEMPLATE=

# Plan token budget, soft and hard. Empty means 32000 and 64000.
# LODE_PLAN_TOKENS_SOFT=32000
# LODE_PLAN_TOKENS_HARD=64000

# Org skill registry sources.
# LODE_SKILL_SOURCES=

# Skips the embed call and search in skill matching, leaving pins only. Use
# when the embedding provider is slow or misbehaving.
# LODE_DISABLE_SKILL_MATCHING=false

# Dense arm of corpus search (WL-REQ-255). Any OpenAI-compatible embeddings
# endpoint. Empty disables dense retrieval. The containerized server reaches
# compose's embeddings service at http://embeddings:8080/v1/embeddings, a
# host-run server at http://localhost:8081/v1/embeddings.
# LODE_EMBEDDING_URL=http://embeddings:8080/v1/embeddings
# Dedicated endpoint for query-path embeddings. Empty means LODE_EMBEDDING_URL.
# LODE_QUERY_EMBEDDING_URL=
# Model name the provider answers to. text-embeddings-inference with baked-in
# weights answers to "/model".
# LODE_EMBEDDING_MODEL=/model
# Bearer token for the provider. Not needed for an unauthenticated local TEI.
# LODE_EMBEDDING_API_KEY=
# Model context window in tokens (WL-REQ-257). The chunk budget derives from it.
# EmbeddingGemma is 2048.
# LODE_EMBEDDING_CONTEXT_TOKENS=2048
# Instruction prefixes for asymmetric models (WL-REQ-255). Trailing spaces are
# part of the value. A symmetric model sets both empty. A wrong prefix lowers
# retrieval quality without raising an error.
# LODE_EMBEDDING_QUERY_PREFIX="task: search result | query: "
# LODE_EMBEDDING_DOCUMENT_PREFIX="title: none | text: "

# How often the corpus index converges (WL-REQ-260). Empty means 5m.
# LODE_INDEX_INTERVAL=

# Path to the secrets catalog TOML.
# LODE_SECRETS_CATALOG_PATH=

# Blob storage is off unless endpoint and bucket are both set (WL-REQ-234).
# LODE_BLOB_ENDPOINT=
# LODE_BLOB_BUCKET=
# LODE_BLOB_REGION=
# LODE_BLOB_ACCESS_KEY=
# LODE_BLOB_SECRET_KEY=
# Upload scratch directory. Empty means os.TempDir().
# LODE_BLOB_SPOOL_DIR=

# Where /otlp/v1/logs forwards task activity log events (WL-REQ-1236,
# WL-REQ-267). Empty disables forwarding.
# LODE_OTLP_UPSTREAM=
# LODE_OTLP_UPSTREAM_TOKEN=

# TypeSafe key for the jev classifier (WL-REQ-1857). Empty means a classify
# request fails as unconfigured.
# LODE_TYPESAFE_API_KEY=op://Shared/typesafe-ai-local-worklode-testing/credential
